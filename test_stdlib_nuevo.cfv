importar "stdlib/colecciones.cfv"
importar "stdlib/aleatorio.cfv"
importar "stdlib/fecha.cfv"
importar "stdlib/base64.cfv"
importar "stdlib/json.cfv"
importar "stdlib/regex.cfv"

mostrar("=== Colecciones ===")
sea q = cola_nueva()
cola_encolar(q, "primero")
cola_encolar(q, "segundo")
mostrar(cola_desencolar(q))
mostrar("cola_tam: {cola_tam(q)}")

sea p = pila_nueva()
pila_push(p, 10)
pila_push(p, 20)
mostrar("pop: {pila_pop(p)}")

sea s = conjunto_nuevo()
conjunto_agregar(s, 1)
conjunto_agregar(s, 2)
conjunto_agregar(s, 1)
mostrar("conjunto_tam: {conjunto_tam(s)}")

mostrar("=== Aleatorio ===")
sea n = aleatorio_entero(1, 100)
si (n >= 1 y n <= 100) { mostrar("aleatorio_entero ok") }
sea b = aleatorio_bool(0.5)
si (tipo_de(b) == "booleano") { mostrar("aleatorio_bool ok") }

mostrar("=== Fecha ===")
sea f = fecha_ahora()
si (f["anio"] >= 2024) {
    sea anio_actual = f["anio"]
    mostrar("fecha_ahora ok: {anio_actual}")
}
sea ms = fecha_ahora_ms()
si (ms > 0) { mostrar("fecha_ahora_ms ok") }
mostrar(fecha_formato(f, "DD/MM/YYYY HH:mm:SS"))

mostrar("=== Base64 ===")
sea enc = base64_codificar("Hola C-Forge!")
sea dec = base64_decodificar(enc)
mostrar("{enc}")
mostrar("{dec}")

mostrar("=== JSON ===")
sea obj = {"nombre": "Ana", "edad": 25, "activo": verdadero}
sea txt = json_serializar(obj)
mostrar(txt)

mostrar("=== Regex ===")
si (regex_coincidir("^[0-9]+$", "12345")) { mostrar("coincidir ok") }
sea match = regex_buscar("[0-9]+", "precio: 42 pesos")
mostrar("buscar: {match}")
sea todos = regex_buscar_todos("[a-z]+", "foo bar baz")
mostrar("buscar_todos: {longitud(todos)}")
sea reem = regex_reemplazar("[aeiou]", "hola mundo", "*")
mostrar("reemplazar: {reem}")

