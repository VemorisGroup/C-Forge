// assets/scripts/main.cfv
// Script principal de la app Android C-Forge.
// Este archivo se carga al iniciar MainActivity.

sea contador = 0
sea nombre_app = "Mi App C-Forge"

mostrar("Bienvenido a {nombre_app}!")
mostrar("Corriendo en Android con C-Forge")

// Esta funcion la llama el boton "Accion" de la UI
funcion on_boton_presionado(): texto {
    contador += 1
    retornar "Presionado {contador} veces"
}

// Para banco / finanzas:
funcion calcular_interes(capital: numero, tasa: numero, anos: numero): numero {
    retornar capital * potencia(1.0 + tasa / 100.0, anos) - capital
}

// Para juegos:
funcion nueva_partida(): mapa {
    retornar {
        "nivel": 1,
        "puntos": 0,
        "vidas": 3,
        "activo": verdadero
    }
}

funcion actualizar_partida(estado: mapa, puntos_nuevos: numero): mapa {
    estado["puntos"] += puntos_nuevos
    si (estado["puntos"] >= estado["nivel"] * 100) {
        estado["nivel"] += 1
        mostrar("Nivel {estado["nivel"]}!")
    }
    retornar estado
}
