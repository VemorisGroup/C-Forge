<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1a1a2e">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="C-Forge"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#e94560"/>

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v2.1.0"
            android:textSize="12sp"
            android:textColor="#888888"/>
    </LinearLayout>

    <!-- Output -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#16213e"
        android:padding="8dp">
        <TextView
            android:id="@+id/tvOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Listo."
            android:textColor="#00ff88"
            android:fontFamily="monospace"
            android:textSize="14sp"/>
    </ScrollView>

    <!-- Editor de codigo -->
    <EditText
        android:id="@+id/etCode"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="8dp"
        android:background="#0f3460"
        android:textColor="#ffffff"
        android:textColorHint="#888888"
        android:hint="Escribe codigo C-Forge aqui..."
        android:fontFamily="monospace"
        android:textSize="13sp"
        android:gravity="top"
        android:padding="8dp"
        android:inputType="textMultiLine"
        android:imeOptions="flagNoEnterAction"/>

    <!-- Botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnRun"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="Ejecutar"
            android:backgroundTint="#e94560"
            android:textColor="#ffffff"/>

        <Button
            android:id="@+id/btnAction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:layout_marginStart="8dp"
            android:text="Accion"
            android:backgroundTint="#0f3460"
            android:textColor="#ffffff"/>

        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="X"
            android:backgroundTint="#333333"
            android:textColor="#ffffff"/>
    </LinearLayout>

</LinearLayout>
