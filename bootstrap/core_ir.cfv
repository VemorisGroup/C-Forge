// C-Forge Core IR 1 — contrato común para todos los backends nativos.
// Esta fuente está escrita en C-Forge y no representa estructuras de C++,
// C# ni Java. Los backends consumen offsets, tamaños y firmas deterministas.

estructura CampoIRCore {
    nombre: texto
    tipo: texto
    indice: numero
    desplazamiento: numero
    tamano: numero
    alineacion: numero
}

estructura MetodoIRCore {
    nombre: texto
    retorno: texto
    parametros: lista
    propietario: texto
}

estructura TipoIRCore {
    nombre: texto
    clase: texto
    tamano: numero
    alineacion: numero
    campos: lista
    metodos: lista
    interfaces: lista
}

estructura ProgramaIRCore {
    tipos: lista
    errores: lista
}

funcion posicion_dos_puntos_ir(valor: texto): numero {
    sea indice: numero = 0
    mientras (indice < longitud(valor)) {
        si (valor[indice] == ":") {
            retornar indice
        }
        indice = indice + 1
    }
    retornar -1
}

funcion segmento_ir(valor: texto, inicio: numero, limite: numero): texto {
    sea salida: texto = ""
    sea indice: numero = inicio
    mientras (indice < limite) {
        salida = salida + valor[indice]
        indice = indice + 1
    }
    retornar salida
}

funcion nombre_firma_ir(valor: texto): texto {
    sea separador: numero = posicion_dos_puntos_ir(valor)
    si (separador < 0) {
        retornar valor
    }
    retornar segmento_ir(valor, 0, separador)
}

funcion tipo_firma_ir(valor: texto): texto {
    sea separador: numero = posicion_dos_puntos_ir(valor)
    si (separador < 0) {
        retornar "cualquiera"
    }
    sea tipo: texto = segmento_ir(
        valor, separador + 1, longitud(valor)
    )
    si (longitud(tipo) == 0) {
        retornar "cualquiera"
    }
    retornar tipo
}

funcion alinear_ir(valor: numero, alineacion: numero): numero {
    sea resto: numero = valor % alineacion
    si (resto == 0) {
        retornar valor
    }
    retornar valor + alineacion - resto
}

funcion tamano_tipo_ir(tipo: texto): numero {
    // El ABI Core usa slots de 64 bits. Los agregados guardan un handle de
    // 64 bits hacia memoria administrada por el runtime autónomo.
    si (tipo == "booleano") { retornar 8 }
    si (tipo == "numero") { retornar 8 }
    si (tipo == "entero") { retornar 8 }
    si (tipo == "decimal") { retornar 8 }
    si (tipo == "texto") { retornar 8 }
    si (tipo == "lista") { retornar 8 }
    si (tipo == "mapa") { retornar 8 }
    si (tipo == "cualquiera") { retornar 8 }
    retornar 8
}

funcion indice_tipo_ir(tipos: lista, nombre: texto): numero {
    sea indice: numero = 0
    mientras (indice < longitud(tipos)) {
        si (tipos[indice].nombre == nombre) {
            retornar indice
        }
        indice = indice + 1
    }
    retornar -1
}

funcion indice_campo_ir(campos: lista, nombre: texto): numero {
    sea indice: numero = 0
    mientras (indice < longitud(campos)) {
        si (campos[indice].nombre == nombre) {
            retornar indice
        }
        indice = indice + 1
    }
    retornar -1
}

funcion indice_metodo_ir(metodos: lista, nombre: texto): numero {
    sea indice: numero = 0
    mientras (indice < longitud(metodos)) {
        si (metodos[indice].nombre == nombre) {
            retornar indice
        }
        indice = indice + 1
    }
    retornar -1
}

funcion parametros_metodo_ir(nodo: cualquiera): lista {
    sea parametros: lista = []
    sea hijos: lista = nodo.hijos
    sea indice: numero = 0
    mientras (indice + 1 < longitud(hijos)) {
        sea parametro: cualquiera = hijos[indice]
        agregar(parametros, tipo_firma_ir(parametro.valor))
        indice = indice + 1
    }
    retornar parametros
}

funcion construir_tipo_ir(
    nodo: cualquiera,
    errores: lista
): cualquiera {
    sea campos: lista = []
    sea metodos: lista = []
    sea interfaces: lista = []
    sea desplazamiento: numero = 0
    sea miembros: lista = nodo.hijos
    sea indice: numero = 0

    mientras (indice < longitud(miembros)) {
        sea miembro: cualquiera = miembros[indice]
        si (miembro.tipo == "Campo") {
            sea nombre: texto = nombre_firma_ir(miembro.valor)
            sea tipo: texto = tipo_firma_ir(miembro.valor)
            si (indice_campo_ir(campos, nombre) >= 0) {
                agregar(
                    errores,
                    "CFIR1001: campo duplicado '" + nodo.valor +
                    "." + nombre + "'"
                )
            } sino {
                sea alineacion: numero = 8
                sea tamano: numero = tamano_tipo_ir(tipo)
                desplazamiento = alinear_ir(desplazamiento, alineacion)
                agregar(
                    campos,
                    CampoIRCore(
                        nombre, tipo, longitud(campos), desplazamiento,
                        tamano, alineacion
                    )
                )
                desplazamiento = desplazamiento + tamano
            }
        }
        si (miembro.tipo == "Metodo") {
            sea nombre_metodo: texto = nombre_firma_ir(miembro.valor)
            si (indice_metodo_ir(metodos, nombre_metodo) >= 0) {
                agregar(
                    errores,
                    "CFIR1002: método duplicado '" + nodo.valor +
                    "." + nombre_metodo + "'"
                )
            } sino {
                agregar(
                    metodos,
                    MetodoIRCore(
                        nombre_metodo,
                        tipo_firma_ir(miembro.valor),
                        parametros_metodo_ir(miembro),
                        nodo.valor
                    )
                )
            }
        }
        indice = indice + 1
    }

    sea clase_tipo: texto = "estructura"
    si (nodo.tipo == "Clase") {
        clase_tipo = "clase"
    }
    retornar TipoIRCore(
        nodo.valor,
        clase_tipo,
        alinear_ir(desplazamiento, 8),
        8,
        campos,
        metodos,
        interfaces
    )
}

funcion construir_programa_ir(programa: cualquiera): cualquiera {
    sea tipos: lista = []
    sea errores: lista = []
    sea declaraciones: lista = programa.hijos
    sea indice: numero = 0
    mientras (indice < longitud(declaraciones)) {
        sea nodo: cualquiera = declaraciones[indice]
        si (nodo.tipo == "Estructura" o nodo.tipo == "Clase") {
            si (indice_tipo_ir(tipos, nodo.valor) >= 0) {
                agregar(
                    errores,
                    "CFIR1000: tipo duplicado '" + nodo.valor + "'"
                )
            } sino {
                agregar(tipos, construir_tipo_ir(nodo, errores))
            }
        }
        indice = indice + 1
    }
    retornar ProgramaIRCore(tipos, errores)
}

funcion campo_tipo_ir(tipo: cualquiera, nombre: texto): cualquiera {
    sea indice: numero = indice_campo_ir(tipo.campos, nombre)
    afirmar(
        indice >= 0,
        "CFIR1003: campo desconocido '" + tipo.nombre + "." + nombre + "'"
    )
    retornar tipo.campos[indice]
}

funcion firma_tipo_ir(tipo: cualquiera): texto {
    sea salida: texto = tipo.clase + " " + tipo.nombre +
        " size=" + a_texto(tipo.tamano) +
        " align=" + a_texto(tipo.alineacion) + " {"
    sea indice: numero = 0
    mientras (indice < longitud(tipo.campos)) {
        sea campo: cualquiera = tipo.campos[indice]
        si (indice > 0) { salida = salida + "," }
        salida = salida + campo.nombre + ":" + campo.tipo +
            "@" + a_texto(campo.desplazamiento)
        indice = indice + 1
    }
    retornar salida + "}"
}

funcion ir_canonico(programa_ir: cualquiera): texto {
    sea salida: texto = "CFIR1["
    sea indice: numero = 0
    mientras (indice < longitud(programa_ir.tipos)) {
        si (indice > 0) { salida = salida + ";" }
        salida = salida + firma_tipo_ir(programa_ir.tipos[indice])
        indice = indice + 1
    }
    retornar salida + "]"
}
