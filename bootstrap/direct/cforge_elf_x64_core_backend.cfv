// Backend ELF64/x86-64 Core B6.8.
// Emite código máquina directamente: no usa compilador, ensamblador ni linker.

funcion agregar_le_elf(
    bytes: lista,
    valor_inicial: numero,
    cantidad: numero
) {
    sea valor: numero = valor_inicial
    sea indice: numero = 0
    mientras (indice < cantidad) {
        sea byte: numero = valor % 256
        agregar(bytes, byte)
        valor = (valor - byte) / 256
        indice = indice + 1
    }
}

funcion agregar_lista_elf(destino: lista, origen: lista) {
    sea indice: numero = 0
    mientras (indice < longitud(origen)) {
        agregar(destino, origen[indice])
        indice = indice + 1
    }
}

estructura SimboloELFCore {
    nombre: texto
    desplazamiento: numero
}

estructura ColeccionELFCore {
    nombre: texto
    desplazamiento: numero
    longitud: numero
}

estructura TextoELFCore {
    nombre: texto
    puntero: numero
    longitud: numero
}

estructura OperacionELFCore {
    tipo: texto
    bytes: lista
    nombre: texto
    valor: numero
}

estructura DatoELFCore {
    nombre: texto
    bytes: lista
}

estructura FuncionELFCore {
    nombre: texto
    nodo: cualquiera
    etiqueta: texto
}

estructura ContextoELFCore {
    operaciones: lista
    simbolos: lista
    datos: lista
    contador: numero
    funciones: lista
    retorno_actual: texto
    colecciones: lista
    textos: lista
    siguiente_desplazamiento: numero
}

funcion operacion_bytes_elf(contexto: cualquiera, bytes: lista) {
    agregar(
        contexto.operaciones,
        OperacionELFCore("bytes", bytes, "", 0)
    )
}

funcion operacion_control_elf(
    contexto: cualquiera,
    tipo: texto,
    nombre: texto,
    valor: numero
) {
    agregar(
        contexto.operaciones,
        OperacionELFCore(tipo, [], nombre, valor)
    )
}

funcion etiqueta_core_elf(contexto: cualquiera, nombre: texto) {
    operacion_control_elf(contexto, "etiqueta", nombre, 0)
}

funcion nombre_unico_core_elf(
    contexto: cualquiera,
    prefijo: texto
): texto {
    sea nombre: texto = prefijo + "_" + a_texto(contexto.contador)
    contexto.contador = contexto.contador + 1
    retornar nombre
}

funcion nombre_declaracion_core_elf(valor: texto): texto {
    sea nombre: texto = ""
    sea indice: numero = 0
    mientras (indice < longitud(valor) y valor[indice] != ":") {
        nombre = nombre + valor[indice]
        indice = indice + 1
    }
    retornar nombre
}

funcion digito_core_elf(caracter: texto): numero {
    si (caracter == "0") { retornar 0 }
    si (caracter == "1") { retornar 1 }
    si (caracter == "2") { retornar 2 }
    si (caracter == "3") { retornar 3 }
    si (caracter == "4") { retornar 4 }
    si (caracter == "5") { retornar 5 }
    si (caracter == "6") { retornar 6 }
    si (caracter == "7") { retornar 7 }
    si (caracter == "8") { retornar 8 }
    si (caracter == "9") { retornar 9 }
    afirmar(falso, "literal numérico ELF inválido")
    retornar 0
}

funcion numero_ast_core_elf(valor: texto): numero {
    sea resultado: numero = 0
    sea indice: numero = 0
    mientras (indice < longitud(valor)) {
        resultado = resultado * 10 + digito_core_elf(valor[indice])
        indice = indice + 1
    }
    retornar resultado
}

funcion texto_ast_core_elf(valor: texto): texto {
    afirmar(longitud(valor) >= 2, "literal de texto ELF inválido")
    sea resultado: texto = ""
    sea indice: numero = 1
    mientras (indice + 1 < longitud(valor)) {
        resultado = resultado + valor[indice]
        indice = indice + 1
    }
    retornar resultado
}

funcion indice_simbolo_core_elf(
    contexto: cualquiera,
    nombre: texto
): numero {
    sea simbolos: lista = contexto.simbolos
    sea indice: numero = 0
    mientras (indice < longitud(simbolos)) {
        si (simbolos[indice].nombre == nombre) {
            retornar indice
        }
        indice = indice + 1
    }
    retornar -1
}

funcion declarar_simbolo_core_elf(
    contexto: cualquiera,
    nombre: texto
): numero {
    afirmar(
        indice_simbolo_core_elf(contexto, nombre) < 0,
        "variable ELF duplicada '" + nombre + "'"
    )
    contexto.siguiente_desplazamiento =
        contexto.siguiente_desplazamiento - 8
    sea desplazamiento: numero = contexto.siguiente_desplazamiento
    afirmar(desplazamiento >= -4096, "memoria local ELF agotada")
    agregar(
        contexto.simbolos,
        SimboloELFCore(nombre, desplazamiento)
    )
    retornar desplazamiento
}

funcion reservar_memoria_core_elf(
    contexto: cualquiera,
    cantidad: numero
): numero {
    contexto.siguiente_desplazamiento =
        contexto.siguiente_desplazamiento - cantidad
    afirmar(
        contexto.siguiente_desplazamiento >= -4096,
        "memoria dinámica local ELF agotada"
    )
    retornar contexto.siguiente_desplazamiento
}

funcion buscar_coleccion_core_elf(
    contexto: cualquiera,
    nombre: texto
): cualquiera {
    sea indice: numero = 0
    mientras (indice < longitud(contexto.colecciones)) {
        si (contexto.colecciones[indice].nombre == nombre) {
            retornar contexto.colecciones[indice]
        }
        indice = indice + 1
    }
    afirmar(falso, "colección ELF desconocida '" + nombre + "'")
    retornar contexto.colecciones[0]
}

funcion indice_coleccion_core_elf(
    contexto: cualquiera,
    nombre: texto
): numero {
    sea indice: numero = 0
    mientras (indice < longitud(contexto.colecciones)) {
        si (contexto.colecciones[indice].nombre == nombre) {
            retornar indice
        }
        indice = indice + 1
    }
    retornar -1
}

funcion buscar_texto_core_elf(
    contexto: cualquiera,
    nombre: texto
): cualquiera {
    sea indice: numero = 0
    mientras (indice < longitud(contexto.textos)) {
        si (contexto.textos[indice].nombre == nombre) {
            retornar contexto.textos[indice]
        }
        indice = indice + 1
    }
    afirmar(falso, "texto ELF desconocido '" + nombre + "'")
    retornar contexto.textos[0]
}

funcion indice_texto_core_elf(
    contexto: cualquiera,
    nombre: texto
): numero {
    sea indice: numero = 0
    mientras (indice < longitud(contexto.textos)) {
        si (contexto.textos[indice].nombre == nombre) {
            retornar indice
        }
        indice = indice + 1
    }
    retornar -1
}

funcion desplazamiento_simbolo_core_elf(
    contexto: cualquiera,
    nombre: texto
): numero {
    sea indice: numero = indice_simbolo_core_elf(contexto, nombre)
    afirmar(indice >= 0, "variable ELF desconocida '" + nombre + "'")
    sea simbolos: lista = contexto.simbolos
    retornar simbolos[indice].desplazamiento
}

funcion buscar_funcion_core_elf(
    contexto: cualquiera,
    nombre: texto
): cualquiera {
    sea indice: numero = 0
    mientras (indice < longitud(contexto.funciones)) {
        si (contexto.funciones[indice].nombre == nombre) {
            retornar contexto.funciones[indice]
        }
        indice = indice + 1
    }
    afirmar(falso, "función ELF desconocida '" + nombre + "'")
    retornar contexto.funciones[0]
}

funcion emitir_argumentos_llamada_core_elf(
    argumentos: lista,
    contexto: cualquiera
) {
    afirmar(longitud(argumentos) <= 4, "B6.7 admite hasta cuatro parámetros")
    sea indice: numero = 0
    mientras (indice < longitud(argumentos)) {
        emitir_expresion_core_elf(argumentos[indice], contexto)
        operacion_bytes_elf(contexto, [80])
        indice = indice + 1
    }
    indice = longitud(argumentos)
    mientras (indice > 0) {
        indice = indice - 1
        si (indice == 0) { operacion_bytes_elf(contexto, [95]) }
        si (indice == 1) { operacion_bytes_elf(contexto, [94]) }
        si (indice == 2) { operacion_bytes_elf(contexto, [90]) }
        si (indice == 3) { operacion_bytes_elf(contexto, [89]) }
    }
}

funcion entero_32_core_elf(valor: numero): numero {
    si (valor < 0) {
        retornar 4294967296 + valor
    }
    retornar valor
}

funcion bytes_mov_rax_core_elf(valor: numero): lista {
    afirmar(valor >= 0 y valor < 2147483648, "entero fuera del rango B6.7")
    sea bytes: lista = [72, 184]
    agregar_le_elf(bytes, valor, 8)
    retornar bytes
}

funcion emitir_cargar_variable_core_elf(
    contexto: cualquiera,
    desplazamiento: numero
) {
    sea bytes: lista = [72, 139, 133]
    agregar_le_elf(bytes, entero_32_core_elf(desplazamiento), 4)
    operacion_bytes_elf(contexto, bytes)
}

funcion emitir_guardar_variable_core_elf(
    contexto: cualquiera,
    desplazamiento: numero
) {
    sea bytes: lista = [72, 137, 133]
    agregar_le_elf(bytes, entero_32_core_elf(desplazamiento), 4)
    operacion_bytes_elf(contexto, bytes)
}

funcion emitir_comparacion_core_elf(
    contexto: cualquiera,
    operador: texto
) {
    sea condicion: numero = 0
    si (operador == "==") { condicion = 148 }
    si (operador == "!=") { condicion = 149 }
    si (operador == "<") { condicion = 156 }
    si (operador == "<=") { condicion = 158 }
    si (operador == ">") { condicion = 159 }
    si (operador == ">=") { condicion = 157 }
    afirmar(condicion > 0, "comparación ELF desconocida")
    operacion_bytes_elf(contexto, [72, 57, 193, 15, condicion, 192])
    operacion_bytes_elf(contexto, [72, 15, 182, 192])
}

funcion emitir_expresion_core_elf(nodo: cualquiera, contexto: cualquiera) {
    si (nodo.tipo == "Numero") {
        operacion_bytes_elf(
            contexto,
            bytes_mov_rax_core_elf(numero_ast_core_elf(nodo.valor))
        )
        retornar 0
    }
    si (nodo.tipo == "Booleano") {
        si (nodo.valor == "verdadero") {
            operacion_bytes_elf(contexto, bytes_mov_rax_core_elf(1))
        } sino {
            operacion_bytes_elf(contexto, bytes_mov_rax_core_elf(0))
        }
        retornar 0
    }
    si (nodo.tipo == "Identificador") {
        si (indice_texto_core_elf(contexto, nodo.valor) >= 0) {
            afirmar(
                falso,
                "el texto '" + nodo.valor +
                "' requiere una operación textual"
            )
        }
        emitir_cargar_variable_core_elf(
            contexto,
            desplazamiento_simbolo_core_elf(contexto, nodo.valor)
        )
        retornar 0
    }
    si (nodo.tipo == "Indice") {
        sea hijos_indice: lista = nodo.hijos
        afirmar(
            hijos_indice[0].tipo == "Identificador",
            "B6.7 indexa una lista identificada"
        )
        sea coleccion: cualquiera = buscar_coleccion_core_elf(
            contexto, hijos_indice[0].valor
        )
        emitir_expresion_core_elf(hijos_indice[1], contexto)
        operacion_bytes_elf(contexto, [72, 247, 216])
        sea direccion_lista: lista = [72, 141, 141]
        agregar_le_elf(
            direccion_lista,
            entero_32_core_elf(coleccion.desplazamiento),
            4
        )
        operacion_bytes_elf(contexto, direccion_lista)
        operacion_bytes_elf(contexto, [72, 139, 4, 193])
        retornar 0
    }
    si (nodo.tipo == "Miembro" y nodo.valor == "length") {
        sea base_miembro: lista = nodo.hijos
        afirmar(
            base_miembro[0].tipo == "Identificador",
            "length requiere un identificador"
        )
        sea nombre_base: texto = base_miembro[0].valor
        si (indice_coleccion_core_elf(contexto, nombre_base) >= 0) {
            sea lista_base: cualquiera =
                buscar_coleccion_core_elf(contexto, nombre_base)
            operacion_bytes_elf(
                contexto,
                bytes_mov_rax_core_elf(lista_base.longitud)
            )
            retornar 0
        }
        sea texto_base: cualquiera =
            buscar_texto_core_elf(contexto, nombre_base)
        emitir_cargar_variable_core_elf(contexto, texto_base.longitud)
        retornar 0
    }
    si (nodo.tipo == "Llamada") {
        si (nodo.valor == "longitud") {
            afirmar(longitud(nodo.hijos) == 1, "longitud requiere un valor")
            sea argumento_longitud: cualquiera = nodo.hijos[0]
            afirmar(
                argumento_longitud.tipo == "Identificador",
                "B6.7 longitud requiere un identificador"
            )
            sea nombre_longitud: texto = argumento_longitud.valor
            si (indice_coleccion_core_elf(contexto, nombre_longitud) >= 0) {
                sea lista_longitud: cualquiera =
                    buscar_coleccion_core_elf(contexto, nombre_longitud)
                operacion_bytes_elf(
                    contexto,
                    bytes_mov_rax_core_elf(lista_longitud.longitud)
                )
            } sino {
                sea texto_longitud: cualquiera =
                    buscar_texto_core_elf(contexto, nombre_longitud)
                emitir_cargar_variable_core_elf(
                    contexto, texto_longitud.longitud
                )
            }
            retornar 0
        }
        sea funcion: cualquiera =
            buscar_funcion_core_elf(contexto, nodo.valor)
        emitir_argumentos_llamada_core_elf(nodo.hijos, contexto)
        operacion_control_elf(contexto, "call_rel", funcion.etiqueta, 0)
        retornar 0
    }
    si (nodo.tipo == "Unario") {
        sea hijos_unarios: lista = nodo.hijos
        emitir_expresion_core_elf(hijos_unarios[0], contexto)
        si (nodo.valor == "-") {
            operacion_bytes_elf(contexto, [72, 247, 216])
            retornar 0
        }
        si (nodo.valor == "no") {
            operacion_bytes_elf(contexto, [
                72, 133, 192, 15, 148, 192, 72, 15, 182, 192
            ])
            retornar 0
        }
    }
    si (nodo.tipo == "Binario") {
        sea hijos: lista = nodo.hijos
        emitir_expresion_core_elf(hijos[0], contexto)
        operacion_bytes_elf(contexto, [80])
        emitir_expresion_core_elf(hijos[1], contexto)
        operacion_bytes_elf(contexto, [89])

        si (nodo.valor == "+") {
            operacion_bytes_elf(contexto, [72, 1, 200])
            retornar 0
        }
        si (nodo.valor == "-") {
            operacion_bytes_elf(contexto, [72, 41, 193, 72, 137, 200])
            retornar 0
        }
        si (nodo.valor == "*") {
            operacion_bytes_elf(contexto, [72, 15, 175, 193])
            retornar 0
        }
        si (nodo.valor == "/") {
            operacion_bytes_elf(contexto, [
                73, 137, 194, 72, 137, 200, 72, 153, 73, 247, 250
            ])
            retornar 0
        }
        emitir_comparacion_core_elf(contexto, nodo.valor)
        retornar 0
    }
    afirmar(
        falso,
        "B6.7 no puede emitir expresión '" + nodo.tipo + "'"
    )
}

funcion registrar_texto_core_elf(
    contexto: cualquiera,
    literal: texto
): texto {
    sea nombre: texto = nombre_unico_core_elf(contexto, "dato")
    sea bytes: lista = bytes_texto(literal)
    agregar(contexto.datos, DatoELFCore(nombre, bytes))
    retornar nombre
}

funcion emitir_texto_core_elf(nodo: cualquiera, contexto: cualquiera) {
    si (nodo.tipo == "Texto") {
        sea literal: texto = texto_ast_core_elf(nodo.valor)
        sea nombre: texto = registrar_texto_core_elf(contexto, literal)
        operacion_control_elf(contexto, "lea_dato_rax", nombre, 0)
        sea mover_longitud: lista = [72, 186]
        agregar_le_elf(mover_longitud, longitud(bytes_texto(literal)), 8)
        operacion_bytes_elf(contexto, mover_longitud)
        retornar 0
    }
    si (nodo.tipo == "Identificador") {
        sea simbolo_texto: cualquiera =
            buscar_texto_core_elf(contexto, nodo.valor)
        emitir_cargar_variable_core_elf(contexto, simbolo_texto.puntero)
        sea cargar_longitud: lista = [72, 139, 149]
        agregar_le_elf(
            cargar_longitud,
            entero_32_core_elf(simbolo_texto.longitud),
            4
        )
        operacion_bytes_elf(contexto, cargar_longitud)
        retornar 0
    }
    si (nodo.tipo == "Binario" y nodo.valor == "+") {
        sea partes: lista = nodo.hijos
        emitir_texto_core_elf(partes[0], contexto)
        operacion_bytes_elf(contexto, [80, 82])
        emitir_texto_core_elf(partes[1], contexto)
        operacion_bytes_elf(contexto, [73, 137, 194, 73, 137, 211])
        operacion_bytes_elf(contexto, [65, 88, 89])
        sea buffer: numero = reservar_memoria_core_elf(contexto, 256)
        sea direccion_buffer: lista = [76, 141, 141]
        agregar_le_elf(
            direccion_buffer,
            entero_32_core_elf(buffer),
            4
        )
        operacion_bytes_elf(contexto, direccion_buffer)
        operacion_bytes_elf(contexto, [75, 141, 20, 24])
        sea inicio_buffer: lista = [72, 141, 133]
        agregar_le_elf(
            inicio_buffer,
            entero_32_core_elf(buffer),
            4
        )
        operacion_bytes_elf(contexto, inicio_buffer)
        sea copiar_izquierda: texto =
            nombre_unico_core_elf(contexto, "texto_izquierdo")
        sea copiar_derecha: texto =
            nombre_unico_core_elf(contexto, "texto_derecho")
        sea fin_izquierda: texto =
            nombre_unico_core_elf(contexto, "fin_izquierdo")
        sea fin_derecha: texto =
            nombre_unico_core_elf(contexto, "fin_derecho")
        etiqueta_core_elf(contexto, copiar_izquierda)
        operacion_bytes_elf(contexto, [77, 133, 192])
        operacion_control_elf(contexto, "jz", fin_izquierda, 0)
        operacion_bytes_elf(contexto, [138, 1, 65, 136, 1])
        operacion_bytes_elf(contexto, [72, 255, 193, 73, 255, 193, 73, 255, 200])
        operacion_control_elf(contexto, "jmp", copiar_izquierda, 0)
        etiqueta_core_elf(contexto, fin_izquierda)
        etiqueta_core_elf(contexto, copiar_derecha)
        operacion_bytes_elf(contexto, [77, 133, 219])
        operacion_control_elf(contexto, "jz", fin_derecha, 0)
        operacion_bytes_elf(contexto, [65, 138, 2, 65, 136, 1])
        operacion_bytes_elf(contexto, [73, 255, 194, 73, 255, 193, 73, 255, 203])
        operacion_control_elf(contexto, "jmp", copiar_derecha, 0)
        etiqueta_core_elf(contexto, fin_derecha)
        retornar 0
    }
    afirmar(falso, "expresión textual ELF no soportada")
}

funcion emitir_mostrar_core_elf(nodo: cualquiera, contexto: cualquiera) {
    sea hijos: lista = nodo.hijos
    sea valor: cualquiera = hijos[0]
    emitir_texto_core_elf(valor, contexto)
    // write(1, rax, rdx): rax contiene el puntero y rdx la longitud.
    operacion_bytes_elf(contexto, [
        72, 137, 198,
        72, 199, 192, 1, 0, 0, 0,
        72, 199, 199, 1, 0, 0, 0,
        15, 5
    ])
    sea salto_linea: texto = registrar_texto_core_elf(contexto, "\n")
    operacion_control_elf(contexto, "lea_dato_rsi", salto_linea, 0)
    operacion_bytes_elf(contexto, [
        72, 199, 192, 1, 0, 0, 0,
        72, 199, 199, 1, 0, 0, 0,
        72, 199, 194, 1, 0, 0, 0,
        15, 5
    ])
}

funcion emitir_bloque_core_elf(nodo: cualquiera, contexto: cualquiera) {
    sea sentencias: lista = nodo.hijos
    sea indice: numero = 0
    mientras (indice < longitud(sentencias)) {
        emitir_sentencia_core_elf(sentencias[indice], contexto)
        indice = indice + 1
    }
}

funcion emitir_sentencia_core_elf(nodo: cualquiera, contexto: cualquiera) {
    sea hijos: lista = nodo.hijos
    si (nodo.tipo == "Declaracion") {
        sea nombre: texto = nombre_declaracion_core_elf(nodo.valor)
        si (hijos[0].tipo == "Lista") {
            sea elementos: lista = hijos[0].hijos
            sea base: numero = contexto.siguiente_desplazamiento - 8
            sea elemento: numero = 0
            mientras (elemento < longitud(elementos)) {
                sea desplazamiento_elemento: numero =
                    declarar_simbolo_core_elf(
                        contexto,
                        nombre + "#" + a_texto(elemento)
                    )
                emitir_expresion_core_elf(elementos[elemento], contexto)
                emitir_guardar_variable_core_elf(
                    contexto, desplazamiento_elemento
                )
                elemento = elemento + 1
            }
            agregar(
                contexto.colecciones,
                ColeccionELFCore(nombre, base, longitud(elementos))
            )
            retornar 0
        }
        si (hijos[0].tipo == "Texto") {
            sea puntero: numero =
                declarar_simbolo_core_elf(contexto, nombre + "#puntero")
            sea largo: numero =
                declarar_simbolo_core_elf(contexto, nombre + "#longitud")
            emitir_texto_core_elf(hijos[0], contexto)
            emitir_guardar_variable_core_elf(contexto, puntero)
            sea guardar_largo: lista = [72, 137, 149]
            agregar_le_elf(
                guardar_largo,
                entero_32_core_elf(largo),
                4
            )
            operacion_bytes_elf(contexto, guardar_largo)
            agregar(contexto.textos, TextoELFCore(nombre, puntero, largo))
            retornar 0
        }
        sea desplazamiento: numero =
            declarar_simbolo_core_elf(contexto, nombre)
        emitir_expresion_core_elf(hijos[0], contexto)
        emitir_guardar_variable_core_elf(contexto, desplazamiento)
        retornar 0
    }
    si (nodo.tipo == "Asignacion") {
        sea objetivo: cualquiera = hijos[0]
        si (objetivo.tipo == "Indice") {
            sea partes_indice: lista = objetivo.hijos
            afirmar(
                partes_indice[0].tipo == "Identificador",
                "asignación indexada requiere una lista"
            )
            sea coleccion_objetivo: cualquiera =
                buscar_coleccion_core_elf(
                    contexto, partes_indice[0].valor
                )
            emitir_expresion_core_elf(hijos[1], contexto)
            operacion_bytes_elf(contexto, [80])
            emitir_expresion_core_elf(partes_indice[1], contexto)
            operacion_bytes_elf(contexto, [72, 247, 216])
            sea base_objetivo: lista = [72, 141, 141]
            agregar_le_elf(
                base_objetivo,
                entero_32_core_elf(coleccion_objetivo.desplazamiento),
                4
            )
            operacion_bytes_elf(contexto, base_objetivo)
            operacion_bytes_elf(contexto, [90, 72, 137, 20, 193])
            retornar 0
        }
        si (
            objetivo.tipo == "Identificador" y
            indice_texto_core_elf(contexto, objetivo.valor) >= 0
        ) {
            sea texto_objetivo: cualquiera =
                buscar_texto_core_elf(contexto, objetivo.valor)
            emitir_texto_core_elf(hijos[1], contexto)
            emitir_guardar_variable_core_elf(
                contexto, texto_objetivo.puntero
            )
            sea guardar_nuevo_largo: lista = [72, 137, 149]
            agregar_le_elf(
                guardar_nuevo_largo,
                entero_32_core_elf(texto_objetivo.longitud),
                4
            )
            operacion_bytes_elf(contexto, guardar_nuevo_largo)
            retornar 0
        }
        afirmar(
            objetivo.tipo == "Identificador",
            "B6.7 solo asigna variables"
        )
        emitir_expresion_core_elf(hijos[1], contexto)
        emitir_guardar_variable_core_elf(
            contexto,
            desplazamiento_simbolo_core_elf(contexto, objetivo.valor)
        )
        retornar 0
    }
    si (nodo.tipo == "Mostrar") {
        emitir_mostrar_core_elf(nodo, contexto)
        retornar 0
    }
    si (nodo.tipo == "Si") {
        sea etiqueta_sino: texto =
            nombre_unico_core_elf(contexto, "sino")
        sea etiqueta_fin: texto =
            nombre_unico_core_elf(contexto, "fin_si")
        emitir_expresion_core_elf(hijos[0], contexto)
        operacion_bytes_elf(contexto, [72, 133, 192])
        operacion_control_elf(contexto, "jz", etiqueta_sino, 0)
        emitir_bloque_core_elf(hijos[1], contexto)
        si (longitud(hijos) > 2) {
            operacion_control_elf(contexto, "jmp", etiqueta_fin, 0)
            etiqueta_core_elf(contexto, etiqueta_sino)
            emitir_bloque_core_elf(hijos[2], contexto)
            etiqueta_core_elf(contexto, etiqueta_fin)
        } sino {
            etiqueta_core_elf(contexto, etiqueta_sino)
        }
        retornar 0
    }
    si (nodo.tipo == "Mientras") {
        sea etiqueta_inicio: texto =
            nombre_unico_core_elf(contexto, "mientras")
        sea etiqueta_fin: texto =
            nombre_unico_core_elf(contexto, "fin_mientras")
        etiqueta_core_elf(contexto, etiqueta_inicio)
        emitir_expresion_core_elf(hijos[0], contexto)
        operacion_bytes_elf(contexto, [72, 133, 192])
        operacion_control_elf(contexto, "jz", etiqueta_fin, 0)
        emitir_bloque_core_elf(hijos[1], contexto)
        operacion_control_elf(contexto, "jmp", etiqueta_inicio, 0)
        etiqueta_core_elf(contexto, etiqueta_fin)
        retornar 0
    }
    si (nodo.tipo == "Retornar") {
        afirmar(
            contexto.retorno_actual != "",
            "retornar fuera de una función"
        )
        si (longitud(hijos) > 0) {
            emitir_expresion_core_elf(hijos[0], contexto)
        } sino {
            operacion_bytes_elf(contexto, bytes_mov_rax_core_elf(0))
        }
        operacion_control_elf(
            contexto, "jmp", contexto.retorno_actual, 0
        )
        retornar 0
    }
    si (nodo.tipo == "Expresion") {
        emitir_expresion_core_elf(hijos[0], contexto)
        retornar 0
    }
    si (nodo.tipo == "Vacia") {
        retornar 0
    }
    afirmar(falso, "B6.7 no puede emitir sentencia '" + nodo.tipo + "'")
}

funcion tamano_operacion_core_elf(operacion: cualquiera): numero {
    si (operacion.tipo == "etiqueta") { retornar 0 }
    si (operacion.tipo == "bytes") {
        retornar longitud(operacion.bytes)
    }
    si (operacion.tipo == "jmp") { retornar 5 }
    si (operacion.tipo == "jz") { retornar 6 }
    si (operacion.tipo == "call_rel") { retornar 5 }
    si (operacion.tipo == "lea_dato_rax") { retornar 7 }
    si (operacion.tipo == "lea_dato_rsi") { retornar 7 }
    afirmar(falso, "operación ELF desconocida '" + operacion.tipo + "'")
    retornar 0
}

funcion posicion_etiqueta_core_elf(
    operaciones: lista,
    nombre: texto
): numero {
    sea posicion: numero = 0
    sea indice: numero = 0
    mientras (indice < longitud(operaciones)) {
        sea operacion: cualquiera = operaciones[indice]
        si (operacion.tipo == "etiqueta" y operacion.nombre == nombre) {
            retornar posicion
        }
        posicion = posicion + tamano_operacion_core_elf(operacion)
        indice = indice + 1
    }
    afirmar(falso, "etiqueta ELF desconocida '" + nombre + "'")
    retornar 0
}

funcion posicion_dato_core_elf(
    datos: lista,
    nombre: texto
): numero {
    sea posicion: numero = 0
    sea indice: numero = 0
    mientras (indice < longitud(datos)) {
        si (datos[indice].nombre == nombre) {
            retornar posicion
        }
        posicion = posicion + longitud(datos[indice].bytes)
        indice = indice + 1
    }
    afirmar(falso, "dato ELF desconocido '" + nombre + "'")
    retornar 0
}

funcion resolver_operaciones_core_elf(contexto: cualquiera): lista {
    sea salida: lista = []
    sea operaciones: lista = contexto.operaciones
    sea tamano_codigo: numero = 0
    sea calculo: numero = 0
    mientras (calculo < longitud(operaciones)) {
        tamano_codigo = tamano_codigo +
            tamano_operacion_core_elf(operaciones[calculo])
        calculo = calculo + 1
    }
    sea posicion: numero = 0
    sea indice: numero = 0
    mientras (indice < longitud(operaciones)) {
        sea operacion: cualquiera = operaciones[indice]
        si (operacion.tipo == "bytes") {
            agregar_lista_elf(salida, operacion.bytes)
        }
        si (operacion.tipo == "jmp") {
            agregar(salida, 233)
            sea destino_jmp: numero =
                posicion_etiqueta_core_elf(operaciones, operacion.nombre)
            agregar_le_elf(
                salida,
                entero_32_core_elf(destino_jmp - (posicion + 5)),
                4
            )
        }
        si (operacion.tipo == "jz") {
            agregar_lista_elf(salida, [15, 132])
            sea destino_jz: numero =
                posicion_etiqueta_core_elf(operaciones, operacion.nombre)
            agregar_le_elf(
                salida,
                entero_32_core_elf(destino_jz - (posicion + 6)),
                4
            )
        }
        si (operacion.tipo == "call_rel") {
            agregar(salida, 232)
            sea destino_relativo: numero =
                posicion_etiqueta_core_elf(
                    operaciones, operacion.nombre
                )
            agregar_le_elf(
                salida,
                entero_32_core_elf(
                    destino_relativo - (posicion + 5)
                ),
                4
            )
        }
        si (operacion.tipo == "lea_dato_rax") {
            agregar_lista_elf(salida, [72, 141, 5])
            sea destino_dato_rax: numero =
                tamano_codigo + posicion_dato_core_elf(
                    contexto.datos,
                    operacion.nombre
                )
            agregar_le_elf(
                salida,
                entero_32_core_elf(
                    destino_dato_rax - (posicion + 7)
                ),
                4
            )
        }
        si (operacion.tipo == "lea_dato_rsi") {
            agregar_lista_elf(salida, [72, 141, 53])
            sea destino_dato_rsi: numero =
                tamano_codigo + posicion_dato_core_elf(
                    contexto.datos,
                    operacion.nombre
                )
            agregar_le_elf(
                salida,
                entero_32_core_elf(
                    destino_dato_rsi - (posicion + 7)
                ),
                4
            )
        }
        posicion = posicion + tamano_operacion_core_elf(operacion)
        indice = indice + 1
    }
    retornar salida
}

funcion datos_core_elf(contexto: cualquiera): lista {
    sea datos: lista = []
    sea indice: numero = 0
    mientras (indice < longitud(contexto.datos)) {
        agregar_lista_elf(datos, contexto.datos[indice].bytes)
        indice = indice + 1
    }
    retornar datos
}

funcion empaquetar_core_elf(codigo: lista, datos: lista): lista {
    // ELF64 ET_EXEC con un único segmento PT_LOAD RWX. El punto de entrada
    // comienza inmediatamente después de la cabecera ELF y del program header.
    sea tamano_archivo: numero = 120 + longitud(codigo) + longitud(datos)
    sea imagen: lista = [127, 69, 76, 70, 2, 1, 1, 0]
    sea indice_relleno: numero = 0
    mientras (indice_relleno < 8) {
        agregar(imagen, 0)
        indice_relleno = indice_relleno + 1
    }
    agregar_le_elf(imagen, 2, 2)
    agregar_le_elf(imagen, 62, 2)
    agregar_le_elf(imagen, 1, 4)
    agregar_le_elf(imagen, 4194424, 8)
    agregar_le_elf(imagen, 64, 8)
    agregar_le_elf(imagen, 0, 8)
    agregar_le_elf(imagen, 0, 4)
    agregar_le_elf(imagen, 64, 2)
    agregar_le_elf(imagen, 56, 2)
    agregar_le_elf(imagen, 1, 2)
    agregar_le_elf(imagen, 0, 2)
    agregar_le_elf(imagen, 0, 2)
    agregar_le_elf(imagen, 0, 2)

    agregar_le_elf(imagen, 1, 4)
    agregar_le_elf(imagen, 7, 4)
    agregar_le_elf(imagen, 0, 8)
    agregar_le_elf(imagen, 4194304, 8)
    agregar_le_elf(imagen, 4194304, 8)
    agregar_le_elf(imagen, tamano_archivo, 8)
    agregar_le_elf(imagen, tamano_archivo + 4096, 8)
    agregar_le_elf(imagen, 4096, 8)

    afirmar(longitud(imagen) == 120, "cabecera ELF Core inválida")
    agregar_lista_elf(imagen, codigo)
    agregar_lista_elf(imagen, datos)
    afirmar(longitud(imagen) == tamano_archivo, "imagen ELF Core inválida")
    retornar imagen
}

funcion compilar_core_elf(fuente: texto): lista {
    sea tokens: lista = tokenizar_core(fuente)
    sea programa_original: cualquiera = parsear_tokens_core(tokens)
    sea programa: cualquiera = bajar_objetos_core(programa_original)
    sea contexto: cualquiera =
        ContextoELFCore([], [], [], 0, [], "", [], [], 0)
    sea declaraciones: lista = programa.hijos
    sea indice: numero = 0

    mientras (indice < longitud(declaraciones)) {
        si (declaraciones[indice].tipo == "Funcion") {
            sea nombre_funcion: texto =
                nombre_declaracion_core_elf(declaraciones[indice].valor)
            agregar(
                contexto.funciones,
                FuncionELFCore(
                    nombre_funcion,
                    declaraciones[indice],
                    "funcion_" + nombre_funcion
                )
            )
        }
        indice = indice + 1
    }

    operacion_bytes_elf(contexto, [
        85, 72, 137, 229, 72, 129, 236, 0, 16, 0, 0
    ])
    indice = 0
    mientras (indice < longitud(declaraciones)) {
        sea nodo: cualquiera = declaraciones[indice]
        si (nodo.tipo != "Funcion") {
            emitir_sentencia_core_elf(nodo, contexto)
        }
        indice = indice + 1
    }

    operacion_bytes_elf(contexto, [
        72, 137, 236, 93,
        72, 199, 192, 60, 0, 0, 0,
        72, 49, 255,
        15, 5
    ])

    indice = 0
    mientras (indice < longitud(contexto.funciones)) {
        sea funcion: cualquiera = contexto.funciones[indice]
        sea nodo_funcion: cualquiera = funcion.nodo
        sea hijos_funcion: lista = nodo_funcion.hijos
        sea simbolos_anteriores: lista = contexto.simbolos
        sea retorno_anterior: texto = contexto.retorno_actual
        sea colecciones_anteriores: lista = contexto.colecciones
        sea textos_anteriores: lista = contexto.textos
        sea desplazamiento_anterior: numero =
            contexto.siguiente_desplazamiento
        contexto.simbolos = []
        contexto.colecciones = []
        contexto.textos = []
        contexto.siguiente_desplazamiento = 0
        contexto.retorno_actual = funcion.etiqueta + "_retorno"

        etiqueta_core_elf(contexto, funcion.etiqueta)
        operacion_bytes_elf(contexto, [
            85, 72, 137, 229, 72, 129, 236, 0, 16, 0, 0
        ])
        sea cantidad_parametros: numero = longitud(hijos_funcion) - 1
        afirmar(cantidad_parametros <= 4, "demasiados parámetros ELF")
        sea parametro: numero = 0
        mientras (parametro < cantidad_parametros) {
            sea nombre_parametro: texto =
                nombre_declaracion_core_elf(hijos_funcion[parametro].valor)
            sea desplazamiento_parametro: numero =
                declarar_simbolo_core_elf(contexto, nombre_parametro)
            sea guardar_parametro: lista = [72, 137, 189]
            si (parametro == 1) { guardar_parametro = [72, 137, 181] }
            si (parametro == 2) { guardar_parametro = [72, 137, 149] }
            si (parametro == 3) { guardar_parametro = [72, 137, 141] }
            agregar_le_elf(
                guardar_parametro,
                entero_32_core_elf(desplazamiento_parametro),
                4
            )
            operacion_bytes_elf(contexto, guardar_parametro)
            parametro = parametro + 1
        }
        emitir_bloque_core_elf(
            hijos_funcion[longitud(hijos_funcion) - 1],
            contexto
        )
        operacion_bytes_elf(contexto, bytes_mov_rax_core_elf(0))
        etiqueta_core_elf(contexto, contexto.retorno_actual)
        operacion_bytes_elf(contexto, [72, 137, 236, 93, 195])

        contexto.simbolos = simbolos_anteriores
        contexto.colecciones = colecciones_anteriores
        contexto.textos = textos_anteriores
        contexto.siguiente_desplazamiento = desplazamiento_anterior
        contexto.retorno_actual = retorno_anterior
        indice = indice + 1
    }

    sea codigo: lista = resolver_operaciones_core_elf(contexto)
    retornar empaquetar_core_elf(codigo, datos_core_elf(contexto))
}

sea argumentos_core_elf: lista = argumentos_programa()
afirmar(
    longitud(argumentos_core_elf) == 4,
    "uso: cforge-elf-core archivo.cfv -o programa"
)
afirmar(argumentos_core_elf[2] == "-o", "se esperaba -o")
sea fuente_core_elf: texto = leer_archivo(argumentos_core_elf[1])
sea ejecutable_core_elf: lista = compilar_core_elf(fuente_core_elf)
afirmar(
    escribir_bytes(argumentos_core_elf[3], ejecutable_core_elf),
    "no se pudo escribir ELF Core x64"
)
afirmar(
    hacer_ejecutable(argumentos_core_elf[3]),
    "no se pudo marcar ELF Core como ejecutable"
)
mostrar("C-Forge emitió ELF64 Core x86-64: " + argumentos_core_elf[3])
