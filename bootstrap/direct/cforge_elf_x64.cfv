// C-Forge B6.2 — emisor directo ELF64/x86-64.
// No genera C++, no invoca compilador, ensamblador ni enlazador.

funcion agregar_le(bytes: lista, valor_inicial: numero, cantidad: numero) {
    sea valor: numero = valor_inicial
    sea indice: numero = 0
    mientras (indice < cantidad) {
        sea byte: numero = valor % 256
        agregar(bytes, byte)
        valor = (valor - byte) / 256
        indice = indice + 1
    }
}

funcion agregar_ceros(bytes: lista, cantidad: numero) {
    sea indice: numero = 0
    mientras (indice < cantidad) {
        agregar(bytes, 0)
        indice = indice + 1
    }
}

funcion agregar_lista(destino: lista, origen: lista) {
    sea indice: numero = 0
    mientras (indice < longitud(origen)) {
        agregar(destino, origen[indice])
        indice = indice + 1
    }
}

funcion primer_literal_mostrar(fuente: texto): texto {
    sea resultado: texto = ""
    sea dentro: booleano = falso
    sea terminado: booleano = falso
    sea indice: numero = 0
    mientras (indice < longitud(fuente) y no terminado) {
        sea caracter: texto = fuente[indice]
        si (caracter == "\"") {
            si (dentro) {
                terminado = verdadero
            } sino {
                dentro = verdadero
            }
        } sino {
            si (dentro) {
                resultado = resultado + caracter
            }
        }
        indice = indice + 1
    }
    afirmar(terminado, "B6.2 requiere mostrar(\"texto\")")
    retornar resultado
}

funcion emitir_elf_x64(mensaje_sin_salto: texto): lista {
    sea mensaje: lista = bytes_texto(mensaje_sin_salto)
    agregar(mensaje, 10)

    sea codigo: lista = [
        184, 1, 0, 0, 0,
        191, 1, 0, 0, 0,
        72, 141, 53, 16, 0, 0, 0,
        186
    ]
    agregar_le(codigo, longitud(mensaje), 4)
    agregar_lista(codigo, [
        15, 5,
        184, 60, 0, 0, 0,
        49, 255,
        15, 5
    ])

    sea cabecera: lista = [127, 69, 76, 70, 2, 1, 1, 0]
    agregar_ceros(cabecera, 8)
    agregar_le(cabecera, 2, 2)
    agregar_le(cabecera, 62, 2)
    agregar_le(cabecera, 1, 4)
    agregar_le(cabecera, 4194424, 8)
    agregar_le(cabecera, 64, 8)
    agregar_le(cabecera, 0, 8)
    agregar_le(cabecera, 0, 4)
    agregar_le(cabecera, 64, 2)
    agregar_le(cabecera, 56, 2)
    agregar_le(cabecera, 1, 2)
    agregar_le(cabecera, 64, 2)
    agregar_le(cabecera, 0, 2)
    agregar_le(cabecera, 0, 2)

    sea tamano: numero = 120 + longitud(codigo) + longitud(mensaje)
    agregar_le(cabecera, 1, 4)
    agregar_le(cabecera, 5, 4)
    agregar_le(cabecera, 0, 8)
    agregar_le(cabecera, 4194304, 8)
    agregar_le(cabecera, 4194304, 8)
    agregar_le(cabecera, tamano, 8)
    agregar_le(cabecera, tamano, 8)
    agregar_le(cabecera, 4096, 8)

    agregar_lista(cabecera, codigo)
    agregar_lista(cabecera, mensaje)
    retornar cabecera
}

sea argumentos: lista = argumentos_programa()
afirmar(
    longitud(argumentos) == 3,
    "uso: cforge cforge_elf_x64.cfv archivo.cfv -o ejecutable"
)
afirmar(argumentos[1] == "-o", "se esperaba -o")

sea fuente: texto = leer_archivo(argumentos[0])
sea mensaje: texto = primer_literal_mostrar(fuente)
sea ejecutable: lista = emitir_elf_x64(mensaje)

afirmar(escribir_bytes(argumentos[2], ejecutable), "no se pudo escribir ELF")
afirmar(hacer_ejecutable(argumentos[2]), "no se pudo marcar como ejecutable")
mostrar("C-Forge emitió código máquina ELF64/x86-64: " + argumentos[2])
