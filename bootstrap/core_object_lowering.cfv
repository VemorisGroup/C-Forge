// C-Forge Core Object Lowering 1: representación común previa a Mach-O/ELF/PE.
estructura InstanciaObjetoCore {
    nombre: texto
    tipo: texto
}

estructura ContextoObjetosCore {
    programa_ir: cualquiera
    programa_ast: cualquiera
    instancias: lista
    errores: lista
}

funcion indice_instancia_objeto_core(instancias: lista, nombre: texto): numero {
    sea indice: numero = 0
    mientras (indice < longitud(instancias)) {
        si (instancias[indice].nombre == nombre) { retornar indice }
        indice = indice + 1
    }
    retornar -1
}

funcion nombre_campo_bajado_core(objeto: texto, campo: texto): texto {
    retornar objeto + "__campo__" + campo
}

funcion tipo_instancia_objeto_core(contexto: cualquiera, nombre: texto): cualquiera {
    sea indice: numero = indice_instancia_objeto_core(contexto.instancias, nombre)
    afirmar(indice >= 0, "CFLOW1001: objeto desconocido '" + nombre + "'")
    sea indice_tipo: numero = indice_tipo_ir(
        contexto.programa_ir.tipos, contexto.instancias[indice].tipo
    )
    afirmar(indice_tipo >= 0, "CFLOW1003: tipo de objeto desconocido")
    retornar contexto.programa_ir.tipos[indice_tipo]
}

funcion nombre_metodo_bajado_core(tipo: texto, metodo: texto): texto {
    retornar tipo + "__metodo__" + metodo
}

funcion bajar_expresion_metodo_core(nodo: cualquiera, tipo: cualquiera): cualquiera {
    si (nodo.tipo == "Miembro") {
        sea base: cualquiera = nodo.hijos[0]
        si (base.tipo == "Identificador" y base.valor == "este") {
            campo_tipo_ir(tipo, nodo.valor)
            retornar nodo_ast_core(
                "Identificador", "__este__" + nodo.valor, nodo.linea
            )
        }
    }
    sea hijos: lista = []
    sea indice: numero = 0
    mientras (indice < longitud(nodo.hijos)) {
        agregar(hijos, bajar_expresion_metodo_core(nodo.hijos[indice], tipo))
        indice = indice + 1
    }
    retornar nodo_ast_core_con_hijos(nodo.tipo, nodo.valor, nodo.linea, hijos)
}

funcion bajar_metodo_core(nodo: cualquiera, tipo: cualquiera): cualquiera {
    sea hijos: lista = []
    sea indice: numero = 0
    mientras (indice < longitud(tipo.campos)) {
        sea campo: cualquiera = tipo.campos[indice]
        agregar(hijos, nodo_ast_core(
            "Parametro", "__este__" + campo.nombre + ":" + campo.tipo,
            nodo.linea
        ))
        indice = indice + 1
    }
    indice = 0
    mientras (indice + 1 < longitud(nodo.hijos)) {
        agregar(hijos, nodo.hijos[indice])
        indice = indice + 1
    }
    agregar(
        hijos,
        bajar_expresion_metodo_core(
            nodo.hijos[longitud(nodo.hijos) - 1], tipo
        )
    )
    retornar nodo_ast_core_con_hijos(
        "Funcion",
        nombre_metodo_bajado_core(tipo.nombre, nombre_firma_ir(nodo.valor)) +
            ":" + tipo_firma_ir(nodo.valor),
        nodo.linea,
        hijos
    )
}

funcion bajar_metodos_tipo_core(nodo: cualquiera, programa_ir: cualquiera): lista {
    sea resultado: lista = []
    si (nodo.tipo != "Clase") { retornar resultado }
    sea indice_tipo: numero = indice_tipo_ir(programa_ir.tipos, nodo.valor)
    afirmar(indice_tipo >= 0, "CFLOW1004: clase no registrada")
    sea tipo: cualquiera = programa_ir.tipos[indice_tipo]
    sea indice: numero = 0
    mientras (indice < longitud(nodo.hijos)) {
        si (nodo.hijos[indice].tipo == "Metodo") {
            agregar(resultado, bajar_metodo_core(nodo.hijos[indice], tipo))
        }
        indice = indice + 1
    }
    retornar resultado
}

funcion nodo_tipo_ast_core(contexto: cualquiera, nombre: texto): cualquiera {
    sea indice: numero = 0
    mientras (indice < longitud(contexto.programa_ast.hijos)) {
        sea nodo: cualquiera = contexto.programa_ast.hijos[indice]
        si ((nodo.tipo == "Clase" o nodo.tipo == "Estructura" o
            nodo.tipo == "Interfaz") y
            nodo.valor == nombre) { retornar nodo }
        indice = indice + 1
    }
    afirmar(falso, "CFLOW1007: declaración de tipo desconocida '" + nombre + "'")
    retornar contexto.programa_ast
}

funcion nodo_metodo_ast_core(
    contexto: cualquiera,
    tipo_nombre: texto,
    metodo_nombre: texto
): cualquiera {
    sea tipo_ast: cualquiera = nodo_tipo_ast_core(contexto, tipo_nombre)
    sea indice: numero = 0
    mientras (indice < longitud(tipo_ast.hijos)) {
        sea miembro: cualquiera = tipo_ast.hijos[indice]
        si (miembro.tipo == "Metodo" y
            nombre_firma_ir(miembro.valor) == metodo_nombre) {
            retornar miembro
        }
        indice = indice + 1
    }
    afirmar(falso, "CFLOW1008: método no encontrado")
    retornar tipo_ast
}

funcion indice_metodo_ast_tipo_core(tipo_ast: cualquiera, nombre: texto): numero {
    sea indice: numero = 0
    mientras (indice < longitud(tipo_ast.hijos)) {
        sea miembro: cualquiera = tipo_ast.hijos[indice]
        si (miembro.tipo == "Metodo" y
            nombre_firma_ir(miembro.valor) == nombre) { retornar indice }
        indice = indice + 1
    }
    retornar -1
}

funcion indice_parametro_invocado_core(
    metodo: cualquiera,
    nombre: texto
): numero {
    sea indice: numero = 0
    mientras (indice + 1 < longitud(metodo.hijos)) {
        si (nombre_firma_ir(metodo.hijos[indice].valor) == nombre) {
            retornar indice
        }
        indice = indice + 1
    }
    retornar -1
}

funcion sustituir_invocacion_metodo_core(
    nodo: cualquiera,
    contexto: cualquiera,
    tipo: cualquiera,
    objeto: texto,
    metodo: cualquiera,
    argumentos: lista
): cualquiera {
    si (nodo.tipo == "Miembro") {
        sea base: cualquiera = nodo.hijos[0]
        si (base.tipo == "Identificador" y base.valor == "este") {
            campo_tipo_ir(tipo, nodo.valor)
            retornar nodo_ast_core(
                "Identificador",
                nombre_campo_bajado_core(objeto, nodo.valor),
                nodo.linea
            )
        }
    }
    si (nodo.tipo == "Identificador") {
        sea parametro: numero = indice_parametro_invocado_core(
            metodo, nodo.valor
        )
        si (parametro >= 0) {
            retornar bajar_expresion_objetos_core(
                argumentos[parametro], contexto
            )
        }
    }
    sea hijos: lista = []
    sea indice: numero = 0
    mientras (indice < longitud(nodo.hijos)) {
        agregar(hijos, sustituir_invocacion_metodo_core(
            nodo.hijos[indice], contexto, tipo, objeto, metodo, argumentos
        ))
        indice = indice + 1
    }
    retornar nodo_ast_core_con_hijos(nodo.tipo, nodo.valor, nodo.linea, hijos)
}

funcion expandir_invocacion_mutable_core(
    llamada: cualquiera,
    contexto: cualquiera
): lista {
    sea base: cualquiera = llamada.hijos[0]
    afirmar(base.tipo == "Identificador", "CFLOW1009: receptor mutable inválido")
    sea tipo: cualquiera = tipo_instancia_objeto_core(contexto, base.valor)
    sea metodo: cualquiera = nodo_metodo_ast_core(
        contexto, tipo.nombre, llamada.valor
    )
    sea argumentos: lista = []
    sea indice: numero = 1
    mientras (indice < longitud(llamada.hijos)) {
        agregar(argumentos, llamada.hijos[indice])
        indice = indice + 1
    }
    afirmar(
        longitud(argumentos) + 1 == longitud(metodo.hijos),
        "CFLOW1010: cantidad de argumentos inválida"
    )
    sea bloque: cualquiera = metodo.hijos[longitud(metodo.hijos) - 1]
    sea resultado: lista = []
    indice = 0
    mientras (indice < longitud(bloque.hijos)) {
        sea sentencia: cualquiera = sustituir_invocacion_metodo_core(
            bloque.hijos[indice], contexto, tipo, base.valor, metodo, argumentos
        )
        si (sentencia.tipo != "Retornar") { agregar(resultado, sentencia) }
        indice = indice + 1
    }
    retornar resultado
}

funcion bajar_expresion_objetos_core(nodo: cualquiera, contexto: cualquiera): cualquiera {
    si (nodo.tipo == "LlamadaMetodo") {
        sea base_llamada: cualquiera = nodo.hijos[0]
        afirmar(
            base_llamada.tipo == "Identificador",
            "CFLOW1005: llamada de método requiere una instancia identificada"
        )
        sea tipo_llamada: cualquiera = tipo_instancia_objeto_core(
            contexto, base_llamada.valor
        )
        sea indice_metodo: numero = indice_metodo_ir(
            tipo_llamada.metodos, nodo.valor
        )
        afirmar(indice_metodo >= 0, "CFLOW1006: método desconocido '" +
            tipo_llamada.nombre + "." + nodo.valor + "'")
        sea argumentos: lista = []
        sea indice_campo: numero = 0
        mientras (indice_campo < longitud(tipo_llamada.campos)) {
            agregar(argumentos, nodo_ast_core(
                "Identificador",
                nombre_campo_bajado_core(
                    base_llamada.valor,
                    tipo_llamada.campos[indice_campo].nombre
                ),
                nodo.linea
            ))
            indice_campo = indice_campo + 1
        }
        sea indice_argumento: numero = 1
        mientras (indice_argumento < longitud(nodo.hijos)) {
            agregar(argumentos, bajar_expresion_objetos_core(
                nodo.hijos[indice_argumento], contexto
            ))
            indice_argumento = indice_argumento + 1
        }
        retornar nodo_ast_core_con_hijos(
            "Llamada",
            nombre_metodo_bajado_core(tipo_llamada.nombre, nodo.valor),
            nodo.linea,
            argumentos
        )
    }
    si (nodo.tipo == "Miembro") {
        sea base: cualquiera = nodo.hijos[0]
        si (base.tipo == "Identificador") {
            sea indice: numero = indice_instancia_objeto_core(contexto.instancias, base.valor)
            si (indice >= 0) {
                sea tipo: cualquiera = tipo_instancia_objeto_core(contexto, base.valor)
                campo_tipo_ir(tipo, nodo.valor)
                retornar nodo_ast_core(
                    "Identificador",
                    nombre_campo_bajado_core(base.valor, nodo.valor),
                    nodo.linea
                )
            }
        }
    }
    sea hijos: lista = []
    sea indice_hijo: numero = 0
    mientras (indice_hijo < longitud(nodo.hijos)) {
        agregar(hijos, bajar_expresion_objetos_core(nodo.hijos[indice_hijo], contexto))
        indice_hijo = indice_hijo + 1
    }
    retornar nodo_ast_core_con_hijos(nodo.tipo, nodo.valor, nodo.linea, hijos)
}

funcion bajar_declaracion_objeto_core(nodo: cualquiera, contexto: cualquiera): lista {
    sea resultado: lista = []
    sea inicializador: cualquiera = nodo.hijos[0]
    si (inicializador.tipo != "Llamada") { retornar resultado }
    sea indice_tipo: numero = indice_tipo_ir(contexto.programa_ir.tipos, inicializador.valor)
    si (indice_tipo < 0) { retornar resultado }
    sea nombre: texto = nombre_firma_ir(nodo.valor)
    sea tipo: cualquiera = contexto.programa_ir.tipos[indice_tipo]
    agregar(contexto.instancias, InstanciaObjetoCore(nombre, tipo.nombre))
    sea tipo_ast: cualquiera = nodo_tipo_ast_core(contexto, tipo.nombre)
    sea indice_constructor: numero = indice_metodo_ast_tipo_core(tipo_ast, "crear")
    sea constructor: cualquiera = tipo_ast
    si (indice_constructor >= 0) {
        constructor = tipo_ast.hijos[indice_constructor]
        afirmar(
            longitud(inicializador.hijos) + 1 == longitud(constructor.hijos),
            "CFLOW1011: constructor de '" + tipo.nombre +
                "' recibió una cantidad de argumentos inválida"
        )
    } sino {
        afirmar(
            longitud(inicializador.hijos) == longitud(tipo.campos),
            "CFLOW1002: '" + tipo.nombre + "' requiere " +
                a_texto(longitud(tipo.campos)) + " campos"
        )
    }
    sea indice: numero = 0
    mientras (indice < longitud(tipo.campos)) {
        sea campo: cualquiera = tipo.campos[indice]
        sea valor_campo: cualquiera = nodo_ast_core("Numero", "0", nodo.linea)
        si (indice_constructor >= 0) {
            sea bloque_constructor: cualquiera =
                constructor.hijos[longitud(constructor.hijos) - 1]
            sea encontrado: booleano = falso
            sea sentencia: numero = 0
            mientras (sentencia < longitud(bloque_constructor.hijos)) {
                sea candidato: cualquiera = bloque_constructor.hijos[sentencia]
                si (candidato.tipo == "Asignacion" y
                    candidato.hijos[0].tipo == "Miembro" y
                    candidato.hijos[0].valor == campo.nombre y
                    candidato.hijos[0].hijos[0].tipo == "Identificador" y
                    candidato.hijos[0].hijos[0].valor == "este") {
                    valor_campo = sustituir_invocacion_metodo_core(
                        candidato.hijos[1], contexto, tipo, nombre,
                        constructor, inicializador.hijos
                    )
                    encontrado = verdadero
                }
                sentencia = sentencia + 1
            }
            afirmar(
                encontrado,
                "CFLOW1012: constructor no inicializa '" +
                    tipo.nombre + "." + campo.nombre + "'"
            )
        } sino {
            valor_campo = inicializador.hijos[indice]
        }
        agregar(resultado, nodo_ast_core_con_hijos(
            "Declaracion",
            nombre_campo_bajado_core(nombre, campo.nombre) + ":" + campo.tipo,
            nodo.linea,
            [bajar_expresion_objetos_core(valor_campo, contexto)]
        ))
        indice = indice + 1
    }
    retornar resultado
}

funcion bajar_sentencia_objetos_core(nodo: cualquiera, contexto: cualquiera): lista {
    si (nodo.tipo == "Declaracion") {
        sea objeto: lista = bajar_declaracion_objeto_core(nodo, contexto)
        si (longitud(objeto) > 0) { retornar objeto }
    }
    si (nodo.tipo == "Expresion" y longitud(nodo.hijos) == 1 y
        nodo.hijos[0].tipo == "LlamadaMetodo") {
        retornar expandir_invocacion_mutable_core(nodo.hijos[0], contexto)
    }
    sea hijos: lista = []
    sea indice: numero = 0
    mientras (indice < longitud(nodo.hijos)) {
        agregar(hijos, bajar_expresion_objetos_core(nodo.hijos[indice], contexto))
        indice = indice + 1
    }
    retornar [nodo_ast_core_con_hijos(nodo.tipo, nodo.valor, nodo.linea, hijos)]
}

funcion bajar_objetos_core(programa: cualquiera): cualquiera {
    sea programa_ir: cualquiera = construir_programa_ir(programa)
    afirmar(longitud(programa_ir.errores) == 0, "CFLOW1000: IR de objetos inválido")
    sea contexto: cualquiera = ContextoObjetosCore(programa_ir, programa, [], [])
    sea salida: lista = []
    sea indice: numero = 0
    mientras (indice < longitud(programa.hijos)) {
        sea metodos: lista = bajar_metodos_tipo_core(
            programa.hijos[indice], programa_ir
        )
        sea indice_metodo: numero = 0
        mientras (indice_metodo < longitud(metodos)) {
            agregar(salida, metodos[indice_metodo])
            indice_metodo = indice_metodo + 1
        }
        indice = indice + 1
    }
    indice = 0
    mientras (indice < longitud(programa.hijos)) {
        sea nodo: cualquiera = programa.hijos[indice]
        si (nodo.tipo != "Estructura" y nodo.tipo != "Clase" y
            nodo.tipo != "Interfaz") {
            sea bajadas: lista = bajar_sentencia_objetos_core(nodo, contexto)
            sea posicion: numero = 0
            mientras (posicion < longitud(bajadas)) {
                agregar(salida, bajadas[posicion])
                posicion = posicion + 1
            }
        }
        indice = indice + 1
    }
    sea instancia: numero = longitud(contexto.instancias) - 1
    mientras (instancia >= 0) {
        sea registro: cualquiera = contexto.instancias[instancia]
        sea tipo_ast: cualquiera = nodo_tipo_ast_core(contexto, registro.tipo)
        si (indice_metodo_ast_tipo_core(tipo_ast, "destruir") >= 0) {
            sea llamada_destructor: cualquiera = nodo_ast_core_con_hijos(
                "LlamadaMetodo", "destruir", 0,
                [nodo_ast_core("Identificador", registro.nombre, 0)]
            )
            sea destruccion: lista = expandir_invocacion_mutable_core(
                llamada_destructor, contexto
            )
            sea paso: numero = 0
            mientras (paso < longitud(destruccion)) {
                agregar(salida, destruccion[paso])
                paso = paso + 1
            }
        }
        instancia = instancia - 1
    }
    retornar nodo_ast_core_con_hijos("Programa", "", 1, salida)
}
