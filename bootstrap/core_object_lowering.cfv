// C-Forge Core Object Lowering 1: representación común previa a Mach-O/ELF/PE.
estructura InstanciaObjetoCore {
    nombre: texto
    tipo: texto
}

estructura ContextoObjetosCore {
    programa_ir: cualquiera
    instancias: lista
    errores: lista
}

funcion indice_instancia_objeto_core(instancias: lista, nombre: texto): numero {
    sea indice: numero = 0
    mientras (indice < longitud(instancias)) {
        si (instancias[indice].nombre == nombre) { retornar indice }
        indice = indice + 1
    }
    retornar -1
}

funcion nombre_campo_bajado_core(objeto: texto, campo: texto): texto {
    retornar objeto + "__campo__" + campo
}

funcion tipo_instancia_objeto_core(contexto: cualquiera, nombre: texto): cualquiera {
    sea indice: numero = indice_instancia_objeto_core(contexto.instancias, nombre)
    afirmar(indice >= 0, "CFLOW1001: objeto desconocido '" + nombre + "'")
    sea indice_tipo: numero = indice_tipo_ir(
        contexto.programa_ir.tipos, contexto.instancias[indice].tipo
    )
    afirmar(indice_tipo >= 0, "CFLOW1003: tipo de objeto desconocido")
    retornar contexto.programa_ir.tipos[indice_tipo]
}

funcion bajar_expresion_objetos_core(nodo: cualquiera, contexto: cualquiera): cualquiera {
    si (nodo.tipo == "Miembro") {
        sea base: cualquiera = nodo.hijos[0]
        si (base.tipo == "Identificador") {
            sea indice: numero = indice_instancia_objeto_core(contexto.instancias, base.valor)
            si (indice >= 0) {
                sea tipo: cualquiera = tipo_instancia_objeto_core(contexto, base.valor)
                campo_tipo_ir(tipo, nodo.valor)
                retornar nodo_ast_core(
                    "Identificador",
                    nombre_campo_bajado_core(base.valor, nodo.valor),
                    nodo.linea
                )
            }
        }
    }
    sea hijos: lista = []
    sea indice_hijo: numero = 0
    mientras (indice_hijo < longitud(nodo.hijos)) {
        agregar(hijos, bajar_expresion_objetos_core(nodo.hijos[indice_hijo], contexto))
        indice_hijo = indice_hijo + 1
    }
    retornar nodo_ast_core_con_hijos(nodo.tipo, nodo.valor, nodo.linea, hijos)
}

funcion bajar_declaracion_objeto_core(nodo: cualquiera, contexto: cualquiera): lista {
    sea resultado: lista = []
    sea inicializador: cualquiera = nodo.hijos[0]
    si (inicializador.tipo != "Llamada") { retornar resultado }
    sea indice_tipo: numero = indice_tipo_ir(contexto.programa_ir.tipos, inicializador.valor)
    si (indice_tipo < 0) { retornar resultado }
    sea nombre: texto = nombre_firma_ir(nodo.valor)
    sea tipo: cualquiera = contexto.programa_ir.tipos[indice_tipo]
    afirmar(
        longitud(inicializador.hijos) == longitud(tipo.campos),
        "CFLOW1002: '" + tipo.nombre + "' requiere " +
            a_texto(longitud(tipo.campos)) + " campos"
    )
    agregar(contexto.instancias, InstanciaObjetoCore(nombre, tipo.nombre))
    sea indice: numero = 0
    mientras (indice < longitud(tipo.campos)) {
        sea campo: cualquiera = tipo.campos[indice]
        agregar(resultado, nodo_ast_core_con_hijos(
            "Declaracion",
            nombre_campo_bajado_core(nombre, campo.nombre) + ":" + campo.tipo,
            nodo.linea,
            [bajar_expresion_objetos_core(inicializador.hijos[indice], contexto)]
        ))
        indice = indice + 1
    }
    retornar resultado
}

funcion bajar_sentencia_objetos_core(nodo: cualquiera, contexto: cualquiera): lista {
    si (nodo.tipo == "Declaracion") {
        sea objeto: lista = bajar_declaracion_objeto_core(nodo, contexto)
        si (longitud(objeto) > 0) { retornar objeto }
    }
    sea hijos: lista = []
    sea indice: numero = 0
    mientras (indice < longitud(nodo.hijos)) {
        agregar(hijos, bajar_expresion_objetos_core(nodo.hijos[indice], contexto))
        indice = indice + 1
    }
    retornar [nodo_ast_core_con_hijos(nodo.tipo, nodo.valor, nodo.linea, hijos)]
}

funcion bajar_objetos_core(programa: cualquiera): cualquiera {
    sea programa_ir: cualquiera = construir_programa_ir(programa)
    afirmar(longitud(programa_ir.errores) == 0, "CFLOW1000: IR de objetos inválido")
    sea contexto: cualquiera = ContextoObjetosCore(programa_ir, [], [])
    sea salida: lista = []
    sea indice: numero = 0
    mientras (indice < longitud(programa.hijos)) {
        sea nodo: cualquiera = programa.hijos[indice]
        si (nodo.tipo != "Estructura" y nodo.tipo != "Clase") {
            sea bajadas: lista = bajar_sentencia_objetos_core(nodo, contexto)
            sea posicion: numero = 0
            mientras (posicion < longitud(bajadas)) {
                agregar(salida, bajadas[posicion])
                posicion = posicion + 1
            }
        }
        indice = indice + 1
    }
    retornar nodo_ast_core_con_hijos("Programa", "", 1, salida)
}
