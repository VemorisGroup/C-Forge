{
  "Funcion": {
    "prefix": "fun",
    "body": [
      "funcion ${1:nombre}(${2:params}): ${3:tipo} {",
      "\t$0",
      "}"
    ],
    "description": "Declarar una función"
  },
  "Funcion async": {
    "prefix": "afun",
    "body": [
      "async funcion ${1:nombre}(${2:params}): ${3:tipo} {",
      "\t$0",
      "}"
    ],
    "description": "Declarar función async"
  },
  "Variable": {
    "prefix": "sea",
    "body": ["sea ${1:nombre} = $0"],
    "description": "Declarar variable"
  },
  "Constante": {
    "prefix": "const",
    "body": ["constante ${1:NOMBRE} = $0"],
    "description": "Declarar constante"
  },
  "Si/sino": {
    "prefix": "si",
    "body": [
      "si (${1:condicion}) {",
      "\t$2",
      "} sino {",
      "\t$0",
      "}"
    ],
    "description": "Condicional si/sino"
  },
  "Solo si": {
    "prefix": "sis",
    "body": [
      "si (${1:condicion}) {",
      "\t$0",
      "}"
    ],
    "description": "Condicional si simple"
  },
  "Mientras": {
    "prefix": "mien",
    "body": [
      "mientras (${1:condicion}) {",
      "\t$0",
      "}"
    ],
    "description": "Bucle mientras"
  },
  "Para en": {
    "prefix": "para",
    "body": [
      "para ${1:elem} en ${2:lista} {",
      "\t$0",
      "}"
    ],
    "description": "Bucle para...en"
  },
  "Para rango": {
    "prefix": "paran",
    "body": [
      "para ${1:i} en rango(${2:n}) {",
      "\t$0",
      "}"
    ],
    "description": "Bucle para con rango"
  },
  "Segun/caso": {
    "prefix": "segun",
    "body": [
      "segun ${1:variable} {",
      "\tcaso ${2:valor1}:",
      "\t\t$3",
      "\tcaso ${4:valor2}:",
      "\t\t$5",
      "\tdefecto:",
      "\t\t$0",
      "}"
    ],
    "description": "Switch/match segun/caso"
  },
  "Intentar/capturar": {
    "prefix": "try",
    "body": [
      "intentar {",
      "\t$1",
      "} capturar (${2:e}) {",
      "\t$0",
      "}"
    ],
    "description": "Try/catch intentar/capturar"
  },
  "Intentar/capturar/finalmente": {
    "prefix": "tryf",
    "body": [
      "intentar {",
      "\t$1",
      "} capturar (${2:e}) {",
      "\t$3",
      "} finalmente {",
      "\t$0",
      "}"
    ],
    "description": "Try/catch/finally"
  },
  "Clase": {
    "prefix": "clase",
    "body": [
      "clase ${1:Nombre} {",
      "\tconstructor(${2:params}) {",
      "\t\t$3",
      "\t}",
      "",
      "\tfuncion ${4:metodo}(): ${5:tipo} {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Declarar clase"
  },
  "Importar": {
    "prefix": "imp",
    "body": ["importar \"stdlib/${1:modulo}.cfv\""],
    "description": "Importar módulo stdlib"
  },
  "Mostrar": {
    "prefix": "mos",
    "body": ["mostrar(${1:valor})"],
    "description": "Imprimir en pantalla"
  },
  "Log info": {
    "prefix": "logi",
    "body": ["log_info(\"${1:mensaje}\")"],
    "description": "Log info"
  },
  "Log error": {
    "prefix": "loge",
    "body": ["log_error(\"${1:mensaje}\")"],
    "description": "Log error"
  },
  "JSON parsear": {
    "prefix": "jsonp",
    "body": ["sea ${1:datos} = json_parsear(${2:texto})"],
    "description": "Parsear JSON"
  },
  "Servidor web": {
    "prefix": "webserv",
    "body": [
      "importar \"stdlib/web.cfv\"",
      "",
      "sea srv = web_escuchar(${1:8080})",
      "mostrar(\"Servidor en http://localhost:${1:8080}\")",
      "",
      "mientras (verdadero) {",
      "\tsea req = web_solicitud(srv)",
      "\tsea metodo = req[\"metodo\"]",
      "\tsea ruta = req[\"ruta\"]",
      "",
      "\tsi (metodo == \"GET\" y ruta == \"/\") {",
      "\t\tweb_responder(srv, 200, \"$2\", \"text/plain\")",
      "\t} sino {",
      "\t\tweb_responder(srv, 404, \"No encontrado\", \"text/plain\")",
      "\t}",
      "}"
    ],
    "description": "Servidor web básico"
  },
  "HTTP GET": {
    "prefix": "httpget",
    "body": [
      "importar \"stdlib/http.cfv\"",
      "sea resp = http_get(\"${1:https://ejemplo.com}\")",
      "si (resp[\"codigo\"] == 200) {",
      "\t$0",
      "}"
    ],
    "description": "HTTP GET request"
  },
  "Lambda": {
    "prefix": "fn",
    "body": ["funcion(${1:params}) { ${2:cuerpo} }"],
    "description": "Función lambda"
  },
  "Filtrar lista": {
    "prefix": "filt",
    "body": [
      "sea ${1:resultado} = filtrar(${2:lista}, funcion(${3:x}) { ${4:condicion} })"
    ],
    "description": "Filtrar lista"
  },
  "Mapear lista": {
    "prefix": "mapl",
    "body": [
      "sea ${1:resultado} = mapear(${2:lista}, funcion(${3:x}) { ${4:transformacion} })"
    ],
    "description": "Mapear lista"
  },
  "Reducir lista": {
    "prefix": "redu",
    "body": [
      "sea ${1:resultado} = reducir(${2:lista}, ${3:inicial}, funcion(${4:acc}, ${5:x}) { ${4:acc} + ${5:x} })"
    ],
    "description": "Reducir lista"
  },
  "Leer archivo": {
    "prefix": "larch",
    "body": [
      "sea ${1:contenido} = leer_archivo(\"${2:ruta.txt}\")"
    ],
    "description": "Leer archivo"
  },
  "Escribir archivo": {
    "prefix": "earch",
    "body": [
      "escribir_archivo(\"${1:ruta.txt}\", ${2:contenido})"
    ],
    "description": "Escribir archivo"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Nombre} {",
      "\t${2:Variante1},",
      "\t${3:Variante2}",
      "}"
    ],
    "description": "Declarar enum"
  },
  "Prueba": {
    "prefix": "test",
    "body": [
      "importar \"stdlib/pruebas.cfv\"",
      "",
      "prueba(\"${1:descripcion}\", funcion() {",
      "\t${2:// arrange}",
      "\tafirmar(${3:condicion}, \"${4:mensaje}\")",
      "})"
    ],
    "description": "Prueba unitaria"
  },
  "Suite de pruebas": {
    "prefix": "suite",
    "body": [
      "importar \"stdlib/pruebas.cfv\"",
      "",
      "suite_iniciar(\"${1:Nombre Suite}\")",
      "",
      "prueba(\"${2:deberia hacer algo}\", funcion() {",
      "\t$3",
      "\tafirmar(${4:condicion}, \"${5:mensaje}\")",
      "})",
      "",
      "suite_finalizar()"
    ],
    "description": "Suite de pruebas"
  },
  "Nulo coalescing": {
    "prefix": "??",
    "body": ["${1:valor} ?? ${2:default}"],
    "description": "Operador nulo coalescing"
  },
  "Safe navigation": {
    "prefix": "?.",
    "body": ["${1:objeto}?.${2:campo}"],
    "description": "Operador safe navigation"
  },
  "Mapa": {
    "prefix": "mapa",
    "body": [
      "sea ${1:m} = {",
      "\t\"${2:clave}\": ${3:valor}$0",
      "}"
    ],
    "description": "Crear mapa/objeto"
  },
  "Lista": {
    "prefix": "lista",
    "body": ["sea ${1:l} = [${2}]"],
    "description": "Crear lista"
  },
  "Regex": {
    "prefix": "regex",
    "body": [
      "sea ${1:resultado} = regex_buscar(${2:texto}, \"${3:patron}\")"
    ],
    "description": "Buscar con regex"
  },
  "Header comentario": {
    "prefix": "header",
    "body": [
      "// ── ${1:Título} ────────────────────────────────────────────────────────────────",
      "$0"
    ],
    "description": "Comentario de sección"
  },
  "TODO": {
    "prefix": "todo",
    "body": ["// TODO: $0"],
    "description": "Comentario TODO"
  },
  "Importar todos los stdlib principales": {
    "prefix": "impall",
    "body": [
      "importar \"stdlib/log.cfv\"",
      "importar \"stdlib/json.cfv\"",
      "importar \"stdlib/texto.cfv\"",
      "importar \"stdlib/lista.cfv\"",
      "importar \"stdlib/fecha.cfv\"",
      "$0"
    ],
    "description": "Importar módulos stdlib comunes"
  }
}
