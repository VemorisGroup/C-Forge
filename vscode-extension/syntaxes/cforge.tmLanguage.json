{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "C-Forge",
  "scopeName": "source.cforge",
  "fileTypes": ["cfv"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#string-interpolation" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#function-definition" },
    { "include": "#function-call" },
    { "include": "#class-definition" },
    { "include": "#variable-declaration" },
    { "include": "#decorators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.cforge",
          "match": "//.*$"
        },
        {
          "name": "comment.block.cforge",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            { "name": "comment.block.cforge", "match": "." }
          ]
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.cforge",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "include": "#string-escape" },
        { "include": "#string-interpolation-inner" }
      ]
    },
    "string-escape": {
      "name": "constant.character.escape.cforge",
      "match": "\\\\[nrtbf\"'\\\\0]"
    },
    "string-interpolation-inner": {
      "name": "meta.interpolation.cforge",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.template-expression.begin.cforge" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.template-expression.end.cforge" }
      },
      "patterns": [
        { "include": "#keywords" },
        { "include": "#function-call" },
        { "include": "#identifiers" },
        { "include": "#numbers" },
        { "include": "#operators" }
      ]
    },
    "string-interpolation": {
      "name": "string.template.cforge",
      "begin": "`",
      "end": "`",
      "patterns": [
        { "include": "#string-escape" },
        { "include": "#string-interpolation-inner" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.cforge",
          "match": "\\b(si|sino|mientras|para|en|romper|continuar|retornar|segun|caso|defecto|intentar|capturar|lanzar|finalmente|importar|exportar)\\b"
        },
        {
          "name": "keyword.declaration.cforge",
          "match": "\\b(funcion|sea|constante|clase|extiende|implementa|interfaz|enum|tipo|async|esperar|externo|publico|privado|protegido|estatico|abstracto|final|sobrescribir)\\b"
        },
        {
          "name": "keyword.operator.cforge",
          "match": "\\b(y|o|no|en|es|como|nuevo|eliminar|this|super|nulo|verdadero|falso)\\b"
        },
        {
          "name": "keyword.other.cforge",
          "match": "\\b(rango|tipo_de|longitud|mostrar|leer|dormir|salir|tiempo_ms|cualquiera)\\b"
        }
      ]
    },
    "types": {
      "name": "entity.name.type.cforge",
      "match": "\\b(numero|texto|booleano|lista|mapa|nulo|tupla|conjunto|funcion|cualquiera|matriz|canal)\\b"
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.string.cforge",
          "match": "\\b(texto_dividir|texto_unir|texto_contiene|texto_empieza_con|texto_termina_con|texto_reemplazar|texto_mayusculas|texto_minusculas|texto_recortar|texto_longitud|texto_a_numero|texto_a_lista|texto_repetir|texto_invertir|texto_indice|texto_posiciones|texto_contar|texto_es_numero|texto_relleno_izq|texto_relleno_der|subcadena|codigo_char|char_codigo)\\b"
        },
        {
          "name": "support.function.list.cforge",
          "match": "\\b(agregar|eliminar_indice|insertar|invertir|ordenar|ordenar_por|filtrar|mapear|reducir|lista_slice|lista_buscar|lista_contiene|lista_contiene_elem|lista_contar_elem|lista_invertir|lista_rellenar|lista_cada_n|lista_max|lista_min|lista_suma|lista_promedio|lista_aplanar|lista_unico|lista_zip|lista_unzip|concatenar|lista_copiar|lista_vacia|lista_primero|lista_ultimo|lista_cola|lista_cabeza)\\b"
        },
        {
          "name": "support.function.map.cforge",
          "match": "\\b(tiene_clave|eliminar_clave|mapa_claves|mapa_valores|mapa_entradas|mapa_fusionar|mapa_filtrar_claves|mapa_omitir_claves|mapa_vacio|mapa_longitud|mapa_copiar|mapa_desde_listas)\\b"
        },
        {
          "name": "support.function.math.cforge",
          "match": "\\b(abs|redondear|piso|techo|raiz|potencia|log|log10|exp|seno|coseno|tangente|max|min|aleatorio|aleatorio_entero|numero_formato|numero_es_entero|numero_es_nan|rango_paso|pi|tau|infinito)\\b"
        },
        {
          "name": "support.function.io.cforge",
          "match": "\\b(leer_archivo|escribir_archivo|agregar_archivo|existe_archivo|eliminar_archivo|copiar_archivo|mover_archivo|archivo_tam|directorio_crear|directorio_eliminar|directorio_listar|directorio_listar_rec|es_directorio|es_archivo|ruta_unir|ruta_directorio|ruta_nombre|ruta_extension|ruta_sin_extension|ruta_absoluta)\\b"
        },
        {
          "name": "support.function.json.cforge",
          "match": "\\b(json_parsear|json_texto|json_bonito|json_valido)\\b"
        },
        {
          "name": "support.function.regex.cforge",
          "match": "\\b(regex_buscar|regex_buscar_todos|regex_reemplazar|regex_coincide|regex_dividir|regex_grupos)\\b"
        },
        {
          "name": "support.function.date.cforge",
          "match": "\\b(fecha_ahora|fecha_desde_iso|fecha_formato|fecha_diferencia|fecha_agregar|fecha_restar|fecha_componentes|dia_semana|es_bisiesto|tiempo_ms)\\b"
        },
        {
          "name": "support.function.crypto.cforge",
          "match": "\\b(sha256|sha512|md5|hmac_sha256|base64_encode|base64_decode|uuid_v4|generar_token|hash_bcrypt|hash_argon2|aes_encriptar|aes_desencriptar)\\b"
        },
        {
          "name": "support.function.http.cforge",
          "match": "\\b(http_get|http_post|http_put|http_delete|http_patch|http_head|http_opciones|web_escuchar|web_solicitud|web_responder)\\b"
        },
        {
          "name": "support.function.log.cforge",
          "match": "\\b(log_info|log_error|log_advertencia|log_debug|log_ok|log_configurar)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.cforge",
          "match": "\\b(verdadero|falso|nulo)\\b"
        },
        {
          "name": "constant.language.numeric.cforge",
          "match": "\\b(pi|tau|infinito|nan)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.cforge",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.cforge",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.float.cforge",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.cforge",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.cforge",
          "match": "(=|\\+=|-=|\\*=|/=|%=|\\|\\|=|&&=)"
        },
        {
          "name": "keyword.operator.comparison.cforge",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.cforge",
          "match": "(\\+|-|\\*|/|%|\\*\\*)"
        },
        {
          "name": "keyword.operator.logical.cforge",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.null-coalescing.cforge",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.operator.safe-navigation.cforge",
          "match": "\\?\\."
        },
        {
          "name": "keyword.operator.arrow.cforge",
          "match": "(-?>|=>)"
        },
        {
          "name": "keyword.operator.pipe.cforge",
          "match": "\\|>"
        }
      ]
    },
    "function-definition": {
      "name": "meta.function.cforge",
      "match": "\\b(funcion|async)\\s+([a-zA-Z_áéíóúÁÉÍÓÚñÑ][a-zA-Z0-9_áéíóúÁÉÍÓÚñÑ]*)\\s*\\(",
      "captures": {
        "1": { "name": "keyword.declaration.function.cforge" },
        "2": { "name": "entity.name.function.cforge" }
      }
    },
    "function-call": {
      "name": "meta.function-call.cforge",
      "match": "\\b([a-zA-Z_áéíóúÁÉÍÓÚñÑ][a-zA-Z0-9_áéíóúÁÉÍÓÚñÑ]*)\\s*\\(",
      "captures": {
        "1": { "name": "entity.name.function.call.cforge" }
      }
    },
    "class-definition": {
      "name": "meta.class.cforge",
      "match": "\\b(clase)\\s+([A-ZÁÉÍÓÚ][a-zA-Z0-9_áéíóúÁÉÍÓÚñÑ]*)",
      "captures": {
        "1": { "name": "keyword.declaration.class.cforge" },
        "2": { "name": "entity.name.class.cforge" }
      }
    },
    "variable-declaration": {
      "name": "meta.variable.cforge",
      "match": "\\b(sea|constante)\\s+([a-zA-Z_áéíóúÁÉÍÓÚñÑ][a-zA-Z0-9_áéíóúÁÉÍÓÚñÑ]*)",
      "captures": {
        "1": { "name": "keyword.declaration.variable.cforge" },
        "2": { "name": "variable.other.cforge" }
      }
    },
    "decorators": {
      "name": "meta.decorator.cforge",
      "match": "@[a-zA-Z_][a-zA-Z0-9_]*",
      "captures": {
        "0": { "name": "entity.name.decorator.cforge" }
      }
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.class.cforge",
          "match": "\\b[A-ZÁÉÍÓÚ][a-zA-Z0-9_áéíóúÁÉÍÓÚñÑ]*\\b"
        },
        {
          "name": "variable.other.cforge",
          "match": "\\b[a-z_áéíóúñ][a-zA-Z0-9_áéíóúÁÉÍÓÚñÑ]*\\b"
        }
      ]
    }
  }
}
