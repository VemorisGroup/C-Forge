{
  "name": "cforge-language",
  "displayName": "C-Forge Language",
  "description": "Soporte completo para C-Forge (.cfv) — LSP, autocompletado, hover, ir a definición, diagnósticos, snippets, formato",
  "version": "3.1.0",
  "publisher": "VemorisGroup",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VemorisGroup/C-Forge"
  },
  "bugs": {
    "url": "https://github.com/VemorisGroup/C-Forge/issues"
  },
  "homepage": "https://github.com/VemorisGroup/C-Forge#readme",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "c-forge",
    "cforge",
    "cfv",
    "vemoris",
    "lenguaje"
  ],
  "activationEvents": [
    "onLanguage:cforge"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "cforge",
        "aliases": ["C-Forge", "cforge"],
        "extensions": [".cfv"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/cforge-light.png",
          "dark": "./icons/cforge-dark.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "cforge",
        "scopeName": "source.cforge",
        "path": "./syntaxes/cforge.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "cforge",
        "path": "./snippets/cforge.json"
      }
    ],
    "themes": [],
    "commands": [
      {
        "command": "cforge.runFile",
        "title": "C-Forge: Ejecutar archivo",
        "icon": "$(play)"
      },
      {
        "command": "cforge.runSelection",
        "title": "C-Forge: Ejecutar selección"
      },
      {
        "command": "cforge.formatDocument",
        "title": "C-Forge: Formatear documento"
      },
      {
        "command": "cforge.restartLsp",
        "title": "C-Forge: Reiniciar servidor LSP"
      },
      {
        "command": "cforge.openPlayground",
        "title": "C-Forge: Abrir Playground"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "cforge.runFile",
          "when": "resourceExtname == .cfv",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "cforge.runFile",
          "when": "resourceExtname == .cfv",
          "group": "cforge"
        },
        {
          "command": "cforge.runSelection",
          "when": "resourceExtname == .cfv && editorHasSelection",
          "group": "cforge"
        }
      ]
    },
    "configuration": {
      "title": "C-Forge",
      "properties": {
        "cforge.interpreterPath": {
          "type": "string",
          "default": "cforgev",
          "description": "Ruta al intérprete C-Forge (cforgev)"
        },
        "cforge.lspEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Habilitar servidor LSP (autocompletado, hover, ir a definición, diagnósticos)"
        },
        "cforge.lspServerPath": {
          "type": "string",
          "default": "",
          "description": "Ruta al lsp_server.py (vacío = usa el incluido en la extensión)"
        },
        "cforge.stdlibPath": {
          "type": "string",
          "default": "",
          "description": "Ruta al directorio stdlib/ de C-Forge (CFORGE_STDLIB)"
        },
        "cforge.formatOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Formatear automáticamente al guardar"
        },
        "cforge.showRunButton": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar botón de ejecución en la barra de título"
        },
        "cforge.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Nivel de traza de comunicación con el servidor LSP"
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "cforge",
        "properties": {
          "file": {
            "type": "string",
            "description": "Archivo .cfv a ejecutar"
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0",
    "@vscode/vsce": "^2.19.0"
  }
}
