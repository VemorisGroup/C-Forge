// ejemplos/api_rest.cfv — API REST completa en C-Forge
// Endpoints: GET /usuarios, POST /usuarios, GET /usuarios/:id, DELETE /usuarios/:id
//
// Compilar: g++ -std=c++20 -O2 cforgev.cpp -DCFV_WITH_OPENSSL -DCFV_WITH_SQLITE
//           -lsqlite3 /usr/lib/.../libcrypto.so.3 -lpthread -o cforgev
// Correr:   ./cforgev ejemplos/api_rest.cfv
// Probar:   curl http://localhost:8080/usuarios
//           curl -X POST http://localhost:8080/usuarios -d '{"nombre":"Ana","email":"ana@ej.com"}'

importar "stdlib/web.cfv"
importar "stdlib/log.cfv"
importar "stdlib/validar.cfv"

// Base de datos en memoria (SQLite)
sea db = db_abrir(":memory:")
db_ejecutar(db, "CREATE TABLE usuarios (id INTEGER PRIMARY KEY AUTOINCREMENT, nombre TEXT NOT NULL, email TEXT UNIQUE NOT NULL, creado TEXT)")
db_ejecutar(db, "INSERT INTO usuarios (nombre, email, creado) VALUES ('Admin', 'admin@api.com', '2026-01-01')")

log_info("API C-Forge iniciando en puerto 8080...")

// Enrutador simple
funcion manejar_solicitud(req: mapa): mapa {
    sea metodo = req["metodo"]
    sea ruta = req["ruta"]
    sea cuerpo = req["cuerpo"]

    log_info("{metodo} {ruta}")

    // GET /
    si (metodo == "GET" y ruta == "/") {
        retornar web_ok_json({"api": "C-Forge REST", "version": "2.2", "estado": "ok"})
    }

    // GET /usuarios
    si (metodo == "GET" y ruta == "/usuarios") {
        sea usuarios = db_consulta(db, "SELECT id, nombre, email, creado FROM usuarios")
        retornar web_ok_json({"usuarios": usuarios, "total": longitud(usuarios)})
    }

    // GET /usuarios/:id
    si (metodo == "GET" y texto_empieza_con(ruta, "/usuarios/")) {
        sea id_str = subcadena(ruta, 10, longitud(ruta))
        sea id = texto_a_numero(id_str)
        sea resultados = db_consulta_p(db, "SELECT * FROM usuarios WHERE id = ?", [id])
        si (longitud(resultados) == 0) {
            retornar web_no_encontrado("Usuario no encontrado")
        }
        retornar web_ok_json(resultados[0])
    }

    // POST /usuarios
    si (metodo == "POST" y ruta == "/usuarios") {
        intentar {
            sea datos = json_parsear(cuerpo)
            sea validacion = validar_esquema(datos, {
                "nombre": {"requerido": verdadero, "tipo": "texto", "min": 2},
                "email":  {"requerido": verdadero, "tipo": "texto", "email": verdadero}
            })
            si (!validacion["valido"]) {
                retornar web_error(400, validacion["errores"][0])
            }
            sea nombre = datos["nombre"]
            sea email = datos["email"]
            sea fecha = fecha_ahora()
            sea fecha_str = fecha["iso"]
            db_consulta_p(db,
                "INSERT INTO usuarios (nombre, email, creado) VALUES (?, ?, ?)",
                [nombre, email, fecha_str]
            )
            sea nuevo_id = db_ultimo_id(db)
            retornar web_ok_json({"id": nuevo_id, "nombre": nombre, "email": email, "creado": fecha_str})
        } capturar (error) {
            si (texto_contiene(error, "UNIQUE")) {
                retornar web_error(409, "Email ya registrado")
            }
            retornar web_error(500, error)
        }
    }

    // DELETE /usuarios/:id
    si (metodo == "DELETE" y texto_empieza_con(ruta, "/usuarios/")) {
        sea id_str = subcadena(ruta, 10, longitud(ruta))
        sea id = texto_a_numero(id_str)
        sea afectados = db_consulta_p(db, "DELETE FROM usuarios WHERE id = ?", [id])
        retornar web_ok_json({"eliminado": verdadero, "id": id})
    }

    // GET /health
    si (ruta == "/health") {
        sea total = db_consulta(db, "SELECT COUNT(*) as n FROM usuarios")
        sea n = total[0]["n"]
        retornar web_ok_json({"estado": "ok", "usuarios": n, "tiempo": tiempo_segundos()})
    }

    retornar web_no_encontrado("Ruta no encontrada: {ruta}")
}

// Iniciar servidor
sea servidor = web_escuchar(8080)
log_info("Servidor listo. Ctrl+C para detener.")
mostrar("API corriendo en http://localhost:8080")
mostrar("")

mientras (verdadero) {
    sea req = web_solicitud(servidor)
    sea respuesta = manejar_solicitud(req)
    web_responder(servidor, respuesta["estado"], respuesta["cuerpo"], respuesta["tipo"])
}
