// ejemplos/app_banco.cfv — Aplicacion bancaria completa en C-Forge
// Demuestra: SQLite, validacion, crypto, HTTP server, logging
//
// Compilar: g++ -std=c++20 -O2 cforgev.cpp -DCFV_WITH_OPENSSL -DCFV_WITH_SQLITE
//           -lsqlite3 /usr/lib/.../libcrypto.so.3 -lpthread -o cforgev
// Correr:   ./cforgev ejemplos/app_banco.cfv

importar "stdlib/log.cfv"
importar "stdlib/validar.cfv"
importar "stdlib/crypto.cfv"

// ── Base de datos ─────────────────────────────────────────────────────────────

sea db = db_abrir("banco.db")

// Crear tablas
db_ejecutar(db, "CREATE TABLE IF NOT EXISTS clientes (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    nombre TEXT NOT NULL,
    email TEXT UNIQUE NOT NULL,
    password_hash TEXT NOT NULL,
    creado_en TEXT NOT NULL
)")

db_ejecutar(db, "CREATE TABLE IF NOT EXISTS cuentas (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    cliente_id INTEGER NOT NULL,
    numero TEXT UNIQUE NOT NULL,
    tipo TEXT NOT NULL,
    saldo REAL NOT NULL DEFAULT 0.0,
    FOREIGN KEY (cliente_id) REFERENCES clientes(id)
)")

db_ejecutar(db, "CREATE TABLE IF NOT EXISTS transacciones (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    cuenta_origen INTEGER,
    cuenta_destino INTEGER,
    tipo TEXT NOT NULL,
    monto REAL NOT NULL,
    descripcion TEXT,
    fecha TEXT NOT NULL
)")

log_info("Base de datos inicializada")

// ── Funciones de negocio ──────────────────────────────────────────────────────

funcion registrar_cliente(nombre: texto, email: texto, password: texto): mapa {
    // Validar datos
    sea esquema = {
        "nombre":   {"requerido": verdadero, "tipo": "texto", "min": 2, "max": 100},
        "email":    {"requerido": verdadero, "tipo": "texto", "email": verdadero},
        "password": {"requerido": verdadero, "tipo": "texto", "min": 8}
    }
    sea datos = {"nombre": nombre, "email": email, "password": password}
    sea validacion = validar_esquema(datos, esquema)

    si (!validacion["valido"]) {
        retornar {"ok": falso, "error": validacion["errores"][0]}
    }

    // Hash de la contraseña
    sea hash = crypto_hash_contrasena(password)
    sea fecha = fecha_ahora()
    sea fecha_str = fecha["iso"]

    intentar {
        db_consulta_p(db,
            "INSERT INTO clientes (nombre, email, password_hash, creado_en) VALUES (?, ?, ?, ?)",
            [nombre, email, hash, fecha_str]
        )
        sea id = db_ultimo_id(db)

        // Crear cuenta de ahorros automaticamente
        sea numero_cuenta = "CFV{id}AH{tiempo_ms()}"
        db_consulta_p(db,
            "INSERT INTO cuentas (cliente_id, numero, tipo, saldo) VALUES (?, ?, ?, ?)",
            [id, numero_cuenta, "ahorros", 0.0]
        )

        log_info("Cliente registrado: {nombre} ({email})")
        retornar {"ok": verdadero, "id": id, "cuenta": numero_cuenta}
    } capturar (error) {
        si (texto_contiene(error, "UNIQUE")) {
            retornar {"ok": falso, "error": "El email ya esta registrado"}
        }
        retornar {"ok": falso, "error": error}
    }
}

funcion autenticar(email: texto, password: texto): mapa {
    sea resultados = db_consulta_p(db,
        "SELECT * FROM clientes WHERE email = ?", [email])

    si (longitud(resultados) == 0) {
        retornar {"ok": falso, "error": "Email o contraseña incorrectos"}
    }

    sea cliente = resultados[0]
    sea hash = cliente["password_hash"]

    si (!crypto_verificar_contrasena(password, hash)) {
        retornar {"ok": falso, "error": "Email o contraseña incorrectos"}
    }

    sea token = crypto_jwt_crear({"id": cliente["id"], "email": email}, "secreto_banco_123")
    log_info("Login: {email}")
    retornar {"ok": verdadero, "token": token, "cliente": cliente}
}

funcion depositar(cuenta_id: numero, monto: numero, descripcion: texto): mapa {
    si (monto <= 0) {
        retornar {"ok": falso, "error": "El monto debe ser positivo"}
    }

    db_transaccion(db)
    intentar {
        db_consulta_p(db,
            "UPDATE cuentas SET saldo = saldo + ? WHERE id = ?",
            [monto, cuenta_id]
        )
        sea fecha = fecha_ahora()
        db_consulta_p(db,
            "INSERT INTO transacciones (cuenta_destino, tipo, monto, descripcion, fecha) VALUES (?, ?, ?, ?, ?)",
            [cuenta_id, "deposito", monto, descripcion, fecha["iso"]]
        )
        db_confirmar(db)
        log_info("Deposito: ${monto} en cuenta {cuenta_id}")
        retornar {"ok": verdadero, "monto": monto}
    } capturar (error) {
        db_revertir(db)
        retornar {"ok": falso, "error": error}
    }
}

funcion transferir(cuenta_origen: numero, cuenta_destino: numero, monto: numero, descripcion: texto): mapa {
    si (monto <= 0) {
        retornar {"ok": falso, "error": "El monto debe ser positivo"}
    }
    si (cuenta_origen == cuenta_destino) {
        retornar {"ok": falso, "error": "No puede transferir a la misma cuenta"}
    }

    db_transaccion(db)
    intentar {
        // Verificar saldo suficiente
        sea cuenta = db_consulta_p(db, "SELECT saldo FROM cuentas WHERE id = ?", [cuenta_origen])
        si (longitud(cuenta) == 0) {
            db_revertir(db)
            retornar {"ok": falso, "error": "Cuenta origen no encontrada"}
        }
        sea saldo = cuenta[0]["saldo"]
        si (saldo < monto) {
            db_revertir(db)
            retornar {"ok": falso, "error": "Saldo insuficiente. Disponible: ${saldo}"}
        }

        // Debitar origen
        db_consulta_p(db, "UPDATE cuentas SET saldo = saldo - ? WHERE id = ?", [monto, cuenta_origen])
        // Acreditar destino
        db_consulta_p(db, "UPDATE cuentas SET saldo = saldo + ? WHERE id = ?", [monto, cuenta_destino])

        sea fecha = fecha_ahora()
        db_consulta_p(db,
            "INSERT INTO transacciones (cuenta_origen, cuenta_destino, tipo, monto, descripcion, fecha) VALUES (?, ?, ?, ?, ?, ?)",
            [cuenta_origen, cuenta_destino, "transferencia", monto, descripcion, fecha["iso"]]
        )
        db_confirmar(db)
        log_info("Transferencia: ${monto} de cuenta {cuenta_origen} a {cuenta_destino}")
        retornar {"ok": verdadero, "monto": monto}
    } capturar (error) {
        db_revertir(db)
        retornar {"ok": falso, "error": error}
    }
}

funcion obtener_estado_cuenta(cuenta_id: numero): mapa {
    sea cuentas = db_consulta_p(db, "SELECT * FROM cuentas WHERE id = ?", [cuenta_id])
    si (longitud(cuentas) == 0) {
        retornar {"ok": falso, "error": "Cuenta no encontrada"}
    }
    sea cuenta = cuentas[0]
    sea movimientos = db_consulta_p(db,
        "SELECT * FROM transacciones WHERE cuenta_origen = ? OR cuenta_destino = ? ORDER BY fecha DESC LIMIT 10",
        [cuenta_id, cuenta_id]
    )
    retornar {
        "ok": verdadero,
        "cuenta": cuenta,
        "movimientos": movimientos
    }
}

funcion calcular_prestamo(monto: numero, tasa_anual: numero, meses: numero): mapa {
    sea tasa_mes = tasa_anual / 100.0 / 12.0
    sea cuota = monto * tasa_mes / (1.0 - potencia(1.0 + tasa_mes, -meses))
    sea total_pagar = cuota * meses
    sea total_intereses = total_pagar - monto
    retornar {
        "monto": monto,
        "tasa_anual": tasa_anual,
        "meses": meses,
        "cuota_mensual": redondear(cuota * 100) / 100,
        "total_pagar": redondear(total_pagar * 100) / 100,
        "total_intereses": redondear(total_intereses * 100) / 100
    }
}

// ── Demo ──────────────────────────────────────────────────────────────────────

mostrar("=== BANCO C-FORGE ===")
mostrar("")

// Registrar cliente
sea r1 = registrar_cliente("Ana Rodriguez", "ana@banco.com", "MiClave123!")
sea msg_r1 = si_expr(r1["ok"], "OK - Cuenta: {r1["cuenta"]}", "Error: {r1["error"]}")
mostrar("Registro Ana: {msg_r1}")

sea r2 = registrar_cliente("Carlos Perez", "carlos@banco.com", "OtraClave456!")
sea msg_r2 = si_expr(r2["ok"], "OK - Cuenta: {r2["cuenta"]}", "Error: {r2["error"]}")
mostrar("Registro Carlos: {msg_r2}")

// Autenticar
sea auth = autenticar("ana@banco.com", "MiClave123!")
sea msg_auth = si_expr(auth["ok"], "OK - JWT generado", "Error: {auth["error"]}")
mostrar("Login Ana: {msg_auth}")

// Operaciones
sea d1 = depositar(1, 5000.0, "Deposito inicial")
sea msg_d1 = si_expr(d1["ok"], "OK - ${d1["monto"]}", "Error: {d1["error"]}")
mostrar("Deposito: {msg_d1}")

sea d2 = depositar(2, 3000.0, "Deposito inicial Carlos")
mostrar("Deposito Carlos: OK")

sea t1 = transferir(1, 2, 1500.0, "Pago de deuda")
sea msg_t1 = si_expr(t1["ok"], "OK - ${t1["monto"]}", "Error: {t1["error"]}")
mostrar("Transferencia: {msg_t1}")

// Estado de cuenta
sea estado = obtener_estado_cuenta(1)
sea cuenta_info = estado["cuenta"]
sea saldo = cuenta_info["saldo"]
mostrar("")
mostrar("=== ESTADO CUENTA ANA ===")
mostrar("Saldo: ${saldo}")
sea movs = estado["movimientos"]
mostrar("Movimientos recientes: {longitud(movs)}")

// Simulador de prestamo
mostrar("")
mostrar("=== SIMULADOR DE PRESTAMO ===")
sea prestamo = calcular_prestamo(100000, 12.5, 60)
sea cuota = prestamo["cuota_mensual"]
sea total = prestamo["total_pagar"]
sea intereses = prestamo["total_intereses"]
mostrar("Prestamo: $100,000 a 12.5% a 60 meses")
mostrar("Cuota mensual: ${cuota}")
mostrar("Total a pagar: ${total}")
mostrar("Total intereses: ${intereses}")

db_cerrar(db)
mostrar("")
mostrar("=== FIN DEMO BANCO ===")

funcion si_expr(cond: booleano, a: texto, b: texto): texto {
    si (cond) { retornar a }
    retornar b
}
