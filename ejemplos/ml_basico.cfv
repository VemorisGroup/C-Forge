// ejemplos/ml_basico.cfv — Machine Learning basico en C-Forge
// Regresion lineal, KNN, estadisticas, visualizacion en terminal

importar "stdlib/matematica_avanzada.cfv"
importar "stdlib/cli.cfv"

cli_banner("C-Forge ML", "2.2", "Vemoris Group")

// ─────────────────────────────────────────────────────────────────────────────
// 1. ESTADISTICAS DESCRIPTIVAS
// ─────────────────────────────────────────────────────────────────────────────
mostrar(negrita("1. Estadisticas descriptivas"))
mostrar(texto_repetir("─", 40))

sea salarios = [35000, 42000, 58000, 61000, 74000, 82000, 90000, 105000, 120000, 95000]
sea resumen_sal = resumen(salarios)

cli_tabla(
    ["Metrica", "Valor"],
    [
        ["N", resumen_sal["n"]],
        ["Min", numero_formato(resumen_sal["min"], 0)],
        ["Max", numero_formato(resumen_sal["max"], 0)],
        ["Media", numero_formato(resumen_sal["media"], 0)],
        ["Mediana", numero_formato(resumen_sal["mediana"], 0)],
        ["Desv. Std", numero_formato(resumen_sal["std"], 0)],
        ["P25", numero_formato(resumen_sal["p25"], 0)],
        ["P75", numero_formato(resumen_sal["p75"], 0)],
        ["RIQ", numero_formato(resumen_sal["riq"], 0)]
    ]
)
mostrar("")

// ─────────────────────────────────────────────────────────────────────────────
// 2. REGRESION LINEAL — Precio de casas
// ─────────────────────────────────────────────────────────────────────────────
mostrar(negrita("2. Regresion lineal: m² vs Precio"))
mostrar(texto_repetir("─", 40))

sea metros = [50, 65, 80, 95, 110, 125, 140, 160, 180, 200]
sea precios = [120000, 155000, 190000, 225000, 265000, 310000, 350000, 400000, 445000, 510000]

sea modelo = regresion_lineal(metros, precios)
sea pend = numero_formato(modelo["pendiente"], 0)
sea intcp = numero_formato(modelo["intercepto"], 0)
sea r2 = numero_formato(modelo["r2"] * 100, 1)

mostrar("  Pendiente:   $" + pend + " por m²")
mostrar("  Intercepto:  $" + intcp)
mostrar("  R²:          " + r2 + "%  " + (si (modelo["r2"] > 0.95) { verde("(excelente)") } sino { amarillo("(bueno)") }))
mostrar("")

// Predicciones
sea casos = [70, 100, 150, 220]
mostrar(negrita("  Predicciones:"))
para m en casos {
    sea pred = predecir(modelo, m)
    mostrar("  " + cian(m + " m²") + "  →  $" + numero_formato(pred, 0))
}
mostrar("")

// Visualizacion en terminal (scatter simple)
mostrar(negrita("  Grafico de dispersion (m² vs Miles $):"))
sea max_p = lista_max(precios)
sea max_m = lista_max(metros)
sea alto = 10
sea ancho = 40
sea grafico = []
para fila en rango(0, alto) {
    agregar(grafico, texto_repetir(".", ancho))
}
para i en rango(0, longitud(metros)) {
    sea cx = entero_cerca(metros[i] / max_m * (ancho - 1))
    sea cy = alto - 1 - entero_cerca(precios[i] / max_p * (alto - 1))
    si (cy >= 0 y cy < alto y cx >= 0 y cx < ancho) {
        sea fila_str = grafico[cy]
        sea nueva = subcadena(fila_str, 0, cx) + verde("●") + subcadena(fila_str, cx + 1, longitud(fila_str))
        grafico[cy] = nueva
    }
}
para fila_g en grafico {
    mostrar("  |" + fila_g)
}
mostrar("  " + texto_repetir("-", ancho + 1))
mostrar("  Metros cuadrados →")
mostrar("")

// ─────────────────────────────────────────────────────────────────────────────
// 3. CLASIFICADOR KNN — Tipo de flor (Iris simplificado)
// ─────────────────────────────────────────────────────────────────────────────
mostrar(negrita("3. KNN — Clasificacion de flores"))
mostrar(texto_repetir("─", 40))

// Dataset: [longitud_petalo, ancho_petalo] → especie
sea flores_train = [
    {"x": [1.4, 0.2], "y": "setosa"},
    {"x": [1.5, 0.2], "y": "setosa"},
    {"x": [1.3, 0.1], "y": "setosa"},
    {"x": [4.7, 1.4], "y": "versicolor"},
    {"x": [4.5, 1.5], "y": "versicolor"},
    {"x": [4.9, 1.5], "y": "versicolor"},
    {"x": [6.0, 2.5], "y": "virginica"},
    {"x": [5.9, 2.1], "y": "virginica"},
    {"x": [6.3, 1.8], "y": "virginica"}
]

// Casos a clasificar
sea nuevas_flores = [
    [1.4, 0.2],
    [4.6, 1.4],
    [5.8, 2.2],
    [3.0, 1.0]
]

sea esperados = ["setosa", "versicolor", "virginica", "?"]

mostrar("  k=3, features: [longitud_petalo, ancho_petalo]")
mostrar("")
para i en rango(0, longitud(nuevas_flores)) {
    sea flor = nuevas_flores[i]
    sea prediccion = knn_clasificar(flores_train, flor, 3)
    sea esp = esperados[i]
    sea ok = prediccion == esp
    sea icono = si (ok) { verde("✓") } sino { amarillo("~") }
    mostrar("  " + icono + " [" + flor[0] + ", " + flor[1] + "] → " + cian(prediccion))
}
mostrar("")

// ─────────────────────────────────────────────────────────────────────────────
// 4. ANALISIS DE CORRELACION
// ─────────────────────────────────────────────────────────────────────────────
mostrar(negrita("4. Analisis de correlacion"))
mostrar(texto_repetir("─", 40))

sea anios_exp = [1, 2, 3, 5, 7, 8, 10, 12, 15, 20]
sea sueldo_exp = [30000, 35000, 42000, 55000, 70000, 80000, 95000, 110000, 130000, 160000]
sea horas_trabajo = [45, 50, 42, 40, 38, 35, 38, 36, 40, 35]

sea corr_exp_sal = correlacion(anios_exp, sueldo_exp)
sea corr_hrs_sal = correlacion(horas_trabajo, sueldo_exp)

funcion interpretar_corr(r: numero): texto {
    sea abs_r = r
    si (r < 0) { abs_r = -r }
    si (abs_r > 0.9) { retornar verde("muy alta") }
    si (abs_r > 0.7) { retornar verde("alta") }
    si (abs_r > 0.5) { retornar amarillo("moderada") }
    retornar rojo("baja")
}

mostrar("  Experiencia vs Salario: r=" + numero_formato(corr_exp_sal, 3) +
        " (" + interpretar_corr(corr_exp_sal) + ")")
mostrar("  Horas trabajo vs Salario: r=" + numero_formato(corr_hrs_sal, 3) +
        " (" + interpretar_corr(corr_hrs_sal) + ")")
mostrar("")

// ─────────────────────────────────────────────────────────────────────────────
// 5. FUNCIONES MATEMATICAS
// ─────────────────────────────────────────────────────────────────────────────
mostrar(negrita("5. Funciones matematicas"))
mostrar(texto_repetir("─", 40))

mostrar("  Fibonacci(10) = " + fibonacci(10))
mostrar("  MCD(48, 18) = " + mcd(48, 18))
mostrar("  MCM(12, 18) = " + mcm(12, 18))
sea primos = primos_hasta(50)
mostrar("  Primos hasta 50: " + json_texto(primos))
mostrar("  PI = " + numero_formato(PI, 10))
mostrar("  E  = " + numero_formato(E, 10))
mostrar("")

mostrar(verde("✓ Demostracion ML completada."))
mostrar("  C-Forge es apto para ciencia de datos y ML basico sin dependencias externas.")
mostrar("")
