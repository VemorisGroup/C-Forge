// ejemplos/chat_tcp.cfv — Servidor de chat TCP en C-Forge
// Chat multi-usuario con salas, historial y comandos
//
// Compilar: g++ -std=c++20 -O2 cforgev.cpp -DCFV_WITH_OPENSSL -lpthread -o cforgev
// Correr:   ./cforgev ejemplos/chat_tcp.cfv
// Conectar: nc localhost 9000  (o telnet localhost 9000)

importar "stdlib/web.cfv"
importar "stdlib/log.cfv"

// ── Estado del chat ───────────────────────────────────────────────────────────
sea salas = {
    "general": {"nombre": "general", "mensajes": [], "usuarios": []},
    "codigo":  {"nombre": "codigo",  "mensajes": [], "usuarios": []},
    "ayuda":   {"nombre": "ayuda",   "mensajes": [], "usuarios": []}
}
sea usuarios_conectados = {}
sea historial_global = []
sea max_historial = 100

// ── Funciones de chat ─────────────────────────────────────────────────────────

funcion registrar_mensaje(sala: texto, usuario: texto, mensaje: texto): mapa {
    sea ts = fecha_ahora()
    sea msg = {
        "id":       longitud(historial_global) + 1,
        "sala":     sala,
        "usuario":  usuario,
        "mensaje":  mensaje,
        "hora":     ts["iso"]
    }
    agregar(historial_global, msg)
    si (tiene_clave(salas, sala)) {
        sea msgs = salas[sala]["mensajes"]
        agregar(msgs, msg)
        // mantener max 50 mensajes por sala
        si (longitud(msgs) > 50) {
            sea nuevos = []
            para i en rango(longitud(msgs) - 50, longitud(msgs)) {
                agregar(nuevos, msgs[i])
            }
            salas[sala]["mensajes"] = nuevos
        }
    }
    log_info("[{sala}] {usuario}: {mensaje}")
    retornar msg
}

funcion unirse_sala(usuario: texto, sala: texto): texto {
    si (!tiene_clave(salas, sala)) {
        retornar "Error: sala '{sala}' no existe"
    }
    sea lista_u = salas[sala]["usuarios"]
    sea ya_esta = falso
    para u en lista_u {
        si (u == usuario) { ya_esta = verdadero }
    }
    si (!ya_esta) {
        agregar(lista_u, usuario)
        registrar_mensaje(sala, "SISTEMA", usuario + " se ha unido")
    }
    retornar "OK"
}

funcion salir_sala(usuario: texto, sala: texto): nulo {
    si (tiene_clave(salas, sala)) {
        sea lista_u = salas[sala]["usuarios"]
        sea nuevos = []
        para u en lista_u {
            si (u != usuario) { agregar(nuevos, u) }
        }
        salas[sala]["usuarios"] = nuevos
        registrar_mensaje(sala, "SISTEMA", usuario + " ha salido")
    }
}

funcion procesar_comando(usuario: texto, sala_actual: texto, cmd: texto): mapa {
    sea partes = texto_dividir(cmd, " ")
    sea comando = partes[0]

    segun comando {
        caso "/ayuda":
            retornar {"accion": "responder", "texto":
                "Comandos disponibles:\n" +
                "  /unirse <sala>   — Unirse a una sala\n" +
                "  /salir          — Salir de la sala actual\n" +
                "  /salas          — Listar salas disponibles\n" +
                "  /usuarios       — Ver usuarios en la sala\n" +
                "  /historial [n]  — Ver ultimos N mensajes\n" +
                "  /mp <usuario> <msg> — Mensaje privado\n" +
                "  /ayuda          — Esta ayuda\n" +
                "  /salir_chat     — Desconectarse\n"
            }

        caso "/salas":
            sea lista_salas = "Salas disponibles:\n"
            para kv en mapa_entradas(salas) {
                sea s = kv[1]
                lista_salas = lista_salas + "  #" + s["nombre"] +
                    " (" + longitud(s["usuarios"]) + " usuarios, " +
                    longitud(s["mensajes"]) + " mensajes)\n"
            }
            retornar {"accion": "responder", "texto": lista_salas}

        caso "/usuarios":
            si (sala_actual == "") {
                retornar {"accion": "responder", "texto": "No estas en ninguna sala"}
            }
            sea lista_u = salas[sala_actual]["usuarios"]
            sea txt = "Usuarios en #" + sala_actual + ":\n"
            para u en lista_u {
                txt = txt + "  • " + u + "\n"
            }
            retornar {"accion": "responder", "texto": txt}

        caso "/historial":
            sea n = 10
            si (longitud(partes) > 1) {
                n = texto_a_numero(partes[1])
            }
            sea msgs = si (sala_actual != "") {
                salas[sala_actual]["mensajes"]
            } sino {
                historial_global
            }
            sea desde = longitud(msgs) - n
            si (desde < 0) { desde = 0 }
            sea txt2 = "Ultimos " + n + " mensajes:\n"
            para i en rango(desde, longitud(msgs)) {
                sea m = msgs[i]
                txt2 = txt2 + "[" + m["hora"] + "] " + m["usuario"] + ": " + m["mensaje"] + "\n"
            }
            retornar {"accion": "responder", "texto": txt2}

        caso "/unirse":
            si (longitud(partes) < 2) {
                retornar {"accion": "responder", "texto": "Uso: /unirse <sala>"}
            }
            sea nueva_sala = partes[1]
            si (sala_actual != "") {
                salir_sala(usuario, sala_actual)
            }
            sea res = unirse_sala(usuario, nueva_sala)
            si (res == "OK") {
                retornar {"accion": "cambiar_sala", "sala": nueva_sala,
                    "texto": "Te has unido a #" + nueva_sala}
            }
            retornar {"accion": "responder", "texto": res}

        caso "/salir_chat":
            retornar {"accion": "desconectar"}

        caso "/mp":
            si (longitud(partes) < 3) {
                retornar {"accion": "responder", "texto": "Uso: /mp <usuario> <mensaje>"}
            }
            sea dest = partes[1]
            sea msg_mp = subcadena(cmd, longitud("/mp " + dest + " "), longitud(cmd))
            log_info("MP {usuario} → {dest}: {msg_mp}")
            retornar {"accion": "mp", "destino": dest,
                "texto": "[MP de " + usuario + "]: " + msg_mp}
    }

    retornar {"accion": "responder", "texto": "Comando desconocido: " + comando}
}

// ── API HTTP para el chat ──────────────────────────────────────────────────────
// (Esta demo usa HTTP ya que C-Forge tiene servidor HTTP nativo)

log_configurar({"nivel": "info", "color": verdadero, "timestamp": verdadero})
log_info("Chat C-Forge iniciando en puerto 9000...")

sea srv = web_escuchar(9000)
mostrar("Chat C-Forge en http://localhost:9000")
mostrar("Endpoints:")
mostrar("  GET  /salas              — listar salas")
mostrar("  GET  /sala/<nombre>      — mensajes de una sala")
mostrar("  POST /sala/<nombre>      — enviar mensaje")
mostrar("  POST /unirse             — unirse a sala")
mostrar("  GET  /usuarios           — usuarios conectados")
mostrar("  POST /login              — registrar usuario")
mostrar("")

// Seed messages
registrar_mensaje("general", "SISTEMA", "Servidor C-Forge Chat iniciado")
registrar_mensaje("codigo", "SISTEMA", "Sala de codigo y programacion")

mientras (verdadero) {
    sea req = web_solicitud(srv)
    sea metodo = req["metodo"]
    sea ruta = req["ruta"]
    sea cuerpo = req["cuerpo"]

    // GET /salas
    si (metodo == "GET" y ruta == "/salas") {
        sea lista_s = []
        para kv en mapa_entradas(salas) {
            sea s = kv[1]
            agregar(lista_s, {
                "nombre": s["nombre"],
                "usuarios": longitud(s["usuarios"]),
                "mensajes": longitud(s["mensajes"])
            })
        }
        web_responder(srv, 200, json_texto({"salas": lista_s}), "application/json")

    // GET /sala/:nombre
    } sino si (metodo == "GET" y texto_empieza_con(ruta, "/sala/")) {
        sea nombre_sala = subcadena(ruta, 6, longitud(ruta))
        si (!tiene_clave(salas, nombre_sala)) {
            web_responder(srv, 404, json_texto({"error": "Sala no encontrada"}), "application/json")
        } sino {
            sea s = salas[nombre_sala]
            web_responder(srv, 200, json_texto({
                "sala": nombre_sala,
                "usuarios": s["usuarios"],
                "mensajes": s["mensajes"]
            }), "application/json")
        }

    // POST /sala/:nombre — enviar mensaje
    } sino si (metodo == "POST" y texto_empieza_con(ruta, "/sala/")) {
        intentar {
            sea nombre_sala = subcadena(ruta, 6, longitud(ruta))
            sea datos = json_parsear(cuerpo)
            sea usuario = datos["usuario"]
            sea mensaje = datos["mensaje"]
            si (!tiene_clave(salas, nombre_sala)) {
                web_responder(srv, 404, json_texto({"error": "Sala no encontrada"}), "application/json")
            } sino {
                sea msg = registrar_mensaje(nombre_sala, usuario, mensaje)
                web_responder(srv, 200, json_texto({"ok": verdadero, "id": msg["id"]}), "application/json")
            }
        } capturar (e) {
            web_responder(srv, 400, json_texto({"error": e}), "application/json")
        }

    // POST /unirse
    } sino si (metodo == "POST" y ruta == "/unirse") {
        intentar {
            sea datos = json_parsear(cuerpo)
            sea res = unirse_sala(datos["usuario"], datos["sala"])
            web_responder(srv, 200, json_texto({"ok": res == "OK", "mensaje": res}), "application/json")
        } capturar (e) {
            web_responder(srv, 400, json_texto({"error": e}), "application/json")
        }

    // GET /usuarios
    } sino si (metodo == "GET" y ruta == "/usuarios") {
        sea total = 0
        para kv en mapa_entradas(salas) {
            total = total + longitud(kv[1]["usuarios"])
        }
        web_responder(srv, 200, json_texto({"conectados": total}), "application/json")

    // GET /
    } sino si (ruta == "/" o ruta == "") {
        web_responder(srv, 200,
            "<h1>Chat C-Forge</h1><p>Ver <a href='/salas'>/salas</a></p>",
            "text/html")

    } sino {
        web_responder(srv, 404, json_texto({"error": "Ruta no encontrada"}), "application/json")
    }
}
