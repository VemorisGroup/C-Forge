interfaz Sumable {
    metodo sumar(x: numero): numero
}

clase Contador implementa Sumable {
    campo valor: numero

    metodo sumar(x: numero): numero {
        retornar este.valor + x
    }
}

funcion identidad<T>(valor: T): T {
    retornar valor
}

sea contador: Contador = Contador(40)
sea resultado: numero = contador.sumar(identidad(2))

mostrar("C-Forge formal")
mostrar(resultado)
