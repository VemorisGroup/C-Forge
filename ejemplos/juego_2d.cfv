// ejemplos/juego_2d.cfv — Juego 2D completo en C-Forge con SDL2
// Snake/serpiente con colisiones, puntaje y reinicio
//
// Compilar: g++ -std=c++20 -O2 cforgev.cpp -DCFV_WITH_SDL2 -lSDL2 -lpthread -o cforgev
// Correr:   ./cforgev ejemplos/juego_2d.cfv

importar "stdlib/sdl.cfv"

// Configuracion
sea ANCHO = 640
sea ALTO = 480
sea TAM_CELDA = 20
sea CELDAS_X = ANCHO / TAM_CELDA
sea CELDAS_Y = ALTO / TAM_CELDA
sea FPS = 10

// Estado del juego
sea ventana = juego_iniciar("Snake - C-Forge", ANCHO, ALTO)
sea corriendo = verdadero
sea puntos = 0
sea record = 0

// Serpiente: lista de {x, y}
sea serpiente = [
    {"x": 10, "y": 12},
    {"x":  9, "y": 12},
    {"x":  8, "y": 12}
]
sea dir_x = 1
sea dir_y = 0
sea nueva_dir_x = 1
sea nueva_dir_y = 0

// Comida
sea comida_x = 20
sea comida_y = 12

funcion nueva_comida(): nulo {
    comida_x = (aleatorio() * (CELDAS_X - 2) + 1)
    comida_y = (aleatorio() * (CELDAS_Y - 2) + 1)
    comida_x = entero(comida_x)
    comida_y = entero(comida_y)
}

funcion entero(n: numero): numero {
    retornar n - (n % 1)
}

funcion reiniciar(): nulo {
    serpiente = [
        {"x": 10, "y": 12},
        {"x":  9, "y": 12},
        {"x":  8, "y": 12}
    ]
    dir_x = 1
    dir_y = 0
    nueva_dir_x = 1
    nueva_dir_y = 0
    puntos = 0
    nueva_comida()
}

// Dibujar cuadrado
funcion dibujar_celda(x: numero, y: numero, r: numero, g: numero, b: numero): nulo {
    sdl_dibujar_rect(ventana, x * TAM_CELDA, y * TAM_CELDA, TAM_CELDA - 1, TAM_CELDA - 1, r, g, b, 255)
}

// Bucle principal
mientras (juego_corriendo(ventana) y corriendo) {
    // Eventos
    sea eventos = juego_eventos(ventana)
    para ev en eventos {
        sea tipo = ev["tipo"]
        si (tipo == "quit") {
            corriendo = falso
        }
        si (tipo == "keydown") {
            sea tecla = ev["tecla"]
            segun tecla {
                caso "UP":    si (dir_y != 1)  { nueva_dir_x = 0  nueva_dir_y = -1 }
                caso "DOWN":  si (dir_y != -1) { nueva_dir_x = 0  nueva_dir_y = 1 }
                caso "LEFT":  si (dir_x != 1)  { nueva_dir_x = -1 nueva_dir_y = 0 }
                caso "RIGHT": si (dir_x != -1) { nueva_dir_x = 1  nueva_dir_y = 0 }
                caso "r":     reiniciar()
                caso "ESCAPE":corriendo = falso
            }
        }
    }

    // Actualizar direccion
    dir_x = nueva_dir_x
    dir_y = nueva_dir_y

    // Mover serpiente
    sea cabeza = serpiente[0]
    sea nueva_cabeza = {"x": cabeza["x"] + dir_x, "y": cabeza["y"] + dir_y}
    sea nx = nueva_cabeza["x"]
    sea ny = nueva_cabeza["y"]

    // Colision con paredes
    si (nx < 0 o nx >= CELDAS_X o ny < 0 o ny >= CELDAS_Y) {
        si (puntos > record) { record = puntos }
        mostrar("Game Over! Puntos: {puntos} Record: {record}")
        reiniciar()
        sdl_delay(1000)
    } sino {
        // Colision con cuerpo
        sea colision = falso
        para segmento en serpiente {
            si (segmento["x"] == nx y segmento["y"] == ny) {
                colision = verdadero
            }
        }

        si (colision) {
            si (puntos > record) { record = puntos }
            mostrar("Game Over! Puntos: {puntos} Record: {record}")
            reiniciar()
            sdl_delay(1000)
        } sino {
            // Agregar nueva cabeza
            sea nueva_serpiente = [nueva_cabeza] + serpiente

            // Comio la comida?
            si (nx == comida_x y ny == comida_y) {
                puntos = puntos + 10
                serpiente = nueva_serpiente
                nueva_comida()
            } sino {
                // Quitar la cola
                sea tam = longitud(nueva_serpiente)
                serpiente = []
                para i en rango(0, tam - 1) {
                    serpiente = serpiente + [nueva_serpiente[i]]
                }
            }
        }
    }

    // Dibujar
    juego_limpiar(ventana, 15, 15, 15)

    // Grid de fondo (sutil)
    para gx en rango(0, CELDAS_X) {
        para gy en rango(0, CELDAS_Y) {
            sdl_dibujar_rect(ventana, gx * TAM_CELDA, gy * TAM_CELDA, TAM_CELDA - 1, TAM_CELDA - 1, 20, 20, 20, 255)
        }
    }

    // Comida (rojo brillante)
    sdl_dibujar_rect(ventana, comida_x * TAM_CELDA, comida_y * TAM_CELDA, TAM_CELDA - 1, TAM_CELDA - 1, 255, 60, 60, 255)

    // Serpiente
    sea i = 0
    para seg en serpiente {
        sea sx = seg["x"]
        sea sy = seg["y"]
        si (i == 0) {
            // Cabeza: verde brillante
            sdl_dibujar_rect(ventana, sx * TAM_CELDA, sy * TAM_CELDA, TAM_CELDA - 1, TAM_CELDA - 1, 100, 255, 100, 255)
        } sino {
            // Cuerpo: verde oscuro
            sea verde = 200 - (i * 5)
            si (verde < 80) { verde = 80 }
            sdl_dibujar_rect(ventana, sx * TAM_CELDA, sy * TAM_CELDA, TAM_CELDA - 1, TAM_CELDA - 1, 30, verde, 50, 255)
        }
        i = i + 1
    }

    juego_mostrar(ventana)
    sdl_delay(1000 / FPS)
}

juego_terminar(ventana)
mostrar("Juego terminado. Puntos finales: {puntos}")
