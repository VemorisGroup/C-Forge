// stdlib/enum.cfv — Enumeraciones para C-Forge
// Define tipos de enumeración con valores, métodos y pattern matching

// ── Crear un enum ──────────────────────────────────────────────────────────────
funcion enum_crear(nombre: texto, valores: lista): mapa {
    /// Crea un enum con los valores dados.
    /// @ejemplo
    ///   sea Color = enum_crear("Color", ["Rojo", "Verde", "Azul"])
    ///   sea c = Color["Rojo"]          // → 0
    ///   mostrar(enum_nombre(Color, c)) // → "Rojo"
    sea e = {
        "_nombre": nombre,
        "_valores": valores,
        "_por_indice": {},
        "_por_nombre": {}
    }
    para i en rango(longitud(valores)) {
        sea v = valores[i]
        e[v] = i
        e["_por_indice"][i + ""] = v
        e["_por_nombre"][v] = i
    }
    retornar e
}

// Crear enum con valores personalizados (no solo índices)
funcion enum_crear_con_valores(nombre: texto, pares: mapa): mapa {
    /// Crea un enum con valores personalizados.
    /// @ejemplo
    ///   sea Estado = enum_crear_con_valores("Estado", {
    ///     "Activo": "active", "Inactivo": "inactive", "Pendiente": "pending"
    ///   })
    sea e = {
        "_nombre": nombre,
        "_valores": mapa_claves(pares),
        "_por_valor": {},
        "_por_nombre": pares
    }
    para kv en mapa_entradas(pares) {
        e[kv[0]] = kv[1]
        e["_por_valor"][kv[1] + ""] = kv[0]
    }
    retornar e
}

// ── Operaciones sobre enums ────────────────────────────────────────────────────
funcion enum_nombre(e: mapa, valor: cualquiera): texto {
    /// Retorna el nombre del valor enum dado su índice/valor.
    si (tiene_clave(e, "_por_indice")) {
        retornar e["_por_indice"][valor + ""] ?? "Desconocido"
    }
    si (tiene_clave(e, "_por_valor")) {
        retornar e["_por_valor"][valor + ""] ?? "Desconocido"
    }
    retornar "Desconocido"
}

funcion enum_es_valido(e: mapa, valor: cualquiera): booleano {
    /// Verifica si un valor pertenece al enum.
    si (tiene_clave(e, "_por_indice")) {
        retornar tiene_clave(e["_por_indice"], valor + "")
    }
    si (tiene_clave(e, "_por_valor")) {
        retornar tiene_clave(e["_por_valor"], valor + "")
    }
    retornar falso
}

funcion enum_valores(e: mapa): lista {
    /// Lista todos los nombres del enum.
    retornar e["_valores"]
}

funcion enum_indices(e: mapa): lista {
    /// Lista todos los valores/índices del enum.
    si (tiene_clave(e, "_por_indice")) {
        retornar mapear(e["_valores"], funcion(v) { e["_por_nombre"][v] })
    }
    retornar mapear(e["_valores"], funcion(v) { e["_por_nombre"][v] })
}

funcion enum_siguiente(e: mapa, valor: cualquiera): cualquiera {
    /// Retorna el siguiente valor del enum (circular).
    sea vals = e["_valores"]
    sea n = longitud(vals)
    sea idx = valor
    si (tipo_de(valor) == "texto") {
        idx = e["_por_nombre"][valor] ?? 0
    }
    retornar e[vals[(idx + 1) % n]]
}

funcion enum_anterior(e: mapa, valor: cualquiera): cualquiera {
    sea vals = e["_valores"]
    sea n = longitud(vals)
    sea idx = valor
    si (tipo_de(valor) == "texto") {
        idx = e["_por_nombre"][valor] ?? 0
    }
    sea prev = ((idx - 1) % n + n) % n
    retornar e[vals[prev]]
}

// ── Enums predefinidos útiles ──────────────────────────────────────────────────
sea DiaSemana = enum_crear("DiaSemana", [
    "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"
])

sea MesAño = enum_crear("MesAño", [
    "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
    "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"
])

sea CodigoHTTP = enum_crear_con_valores("CodigoHTTP", {
    "OK": 200,
    "Creado": 201,
    "SinContenido": 204,
    "MovidoPermanente": 301,
    "Encontrado": 302,
    "SinModificar": 304,
    "BadRequest": 400,
    "NoAutorizado": 401,
    "Prohibido": 403,
    "NoEncontrado": 404,
    "MetodoNoPermitido": 405,
    "Conflicto": 409,
    "UnprocessableEntity": 422,
    "DemasiadasSolicitudes": 429,
    "ErrorInterno": 500,
    "NoImplementado": 501,
    "ServicioNoDisponible": 503
})

sea Prioridad = enum_crear_con_valores("Prioridad", {
    "Critica": 0,
    "Alta": 1,
    "Media": 2,
    "Baja": 3,
    "Ninguna": 4
})

sea ColorTerminal = enum_crear_con_valores("ColorTerminal", {
    "Negro": "\033[30m",
    "Rojo": "\033[31m",
    "Verde": "\033[32m",
    "Amarillo": "\033[33m",
    "Azul": "\033[34m",
    "Magenta": "\033[35m",
    "Cian": "\033[36m",
    "Blanco": "\033[37m",
    "Reset": "\033[0m"
})

// ── Pattern matching sobre enum ────────────────────────────────────────────────
funcion enum_match(valor: cualquiera, casos: mapa, default_fn: cualquiera): cualquiera {
    /// Ejecuta la función correspondiente al valor del enum.
    /// @ejemplo
    ///   sea resultado = enum_match(mi_estado, {
    ///     "Activo":   funcion() { "todo bien" },
    ///     "Inactivo": funcion() { "está inactivo" }
    ///   }, funcion() { "desconocido" })
    para kv en mapa_entradas(casos) {
        si (kv[0] == valor + "") {
            retornar kv[1]()
        }
    }
    si (default_fn != nulo) { retornar default_fn() }
    lanzar "enum_match: valor no manejado: " + valor
}

// ── Enum con datos asociados (Result/Option pattern) ─────────────────────────
// Equivalente a Option<T>: Some(valor) o None
funcion algunos(valor: cualquiera): mapa {
    retornar {"_tipo": "algunos", "valor": valor}
}

funcion ninguno(): mapa {
    retornar {"_tipo": "ninguno"}
}

funcion es_algunos(opt: mapa): booleano {
    retornar opt["_tipo"] == "algunos"
}

funcion es_ninguno(opt: mapa): booleano {
    retornar opt["_tipo"] == "ninguno"
}

funcion opt_obtener(opt: mapa, default: cualquiera): cualquiera {
    si (es_algunos(opt)) { retornar opt["valor"] }
    retornar default
}

funcion opt_mapear(opt: mapa, fn: cualquiera): mapa {
    si (es_algunos(opt)) { retornar algunos(fn(opt["valor"])) }
    retornar ninguno()
}

funcion opt_si(opt: mapa, fn: cualquiera): nulo {
    si (es_algunos(opt)) { fn(opt["valor"]) }
}

// Result<T, E>: ok(valor) o error(mensaje)
funcion resultado_ok(valor: cualquiera): mapa {
    retornar {"_tipo": "ok", "valor": valor}
}

funcion resultado_error(mensaje: cualquiera): mapa {
    retornar {"_tipo": "error", "error": mensaje}
}

funcion es_ok(r: mapa): booleano {
    retornar r["_tipo"] == "ok"
}

funcion es_error(r: mapa): booleano {
    retornar r["_tipo"] == "error"
}

funcion resultado_obtener(r: mapa): cualquiera {
    si (!es_ok(r)) { lanzar r["error"] ?? "resultado fallido" }
    retornar r["valor"]
}

funcion resultado_obtener_o(r: mapa, default: cualquiera): cualquiera {
    si (es_ok(r)) { retornar r["valor"] }
    retornar default
}

funcion resultado_mapear(r: mapa, fn: cualquiera): mapa {
    si (es_ok(r)) { retornar resultado_ok(fn(r["valor"])) }
    retornar r
}

funcion resultado_mapear_error(r: mapa, fn: cualquiera): mapa {
    si (es_error(r)) { retornar resultado_error(fn(r["error"])) }
    retornar r
}

// Capturar excepción en un Result
funcion intentar_resultado(fn: cualquiera): mapa {
    intentar {
        retornar resultado_ok(fn())
    } capturar (e) {
        retornar resultado_error(e)
    }
}
