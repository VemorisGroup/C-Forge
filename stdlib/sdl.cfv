// stdlib/sdl.cfv — Bindings SDL2 para C-Forge v3.7.0
// API de bajo nivel sobre los builtins sdl_* del intérprete.
// Para un motor de juego de alto nivel usa stdlib/juego.cfv
//
// Ejemplo mínimo:
//   importar "stdlib/sdl.cfv"
//   sdl_init(0)
//   sea win = sdl_ventana("Hola", 800, 600, 0)
//   sea ren = sdl_renderer(win)
//   sea corriendo = verdadero
//   mientras (corriendo) {
//       para e en sdl_eventos() {
//           si (e["salir"] == verdadero) { corriendo = falso }
//       }
//       sdl_color(ren, 30, 30, 50, 255)
//       sdl_limpiar(ren)
//       sdl_color(ren, 255, 100, 0, 255)
//       sdl_rect(ren, 100, 100, 200, 200, verdadero)
//       sdl_presentar(ren)
//       sdl_esperar(16)
//   }
//   sdl_cerrar()

// ── Constantes de teclas (scancodes SDL2) ─────────────────────────────────
sea SDL_TECLA_ARRIBA    = 82
sea SDL_TECLA_ABAJO     = 81
sea SDL_TECLA_IZQUIERDA = 80
sea SDL_TECLA_DERECHA   = 79
sea SDL_TECLA_ESPACIO   = 44
sea SDL_TECLA_ENTER     = 40
sea SDL_TECLA_ESC       = 41
sea SDL_TECLA_W = 26
sea SDL_TECLA_A = 4
sea SDL_TECLA_S = 22
sea SDL_TECLA_D = 7
sea SDL_TECLA_R = 21
sea SDL_TECLA_P = 19
sea SDL_TECLA_F = 9
sea SDL_TECLA_1 = 30
sea SDL_TECLA_2 = 31
sea SDL_TECLA_3 = 32

// Tipos de eventos SDL2
sea SDL_TIPO_SALIR      = 256
sea SDL_TIPO_TECLA_DOWN = 768
sea SDL_TIPO_TECLA_UP   = 769
sea SDL_TIPO_RATON_MOV  = 1024
sea SDL_TIPO_RATON_BTN  = 1025

// Flags de ventana
sea SDL_VENTANA_NORMAL           = 4
sea SDL_VENTANA_PANTALLA_COMPLETA = 1
sea SDL_VENTANA_REDIMENSIONABLE  = 32
sea SDL_VENTANA_SIN_BORDES       = 16

// Flags de init
sea SDL_INIT_VIDEO = 32
sea SDL_INIT_AUDIO = 16
sea SDL_INIT_TODO  = 48

// ── Helpers de eventos ─────────────────────────────────────────────────────

funcion sdl_tecla_presionada(eventos: lista, scancode: numero): booleano {
    para e en eventos {
        si (e["tipo"] == SDL_TIPO_TECLA_DOWN y e["tecla"] == scancode) {
            retornar verdadero
        }
    }
    retornar falso
}

funcion sdl_tecla_soltada(eventos: lista, scancode: numero): booleano {
    para e en eventos {
        si (e["tipo"] == SDL_TIPO_TECLA_UP y e["tecla"] == scancode) {
            retornar verdadero
        }
    }
    retornar falso
}

funcion sdl_quiere_salir(eventos: lista): booleano {
    para e en eventos {
        intentar {
            si (e["salir"] == verdadero) { retornar verdadero }
        } capturar(ex) { }
        intentar {
            si (e["tipo"] == SDL_TIPO_TECLA_DOWN y e["tecla"] == SDL_TECLA_ESC) {
                retornar verdadero
            }
        } capturar(ex) { }
    }
    retornar falso
}

// ── Helpers de tiempo / FPS ────────────────────────────────────────────────

funcion sdl_fps_limitar(objetivo: numero, ultimo_tick: numero): numero {
    sea ahora = sdl_ticks()
    sea transcurrido = ahora - ultimo_tick
    sea ms_objetivo = 1000 / objetivo
    si (transcurrido < ms_objetivo) {
        sdl_esperar(ms_objetivo - transcurrido)
    }
    retornar sdl_ticks()
}

funcion sdl_delta_tiempo(ultimo_tick: numero): numero {
    retornar (sdl_ticks() - ultimo_tick) / 1000.0
}

// ── Helpers de dibujo ─────────────────────────────────────────────────────

// Dibuja un círculo aproximado con rectángulos de 2x2
funcion sdl_circulo(ren: numero, cx: numero, cy: numero, radio: numero): nulo {
    sea rx = radio
    sea ry = 0
    sea err = 0
    mientras (rx >= ry) {
        sdl_rect(ren, cx + rx - 1, cy + ry - 1, 2, 2, verdadero)
        sdl_rect(ren, cx + ry - 1, cy + rx - 1, 2, 2, verdadero)
        sdl_rect(ren, cx - ry - 1, cy + rx - 1, 2, 2, verdadero)
        sdl_rect(ren, cx - rx - 1, cy + ry - 1, 2, 2, verdadero)
        sdl_rect(ren, cx - rx - 1, cy - ry - 1, 2, 2, verdadero)
        sdl_rect(ren, cx - ry - 1, cy - rx - 1, 2, 2, verdadero)
        sdl_rect(ren, cx + ry - 1, cy - rx - 1, 2, 2, verdadero)
        sdl_rect(ren, cx + rx - 1, cy - ry - 1, 2, 2, verdadero)
        ry = ry + 1
        si (err <= 0) {
            err = err + 2 * ry + 1
        }
        si (err > 0) {
            rx = rx - 1
            err = err - 2 * rx + 1
        }
    }
}

// Dibuja una barra de progreso (HP, mana, carga, etc.)
funcion sdl_barra(ren: numero, x: numero, y: numero, ancho: numero, alto: numero,
                  valor: numero, maximo: numero,
                  r_fondo: numero, g_fondo: numero, b_fondo: numero,
                  r_lleno: numero, g_lleno: numero, b_lleno: numero): nulo {
    sdl_color(ren, r_fondo, g_fondo, b_fondo, 255)
    sdl_rect(ren, x, y, ancho, alto, verdadero)
    sea pct = valor / maximo
    si (pct > 1) { pct = 1 }
    si (pct < 0) { pct = 0 }
    sdl_color(ren, r_lleno, g_lleno, b_lleno, 255)
    sdl_rect(ren, x, y, pct * ancho, alto, verdadero)
}

// ── Utilidades matemáticas ────────────────────────────────────────────────

funcion acotar(valor: numero, minimo: numero, maximo: numero): numero {
    si (valor < minimo) { retornar minimo }
    si (valor > maximo) { retornar maximo }
    retornar valor
}

funcion distancia(x1: numero, y1: numero, x2: numero, y2: numero): numero {
    sea dx = x2 - x1
    sea dy = y2 - y1
    retornar raiz(dx * dx + dy * dy)
}

funcion lerp(a: numero, b: numero, t: numero): numero {
    retornar a + (b - a) * t
}

funcion signo(n: numero): numero {
    si (n > 0) { retornar 1 }
    si (n < 0) { retornar -1 }
    retornar 0
}
