// stdlib/validar.cfv — Validacion de datos para C-Forge
// Para bancos, APIs, formularios, etc.
// Uso: importar "stdlib/validar.cfv"

// ── Validadores basicos ───────────────────────────────────────────────────────

funcion es_texto(v: cualquiera): booleano {
    retornar tipo_de(v) == "texto"
}

funcion es_numero(v: cualquiera): booleano {
    retornar tipo_de(v) == "numero"
}

funcion es_booleano(v: cualquiera): booleano {
    retornar tipo_de(v) == "booleano"
}

funcion es_lista(v: cualquiera): booleano {
    retornar tipo_de(v) == "lista"
}

funcion es_mapa(v: cualquiera): booleano {
    retornar tipo_de(v) == "mapa"
}

funcion es_nulo(v: cualquiera): booleano {
    retornar v == nulo
}

funcion es_vacio(v: cualquiera): booleano {
    si (v == nulo) { retornar verdadero }
    si (tipo_de(v) == "texto") { retornar longitud(v) == 0 }
    si (tipo_de(v) == "lista") { retornar longitud(v) == 0 }
    retornar falso
}

// ── Validadores de texto ──────────────────────────────────────────────────────

funcion es_email(v: texto): booleano {
    si (!es_texto(v)) { retornar falso }
    retornar regex_coincidir(v, "[a-zA-Z0-9._%+\\-]+@[a-zA-Z0-9.\\-]+\\.[a-zA-Z][a-zA-Z]+")
}

funcion es_url(v: texto): booleano {
    si (!es_texto(v)) { retornar falso }
    retornar regex_coincidir(v, "https?://[a-zA-Z0-9.\\-/_%+=&?#@:]+")
}

funcion es_telefono(v: texto): booleano {
    si (!es_texto(v)) { retornar falso }
    retornar regex_coincidir(v, "^[+]?[0-9][0-9\\s\\-()]{6,20}$")
}

funcion es_solo_numeros(v: texto): booleano {
    si (!es_texto(v)) { retornar falso }
    retornar regex_coincidir(v, "^[0-9]+$")
}

funcion es_alfanumerico(v: texto): booleano {
    si (!es_texto(v)) { retornar falso }
    retornar regex_coincidir(v, "^[a-zA-Z0-9]+$")
}

funcion min_longitud(v: texto, min: numero): booleano {
    retornar longitud(v) >= min
}

funcion max_longitud(v: texto, max: numero): booleano {
    retornar longitud(v) <= max
}

funcion longitud_entre(v: texto, min: numero, max: numero): booleano {
    sea n = longitud(v)
    retornar n >= min y n <= max
}

// ── Validadores numericos ─────────────────────────────────────────────────────

funcion en_rango(v: numero, min: numero, max: numero): booleano {
    retornar v >= min y v <= max
}

funcion es_positivo(v: numero): booleano {
    retornar v > 0
}

funcion es_entero(v: numero): booleano {
    retornar v == redondear(v)
}

// ── Validacion de esquemas (como Joi/Zod) ─────────────────────────────────────

// Validar un mapa contra un esquema
// esquema = {"campo": {"requerido": verdadero, "tipo": "texto", "min": 3}}
funcion validar_esquema(datos: mapa, esquema: mapa): mapa {
    sea errores = []
    sea claves_esquema = mapa_claves(esquema)

    para campo en claves_esquema {
        sea reglas = esquema[campo]
        sea valor = nulo
        sea tiene = tiene_clave(datos, campo)

        si (tiene) {
            valor = datos[campo]
        }

        // Requerido
        si (tiene_clave(reglas, "requerido") y reglas["requerido"]) {
            si (!tiene o es_vacio(valor)) {
                errores = errores + ["{campo}: es requerido"]
                continuar
            }
        }

        si (!tiene) { continuar }

        // Tipo
        si (tiene_clave(reglas, "tipo")) {
            sea tipo_esp = reglas["tipo"]
            sea tipo_real = tipo_de(valor)
            si (tipo_real != tipo_esp) {
                errores = errores + ["{campo}: se esperaba {tipo_esp}, obtuvo {tipo_real}"]
                continuar
            }
        }

        // Longitud minima (texto)
        si (tiene_clave(reglas, "min") y tipo_de(valor) == "texto") {
            si (longitud(valor) < reglas["min"]) {
                errores = errores + ["{campo}: minimo {reglas["min"]} caracteres"]
            }
        }

        // Longitud maxima (texto)
        si (tiene_clave(reglas, "max") y tipo_de(valor) == "texto") {
            si (longitud(valor) > reglas["max"]) {
                errores = errores + ["{campo}: maximo {reglas["max"]} caracteres"]
            }
        }

        // Valor minimo (numero)
        si (tiene_clave(reglas, "min_valor") y tipo_de(valor) == "numero") {
            si (valor < reglas["min_valor"]) {
                errores = errores + ["{campo}: debe ser >= {reglas["min_valor"]}"]
            }
        }

        // Valor maximo (numero)
        si (tiene_clave(reglas, "max_valor") y tipo_de(valor) == "numero") {
            si (valor > reglas["max_valor"]) {
                errores = errores + ["{campo}: debe ser <= {reglas["max_valor"]}"]
            }
        }

        // Email
        si (tiene_clave(reglas, "email") y reglas["email"]) {
            si (!es_email(valor)) {
                errores = errores + ["{campo}: email invalido"]
            }
        }

        // Patron regex
        si (tiene_clave(reglas, "patron")) {
            si (!regex_coincidir(valor, reglas["patron"])) {
                errores = errores + ["{campo}: formato invalido"]
            }
        }
    }

    retornar {
        "valido": longitud(errores) == 0,
        "errores": errores
    }
}

// Usar en API:
// sea resultado = validar_esquema(datos_usuario, {
//     "nombre": {"requerido": verdadero, "tipo": "texto", "min": 2, "max": 50},
//     "email":  {"requerido": verdadero, "tipo": "texto", "email": verdadero},
//     "edad":   {"requerido": falso, "tipo": "numero", "min_valor": 0, "max_valor": 150}
// })
// si (!resultado["valido"]) {
//     lanzar resultado["errores"][0]
// }
