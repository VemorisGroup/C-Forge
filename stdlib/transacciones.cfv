// stdlib/transacciones.cfv — Gestión de transacciones ACID
// C-Forge Standard Library v3.0

importar "fecha"
importar "auditoria"

// ── Transacciones en memoria (para lógica de negocio) ─────────────────────────

sea _txn_activas = {}
sea _txn_id_counter = 0

/// @doc Iniciar transacción
funcion txn_iniciar(nombre, aislamiento) {
    sea id = "txn_" + a_texto(_txn_id_counter) + "_" + a_texto(tiempo_ms())
    _txn_id_counter = _txn_id_counter + 1
    _txn_activas[id] = {
        "id": id,
        "nombre": nombre ?? "txn",
        "estado": "activa",
        "operaciones": [],
        "compensaciones": [],
        "inicio": tiempo_ms(),
        "aislamiento": aislamiento ?? "read_committed"
    }
    retornar id
}

/// @doc Registrar operación en transacción (con compensación)
funcion txn_operacion(txn_id, nombre, ejecutar_fn, compensar_fn) {
    si (no tiene_clave(_txn_activas, txn_id)) { lanzar "Transacción no activa: " + txn_id }
    sea txn = _txn_activas[txn_id]
    si (txn["estado"] != "activa") { lanzar "Transacción en estado inválido: " + txn["estado"] }
    intentar {
        sea resultado = ejecutar_fn()
        agregar(_txn_activas[txn_id]["operaciones"], {
            "nombre": nombre,
            "resultado": resultado,
            "timestamp": tiempo_ms()
        })
        agregar(_txn_activas[txn_id]["compensaciones"], compensar_fn)
        retornar resultado
    } capturar(e) {
        txn_revertir(txn_id)
        lanzar "Transacción abortada en '" + nombre + "': " + e
    }
}

/// @doc Confirmar transacción
funcion txn_confirmar(txn_id, usuario_id) {
    si (no tiene_clave(_txn_activas, txn_id)) { lanzar "Transacción no activa: " + txn_id }
    _txn_activas[txn_id]["estado"] = "confirmada"
    _txn_activas[txn_id]["fin"] = tiempo_ms()
    sea duracion = _txn_activas[txn_id]["fin"] - _txn_activas[txn_id]["inicio"]
    audit_log("txn_confirmada", usuario_id, "transaccion", {
        "txn_id": txn_id,
        "duracion_ms": duracion,
        "operaciones": longitud(_txn_activas[txn_id]["operaciones"])
    })
    sea resultado = _txn_activas[txn_id]
    eliminar_clave(_txn_activas, txn_id)
    retornar resultado
}

/// @doc Revertir transacción (compensación)
funcion txn_revertir(txn_id) {
    si (no tiene_clave(_txn_activas, txn_id)) { retornar falso }
    sea txn = _txn_activas[txn_id]
    _txn_activas[txn_id]["estado"] = "revertida"
    // Ejecutar compensaciones en orden inverso
    sea comps = txn["compensaciones"]
    sea i = longitud(comps) - 1
    mientras (i >= 0) {
        intentar { comps[i]() } capturar(e) { /* log pero continuar */ }
        i = i - 1
    }
    eliminar_clave(_txn_activas, txn_id)
    retornar verdadero
}

/// @doc Ejecutar función dentro de transacción automática
funcion con_transaccion(nombre, fn, usuario_id) {
    sea txn_id = txn_iniciar(nombre)
    intentar {
        sea resultado = fn(txn_id)
        txn_confirmar(txn_id, usuario_id ?? "sistema")
        retornar resultado
    } capturar(e) {
        txn_revertir(txn_id)
        lanzar e
    }
}

// ── Saga pattern (transacciones distribuidas) ──────────────────────────────────

/// @doc Crear saga distribuida (secuencia de pasos con compensación)
funcion saga_crear(nombre) {
    retornar {
        "nombre": nombre,
        "pasos": [],
        "ejecutado": []
    }
}

/// @doc Agregar paso a saga
funcion saga_paso(saga, nombre, ejecutar, compensar) {
    agregar(saga["pasos"], {
        "nombre": nombre,
        "ejecutar": ejecutar,
        "compensar": compensar
    })
    retornar saga
}

/// @doc Ejecutar saga
funcion saga_ejecutar(saga) {
    sea ejecutados = []
    para paso en saga["pasos"] {
        intentar {
            sea resultado = paso["ejecutar"]()
            agregar(ejecutados, {"paso": paso, "resultado": resultado})
        } capturar(e) {
            // Compensar en orden inverso
            sea i = longitud(ejecutados) - 1
            mientras (i >= 0) {
                intentar { ejecutados[i]["paso"]["compensar"](ejecutados[i]["resultado"]) } capturar(ce) {}
                i = i - 1
            }
            lanzar "Saga '" + saga["nombre"] + "' falló en paso '" + paso["nombre"] + "': " + e
        }
    }
    retornar mapear(ejecutados, funcion(e) { retornar e["resultado"] })
}

// ── Transferencias bancarias ───────────────────────────────────────────────────

/// @doc Modelo de cuenta bancaria
funcion cuenta_crear(id, titular, saldo_inicial, moneda) {
    retornar {
        "id": id,
        "titular": titular,
        "saldo": saldo_inicial ?? 0,
        "moneda": moneda ?? "USD",
        "movimientos": [],
        "activa": verdadero,
        "creada": tiempo_ms()
    }
}

/// @doc Transferencia atómica entre cuentas
funcion transferencia_ejecutar(cuentas, desde_id, hasta_id, monto, concepto, usuario_id) {
    si (monto <= 0) { lanzar "El monto debe ser positivo" }
    si (no tiene_clave(cuentas, desde_id)) { lanzar "Cuenta origen no existe" }
    si (no tiene_clave(cuentas, hasta_id)) { lanzar "Cuenta destino no existe" }
    sea cuenta_origen = cuentas[desde_id]
    sea cuenta_destino = cuentas[hasta_id]
    si (no cuenta_origen["activa"]) { lanzar "Cuenta origen inactiva" }
    si (no cuenta_destino["activa"]) { lanzar "Cuenta destino inactiva" }
    si (cuenta_origen["saldo"] < monto) { lanzar "Saldo insuficiente" }
    sea referencia = "TRF-" + a_texto(tiempo_ms()) + "-" + a_texto(piso(aleatorio() * 10000))
    // Ejecutar con saga para garantizar consistencia
    sea saga = saga_crear("transferencia")
    // Paso 1: Debitar origen
    saga_paso(saga, "debitar_origen",
        funcion() {
            cuentas[desde_id]["saldo"] = cuenta_origen["saldo"] - monto
            agregar(cuentas[desde_id]["movimientos"], {
                "tipo": "debito", "monto": monto, "referencia": referencia,
                "concepto": concepto, "timestamp": tiempo_ms()
            })
            retornar cuenta_origen["saldo"] - monto
        },
        funcion(saldo_anterior) {
            cuentas[desde_id]["saldo"] = saldo_anterior + monto
        }
    )
    // Paso 2: Acreditar destino
    saga_paso(saga, "acreditar_destino",
        funcion() {
            cuentas[hasta_id]["saldo"] = cuenta_destino["saldo"] + monto
            agregar(cuentas[hasta_id]["movimientos"], {
                "tipo": "credito", "monto": monto, "referencia": referencia,
                "concepto": concepto, "timestamp": tiempo_ms()
            })
            retornar cuenta_destino["saldo"] + monto
        },
        funcion(saldo_anterior) {
            cuentas[hasta_id]["saldo"] = saldo_anterior - monto
        }
    )
    saga_ejecutar(saga)
    audit_transaccion(usuario_id, "transferencia", monto, cuenta_origen["moneda"], desde_id, hasta_id, referencia)
    retornar {
        "referencia": referencia,
        "estado": "confirmada",
        "desde": desde_id,
        "hasta": hasta_id,
        "monto": monto,
        "timestamp": tiempo_ms()
    }
}
