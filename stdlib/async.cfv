// stdlib/async.cfv — Programación asíncrona para C-Forge
// Patrón async/await de alto nivel sobre hilos y canales

// ── Tarea asíncrona (equivalente a Promise/Future) ─────────────────────────
funcion tarea_crear(fn: cualquiera): mapa {
    /// Crea y lanza una tarea asíncrona. La función fn se ejecuta en un hilo.
    /// @ejemplo
    ///   sea t = tarea_crear(funcion() { http_get("https://api.ejemplo.com") })
    ///   sea resultado = tarea_esperar(t)
    sea canal_res = canal_crear(1)
    sea canal_err = canal_crear(1)
    sea estado_m = mutex_crear()
    sea estado = "ejecutando"

    hilo_crear(funcion() {
        intentar {
            sea r = fn()
            mutex_bloquear(estado_m)
            estado = "completada"
            mutex_desbloquear(estado_m)
            canal_enviar(canal_res, r)
        } capturar (e) {
            mutex_bloquear(estado_m)
            estado = "fallida"
            mutex_desbloquear(estado_m)
            canal_enviar(canal_err, e)
        }
    }, [])

    retornar {
        "_res":   canal_res,
        "_err":   canal_err,
        "_mutex": estado_m,
        "_estado": estado
    }
}

// Esperar resultado de tarea (bloquea hasta completar)
funcion tarea_esperar(t: mapa): cualquiera {
    /// Bloquea hasta que la tarea termine y retorna su resultado.
    /// Lanza excepción si la tarea falló.
    sea r = canal_recibir(t["_res"])
    si (r == nulo) {
        sea err = canal_recibir(t["_err"])
        lanzar err ?? "Tarea falló sin razón"
    }
    retornar r
}

// Estado de la tarea (no bloquea)
funcion tarea_estado(t: mapa): texto {
    retornar t["_estado"]
}

// Esperar múltiples tareas (equivalente a Promise.all)
funcion esperar_todo(tareas: lista): lista {
    /// Espera a que todas las tareas completen. Lanza si alguna falla.
    sea resultados = lista_repetir(nulo, longitud(tareas))
    para i en rango(longitud(tareas)) {
        resultados[i] = tarea_esperar(tareas[i])
    }
    retornar resultados
}

// La primera tarea que complete (Promise.race)
funcion esperar_primero(tareas: lista): cualquiera {
    /// Retorna el resultado de la primera tarea que complete.
    sea canal_ganador = canal_crear(1)

    para t en tareas {
        sea tarea_local = t
        hilo_crear(funcion() {
            intentar {
                sea r = tarea_esperar(tarea_local)
                canal_enviar(canal_ganador, r)
            } capturar (e) { }
        }, [])
    }

    retornar canal_recibir(canal_ganador)
}

// Esperar con timeout
funcion esperar_con_timeout(t: mapa, ms: numero): mapa {
    /// Espera la tarea o retorna {ok: falso, error: "timeout"} si excede ms.
    sea canal_timeout = canal_crear(1)

    hilo_crear(funcion() {
        dormir(ms)
        canal_enviar(canal_timeout, "__timeout__")
    }, [])

    sea canal_ganador = canal_crear(1)
    hilo_crear(funcion() {
        intentar {
            sea r = tarea_esperar(t)
            canal_enviar(canal_ganador, {"ok": verdadero, "valor": r})
        } capturar (e) {
            canal_enviar(canal_ganador, {"ok": falso, "error": e})
        }
    }, [])

    hilo_crear(funcion() {
        canal_recibir(canal_timeout)
        canal_enviar(canal_ganador, {"ok": falso, "error": "timeout después de " + ms + "ms"})
    }, [])

    retornar canal_recibir(canal_ganador)
}

// ── async/esperar — sintaxis azucarada ────────────────────────────────────────
// Uso: sea t = async(funcion() { /* trabajo pesado */ })
//      sea r = esperar(t)
funcion async(fn: cualquiera): mapa {
    retornar tarea_crear(fn)
}

funcion esperar(t: mapa): cualquiera {
    retornar tarea_esperar(t)
}

// ── Cola de tareas (task queue) ────────────────────────────────────────────────
funcion cola_async_crear(concurrencia: numero): mapa {
    sea max = si (concurrencia == nulo) { 4 } sino { concurrencia }
    sea cola = canal_crear(1000)
    sea activos = 0
    sea mutex = mutex_crear()
    sea completadas = 0
    sea fallidas = 0

    // Lanzar workers
    para _ en rango(max) {
        hilo_crear(funcion() {
            mientras (verdadero) {
                sea item = canal_recibir(cola)
                si (item == nulo) { romper }

                mutex_bloquear(mutex)
                activos = activos + 1
                mutex_desbloquear(mutex)

                intentar {
                    sea r = item["fn"]()
                    si (tiene_clave(item, "callback")) {
                        item["callback"](nulo, r)
                    }
                    mutex_bloquear(mutex)
                    completadas = completadas + 1
                    mutex_desbloquear(mutex)
                } capturar (e) {
                    si (tiene_clave(item, "callback")) {
                        item["callback"](e, nulo)
                    }
                    mutex_bloquear(mutex)
                    fallidas = fallidas + 1
                    mutex_desbloquear(mutex)
                }

                mutex_bloquear(mutex)
                activos = activos - 1
                mutex_desbloquear(mutex)
            }
        }, [])
    }

    retornar {
        "_cola": cola,
        "_mutex": mutex,
        "_max": max,
        "_activos": activos,
        "_completadas": completadas,
        "_fallidas": fallidas
    }
}

funcion cola_async_agregar(cola: mapa, fn: cualquiera, callback: cualquiera): nulo {
    canal_enviar(cola["_cola"], {"fn": fn, "callback": callback})
}

funcion cola_async_detener(cola: mapa): nulo {
    para _ en rango(cola["_max"]) {
        canal_enviar(cola["_cola"], nulo)
    }
}

funcion cola_async_stats(cola: mapa): mapa {
    retornar {
        "activos": cola["_activos"],
        "completadas": cola["_completadas"],
        "fallidas": cola["_fallidas"]
    }
}

// ── sleep asíncrono ────────────────────────────────────────────────────────────
funcion sleep_async(ms: numero): mapa {
    retornar tarea_crear(funcion() {
        dormir(ms)
        retornar ms
    })
}

// ── Reintentos automáticos ─────────────────────────────────────────────────────
funcion con_reintentos(fn: cualquiera, max_intentos: numero, delay_ms: numero): cualquiera {
    /// Reintenta fn hasta max_intentos veces con delay entre intentos.
    sea intentos = si (max_intentos == nulo) { 3 } sino { max_intentos }
    sea delay = si (delay_ms == nulo) { 1000 } sino { delay_ms }

    para i en rango(intentos) {
        intentar {
            retornar fn()
        } capturar (e) {
            si (i == intentos - 1) {
                lanzar "Fallido después de " + intentos + " intentos: " + e
            }
            mostrar("[async] Reintento " + (i + 1) + "/" + intentos + " en " + delay + "ms...")
            dormir(delay * (i + 1))  // backoff exponencial
        }
    }
}

// ── Circuit Breaker ────────────────────────────────────────────────────────────
funcion circuit_breaker_crear(umbral: numero, timeout_ms: numero): mapa {
    retornar {
        "_estado": "cerrado",    // cerrado=normal, abierto=bloqueando, semiabierto=probando
        "_fallos": 0,
        "_umbral": si (umbral == nulo) { 5 } sino { umbral },
        "_timeout": si (timeout_ms == nulo) { 30000 } sino { timeout_ms },
        "_ultimo_fallo": 0,
        "_mutex": mutex_crear()
    }
}

funcion circuit_breaker_llamar(cb: mapa, fn: cualquiera): cualquiera {
    mutex_bloquear(cb["_mutex"])
    sea estado = cb["_estado"]

    si (estado == "abierto") {
        sea ahora = tiempo_ms()
        si (ahora - cb["_ultimo_fallo"] > cb["_timeout"]) {
            cb["_estado"] = "semiabierto"
        } sino {
            mutex_desbloquear(cb["_mutex"])
            lanzar "Circuit breaker ABIERTO — servicio no disponible"
        }
    }

    mutex_desbloquear(cb["_mutex"])

    intentar {
        sea r = fn()
        mutex_bloquear(cb["_mutex"])
        si (cb["_estado"] == "semiabierto") {
            cb["_estado"] = "cerrado"
            cb["_fallos"] = 0
        }
        mutex_desbloquear(cb["_mutex"])
        retornar r
    } capturar (e) {
        mutex_bloquear(cb["_mutex"])
        cb["_fallos"] = cb["_fallos"] + 1
        cb["_ultimo_fallo"] = tiempo_ms()
        si (cb["_fallos"] >= cb["_umbral"]) {
            cb["_estado"] = "abierto"
            mostrar("[circuit-breaker] ABIERTO después de " + cb["_fallos"] + " fallos")
        }
        mutex_desbloquear(cb["_mutex"])
        lanzar e
    }
}
