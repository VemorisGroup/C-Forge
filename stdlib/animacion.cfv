// stdlib/animacion.cfv — Sistema de animación para videojuegos
// C-Forge Standard Library v3.0

// ── Keyframes y curvas ─────────────────────────────────────────────────────────

funcion keyframe(tiempo, valor, easing) {
    retornar {"tiempo": tiempo, "valor": valor, "easing": easing ?? "lineal"}
}

/// @doc Interpolación por tipo de curva (easing)
funcion easing_aplicar(tipo, t) {
    si (tipo == "lineal") { retornar t }
    si (tipo == "ease_in") { retornar t * t }
    si (tipo == "ease_out") { retornar t * (2 - t) }
    si (tipo == "ease_in_out") {
        si (t < 0.5) { retornar 2 * t * t }
        retornar -1 + (4 - 2*t) * t
    }
    si (tipo == "bounce") {
        si (t < 1/2.75) { retornar 7.5625 * t * t }
        si (t < 2/2.75) { sea t2 = t - 1.5/2.75; retornar 7.5625*t2*t2 + 0.75 }
        si (t < 2.5/2.75) { sea t2 = t - 2.25/2.75; retornar 7.5625*t2*t2 + 0.9375 }
        sea t2 = t - 2.625/2.75
        retornar 7.5625*t2*t2 + 0.984375
    }
    si (tipo == "elastic") {
        si (t == 0 o t == 1) { retornar t }
        retornar -potencia(2, 10*(t-1)) * seno((t-1.1) * 5 * PI)
    }
    si (tipo == "cubic") { retornar t * t * t }
    si (tipo == "quart") { retornar t * t * t * t }
    si (tipo == "back") {
        sea s = 1.70158
        retornar t * t * ((s+1)*t - s)
    }
    retornar t
}

/// @doc Interpolar valor entre dos keyframes
funcion keyframe_interpolar(kf_a, kf_b, tiempo_actual) {
    sea dur = kf_b["tiempo"] - kf_a["tiempo"]
    si (dur == 0) { retornar kf_b["valor"] }
    sea t = (tiempo_actual - kf_a["tiempo"]) / dur
    t = maximo(0, minimo(1, t))
    t = easing_aplicar(kf_b["easing"] ?? "lineal", t)
    sea va = kf_a["valor"]
    sea vb = kf_b["valor"]
    // Interpolación según tipo
    si (tipo(va) == "numero") {
        retornar va + (vb - va) * t
    }
    si (tipo(va) == "mapa") {
        sea resultado = {}
        para k en mapa_claves(va) {
            si (tiene_clave(vb, k) y tipo(va[k]) == "numero") {
                resultado[k] = va[k] + (vb[k] - va[k]) * t
            } sino {
                resultado[k] = si(t < 0.5, va[k], vb[k])
            }
        }
        retornar resultado
    }
    // Texto: flip en mitad
    retornar si(t < 0.5, va, vb)
}

// ── Clips de animación ─────────────────────────────────────────────────────────

funcion clip_crear(nombre, duracion, loop) {
    retornar {
        "nombre": nombre,
        "duracion": duracion,
        "loop": loop ?? falso,
        "pistas": {},     // nombre_pista -> [keyframe]
        "eventos": []     // {tiempo, nombre, datos}
    }
}

funcion clip_agregar_pista(clip, pista_nombre, keyframes) {
    // Ordenar keyframes por tiempo
    clip["pistas"][pista_nombre] = mergesort(keyframes, funcion(a, b) { retornar a["tiempo"] - b["tiempo"] })
}

funcion clip_agregar_evento(clip, tiempo, nombre, datos) {
    agregar(clip["eventos"], {"tiempo": tiempo, "nombre": nombre, "datos": datos ?? {}})
}

/// @doc Obtener valor de pista en tiempo dado
funcion clip_valor_pista(clip, pista, tiempo) {
    si (no tiene_clave(clip["pistas"], pista)) { retornar nulo }
    sea kfs = clip["pistas"][pista]
    si (longitud(kfs) == 0) { retornar nulo }
    si (longitud(kfs) == 1) { retornar kfs[0]["valor"] }
    // Buscar keyframes anterior y siguiente
    sea kf_a = kfs[0]
    sea kf_b = kfs[longitud(kfs) - 1]
    para i en rango(0, longitud(kfs) - 1) {
        si (kfs[i]["tiempo"] <= tiempo y kfs[i+1]["tiempo"] >= tiempo) {
            kf_a = kfs[i]
            kf_b = kfs[i+1]
            romper
        }
    }
    retornar keyframe_interpolar(kf_a, kf_b, tiempo)
}

// ── Animador ───────────────────────────────────────────────────────────────────

funcion animador_crear() {
    retornar {
        "clips": {},
        "clip_actual": nulo,
        "tiempo": 0,
        "velocidad": 1.0,
        "en_pausa": falso,
        "terminado": falso,
        "transiciones": {},      // estado -> {condicion -> estado_destino}
        "estado_actual": "idle",
        "parametros": {},
        "on_evento": nulo,
        "on_fin": nulo
    }
}

funcion animador_registrar_clip(animador, clip) {
    animador["clips"][clip["nombre"]] = clip
}

funcion animador_agregar_transicion(animador, de, condicion, hacia, tiene_exit_time) {
    si (no tiene_clave(animador["transiciones"], de)) {
        animador["transiciones"][de] = []
    }
    agregar(animador["transiciones"][de], {
        "condicion": condicion,
        "hacia": hacia,
        "exit_time": tiene_exit_time ?? falso
    })
}

funcion animador_set_param(animador, nombre, valor) {
    animador["parametros"][nombre] = valor
}

funcion animador_get_param(animador, nombre) {
    retornar animador["parametros"][nombre] ?? nulo
}

funcion animador_reproducir(animador, nombre, desde) {
    si (no tiene_clave(animador["clips"], nombre)) { retornar }
    animador["clip_actual"] = nombre
    animador["tiempo"] = desde ?? 0
    animador["terminado"] = falso
    animador["en_pausa"] = falso
}

funcion animador_pausar(animador) { animador["en_pausa"] = verdadero }
funcion animador_reanudar(animador) { animador["en_pausa"] = falso }

funcion animador_actualizar(animador, delta) {
    si (animador["en_pausa"] o animador["clip_actual"] == nulo) { retornar }
    sea clip = animador["clips"][animador["clip_actual"]] ?? nulo
    si (clip == nulo) { retornar }
    sea t_anterior = animador["tiempo"]
    animador["tiempo"] = animador["tiempo"] + delta * animador["velocidad"]
    // Disparar eventos
    para evento en clip["eventos"] {
        si (evento["tiempo"] >= t_anterior y evento["tiempo"] < animador["tiempo"]) {
            si (animador["on_evento"] != nulo) {
                animador["on_evento"](evento["nombre"], evento["datos"])
            }
        }
    }
    // Fin de clip
    si (animador["tiempo"] >= clip["duracion"]) {
        si (clip["loop"]) {
            animador["tiempo"] = animador["tiempo"] - clip["duracion"]
        } sino {
            animador["tiempo"] = clip["duracion"]
            animador["terminado"] = verdadero
            si (animador["on_fin"] != nulo) { animador["on_fin"](animador["clip_actual"]) }
        }
    }
    // Evaluar transiciones
    sea estado = animador["clip_actual"]
    si (tiene_clave(animador["transiciones"], estado)) {
        para trans en animador["transiciones"][estado] {
            sea cond = trans["condicion"]
            sea ok = falso
            si (tipo(cond) == "texto") {
                ok = animador["parametros"][cond] ?? falso
                si (ok) { animador["parametros"][cond] = falso } // trigger
            }
            si (ok) {
                animador_reproducir(animador, trans["hacia"])
                romper
            }
        }
    }
}

/// @doc Obtener valor actual de una pista
funcion animador_valor(animador, pista) {
    si (animador["clip_actual"] == nulo) { retornar nulo }
    sea clip = animador["clips"][animador["clip_actual"]] ?? nulo
    si (clip == nulo) { retornar nulo }
    retornar clip_valor_pista(clip, pista, animador["tiempo"])
}

// ── Animaciones de sprites (frame por frame) ───────────────────────────────────

funcion sprite_anim_crear(nombre, frames, fps, loop) {
    retornar {
        "nombre": nombre,
        "frames": frames,       // lista de índices/nombres de frame
        "fps": fps ?? 12,
        "loop": loop ?? verdadero,
        "tiempo_por_frame": 1.0 / (fps ?? 12),
        "frame_actual": 0,
        "tiempo": 0,
        "activa": verdadero
    }
}

funcion sprite_anim_actualizar(anim, delta) {
    si (no anim["activa"]) { retornar }
    anim["tiempo"] = anim["tiempo"] + delta
    si (anim["tiempo"] >= anim["tiempo_por_frame"]) {
        anim["tiempo"] = anim["tiempo"] - anim["tiempo_por_frame"]
        anim["frame_actual"] = anim["frame_actual"] + 1
        si (anim["frame_actual"] >= longitud(anim["frames"])) {
            si (anim["loop"]) {
                anim["frame_actual"] = 0
            } sino {
                anim["frame_actual"] = longitud(anim["frames"]) - 1
                anim["activa"] = falso
            }
        }
    }
}

funcion sprite_anim_frame(anim) {
    retornar anim["frames"][anim["frame_actual"]]
}

// ── Tweening ───────────────────────────────────────────────────────────────────

sea _tweens = []

funcion tween_crear(objetivo, propiedad, valor_final, duracion, easing_tipo, on_fin) {
    sea tw = {
        "objetivo": objetivo,
        "propiedad": propiedad,
        "valor_inicio": objetivo[propiedad] ?? 0,
        "valor_fin": valor_final,
        "duracion": duracion,
        "easing": easing_tipo ?? "lineal",
        "tiempo": 0,
        "activo": verdadero,
        "on_fin": on_fin
    }
    agregar(_tweens, tw)
    retornar tw
}

funcion tween_actualizar_todos(delta) {
    sea activos = []
    para tw en _tweens {
        si (no tw["activo"]) { continuar }
        tw["tiempo"] = tw["tiempo"] + delta
        sea t = minimo(tw["tiempo"] / tw["duracion"], 1)
        sea te = easing_aplicar(tw["easing"], t)
        sea vi = tw["valor_inicio"]
        sea vf = tw["valor_fin"]
        tw["objetivo"][tw["propiedad"]] = vi + (vf - vi) * te
        si (t >= 1) {
            tw["activo"] = falso
            si (tw["on_fin"] != nulo) { tw["on_fin"]() }
        } sino {
            agregar(activos, tw)
        }
    }
    _tweens = activos
}

funcion tween_parar_todos() { _tweens = [] }
