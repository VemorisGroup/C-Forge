// stdlib/interfaz.cfv — Sistema de interfaces y traits para C-Forge
// Permite definir contratos que las clases deben cumplir

// ── Definir una interfaz ───────────────────────────────────────────────────────
funcion interfaz(nombre: texto, metodos: lista): mapa {
    /// Define una interfaz (contrato de métodos).
    /// @ejemplo
    ///   sea Serializable = interfaz("Serializable", ["serializar", "deserializar"])
    ///   sea obj = { "serializar": funcion() { ... }, "deserializar": funcion(d) { ... } }
    ///   interfaz_verificar(Serializable, obj)  // lanza si no cumple
    retornar {
        "_tipo": "interfaz",
        "_nombre": nombre,
        "_metodos": metodos,
        "_propiedades": []
    }
}

funcion interfaz_con_props(nombre: texto, metodos: lista, propiedades: lista): mapa {
    /// Interfaz con métodos Y propiedades requeridas.
    sea i = interfaz(nombre, metodos)
    i["_propiedades"] = propiedades
    retornar i
}

// ── Verificar que un objeto implementa una interfaz ───────────────────────────
funcion interfaz_verificar(iface: mapa, obj: mapa): booleano {
    /// Verifica que obj implementa la interfaz. Lanza si falta algún método.
    sea faltantes = []
    para metodo en iface["_metodos"] {
        si (!tiene_clave(obj, metodo) o tipo_de(obj[metodo]) != "funcion") {
            agregar(faltantes, metodo)
        }
    }
    para prop en iface["_propiedades"] {
        si (!tiene_clave(obj, prop)) {
            agregar(faltantes, prop + " (propiedad)")
        }
    }
    si (longitud(faltantes) > 0) {
        lanzar "'" + (obj["_nombre"] ?? "objeto") + "' no implementa '" +
               iface["_nombre"] + "': faltan [" + texto_unir(faltantes, ", ") + "]"
    }
    retornar verdadero
}

funcion interfaz_cumple(iface: mapa, obj: mapa): booleano {
    /// Verifica sin lanzar excepción.
    intentar {
        retornar interfaz_verificar(iface, obj)
    } capturar (e) {
        retornar falso
    }
}

// ── Implementar una interfaz ───────────────────────────────────────────────────
funcion implementar(obj: mapa, iface: mapa): mapa {
    /// Verifica la interfaz y retorna el objeto (fluent API).
    interfaz_verificar(iface, obj)
    si (!tiene_clave(obj, "_interfaces")) {
        obj["_interfaces"] = []
    }
    agregar(obj["_interfaces"], iface["_nombre"])
    retornar obj
}

funcion implementa(obj: mapa, iface: mapa): booleano {
    /// Verifica si un objeto ya implementa una interfaz registrada.
    si (!tiene_clave(obj, "_interfaces")) { retornar falso }
    retornar lista_contiene(obj["_interfaces"], iface["_nombre"])
}

// ── Traits (mixins de comportamiento) ─────────────────────────────────────────
funcion trait(nombre: texto, metodos: mapa): mapa {
    /// Define un trait con implementaciones por defecto.
    /// @ejemplo
    ///   sea Comparable = trait("Comparable", {
    ///     "mayor_que": funcion(self, otro) { self["valor"] > otro["valor"] },
    ///     "menor_que": funcion(self, otro) { self["valor"] < otro["valor"] }
    ///   })
    ///   sea mi_obj = { "valor": 42 }
    ///   aplicar_trait(mi_obj, Comparable)
    ///   mostrar(mi_obj["mayor_que"](mi_obj, { "valor": 10 })) // verdadero
    retornar {
        "_tipo": "trait",
        "_nombre": nombre,
        "_metodos": metodos
    }
}

funcion aplicar_trait(obj: mapa, t: mapa): mapa {
    /// Aplica un trait a un objeto (copia los métodos que no existen).
    para kv en mapa_entradas(t["_metodos"]) {
        si (!tiene_clave(obj, kv[0])) {
            obj[kv[0]] = kv[1]
        }
    }
    si (!tiene_clave(obj, "_traits")) {
        obj["_traits"] = []
    }
    agregar(obj["_traits"], t["_nombre"])
    retornar obj
}

funcion tiene_trait(obj: mapa, t: mapa): booleano {
    si (!tiene_clave(obj, "_traits")) { retornar falso }
    retornar lista_contiene(obj["_traits"], t["_nombre"])
}

// ── Interfaces predefinidas útiles ────────────────────────────────────────────

// Comparable: puede compararse con otros objetos
sea Comparable = interfaz("Comparable", ["comparar"])
// obj.comparar(otro) → -1 | 0 | 1

// Serializable: puede convertirse a/desde texto
sea Serializable = interfaz("Serializable", ["serializar"])

// Iterable: puede recorrerse con para...en
sea Iterable = interfaz_con_props("Iterable", ["siguiente", "tiene_siguiente"], ["_posicion"])

// Cloneable: puede clonarse
sea Cloneable = interfaz("Cloneable", ["clonar"])

// Disposable: tiene ciclo de vida (crear/destruir)
sea Disposable = interfaz("Disposable", ["iniciar", "cerrar"])

// Observable: emite eventos
sea Observable = interfaz("Observable", ["suscribir", "desuscribir", "notificar"])

// ── Traits predefinidos ────────────────────────────────────────────────────────

// Trait: comparable con > < == usando campo "valor"
sea TraitComparable = trait("TraitComparable", {
    "mayor_que": funcion(self, otro) {
        retornar self["valor"] > otro["valor"]
    },
    "menor_que": funcion(self, otro) {
        retornar self["valor"] < otro["valor"]
    },
    "igual_a": funcion(self, otro) {
        retornar self["valor"] == otro["valor"]
    },
    "entre": funcion(self, min, max) {
        retornar self["valor"] >= min y self["valor"] <= max
    }
})

// Trait: serializable a JSON
sea TraitJson = trait("TraitJson", {
    "a_json": funcion(self) {
        retornar json_texto(self)
    },
    "de_json": funcion(self, texto) {
        retornar json_parsear(texto)
    }
})

// Trait: cloneable
sea TraitClonable = trait("TraitClonable", {
    "clonar": funcion(self) {
        retornar json_parsear(json_texto(self))
    }
})

// Trait: validable
sea TraitValidable = trait("TraitValidable", {
    "es_valido": funcion(self) {
        retornar verdadero
    },
    "validar": funcion(self) {
        si (!self["es_valido"](self)) {
            lanzar "Objeto inválido: " + json_texto(self)
        }
        retornar self
    }
})

// ── Duck typing helpers ────────────────────────────────────────────────────────
funcion responde_a(obj: mapa, metodo: texto): booleano {
    /// Verifica si un objeto tiene un método específico (duck typing).
    retornar tiene_clave(obj, metodo) y tipo_de(obj[metodo]) == "funcion"
}

funcion asegurar_metodo(obj: mapa, metodo: texto): nulo {
    /// Lanza si el objeto no tiene el método.
    si (!responde_a(obj, metodo)) {
        lanzar "El objeto no implementa el método '" + metodo + "'"
    }
}

// ── Polimorfismo ───────────────────────────────────────────────────────────────
funcion llamar_si_existe(obj: mapa, metodo: texto, args: lista): cualquiera {
    /// Llama un método si existe, retorna nulo si no.
    si (responde_a(obj, metodo)) {
        retornar obj[metodo](obj, args ?? [])
    }
    retornar nulo
}

funcion dispatch(objetos: lista, metodo: texto, args: lista): lista {
    /// Llama el mismo método en todos los objetos (polimorfismo).
    sea resultados = []
    para obj en objetos {
        si (responde_a(obj, metodo)) {
            agregar(resultados, obj[metodo](obj))
        }
    }
    retornar resultados
}
