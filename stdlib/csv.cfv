// stdlib/csv.cfv — Parser y generador CSV para C-Forge
// RFC 4180 compliant: maneja comillas, comas en campos, saltos de línea

// ── Parser CSV ────────────────────────────────────────────────────────────────
funcion csv_parsear(texto_csv: texto, opciones: mapa): lista {
    sea sep = si (tiene_clave(opciones, "separador")) { opciones["separador"] } sino { "," }
    sea comilla = si (tiene_clave(opciones, "comilla")) { opciones["comilla"] } sino { "\"" }
    sea tiene_header = si (tiene_clave(opciones, "header")) { opciones["header"] } sino { verdadero }
    sea trim = si (tiene_clave(opciones, "trim")) { opciones["trim"] } sino { verdadero }

    sea filas_raw = csv_parsear_filas(texto_csv, sep, comilla)

    si (longitud(filas_raw) == 0) { retornar [] }

    si (!tiene_header) {
        retornar filas_raw
    }

    // Primera fila como encabezados
    sea headers = filas_raw[0]
    sea resultado = []

    para i en rango(1, longitud(filas_raw)) {
        sea fila = filas_raw[i]
        sea obj = {}
        para j en rango(longitud(headers)) {
            sea clave = si (trim) { texto_recortar_csv(headers[j]) } sino { headers[j] }
            sea valor = si (j < longitud(fila)) { fila[j] } sino { "" }
            si (trim) { valor = texto_recortar_csv(valor) }
            obj[clave] = csv_inferir_tipo(valor)
        }
        agregar(resultado, obj)
    }
    retornar resultado
}

// Parsear filas sin interpretación de headers
funcion csv_parsear_filas(texto: texto, sep: texto, comilla: texto): lista {
    sea filas = []
    sea fila_actual = []
    sea campo = ""
    sea en_comillas = falso
    sea i = 0
    sea len = longitud(texto)

    mientras (i < len) {
        sea ch = subcadena(texto, i, i + 1)

        si (en_comillas) {
            si (ch == comilla) {
                // Comilla escapada doble
                si (i + 1 < len y subcadena(texto, i+1, i+2) == comilla) {
                    campo = campo + comilla
                    i = i + 2
                    continuar
                }
                en_comillas = falso
            } sino {
                campo = campo + ch
            }
        } sino {
            si (ch == comilla) {
                en_comillas = verdadero
            } sino si (ch == sep) {
                agregar(fila_actual, campo)
                campo = ""
            } sino si (ch == "\n" o ch == "\r") {
                agregar(fila_actual, campo)
                campo = ""
                si (longitud(fila_actual) > 0) {
                    agregar(filas, fila_actual)
                }
                fila_actual = []
                // Saltar \r\n
                si (ch == "\r" y i + 1 < len y subcadena(texto, i+1, i+2) == "\n") {
                    i = i + 1
                }
            } sino {
                campo = campo + ch
            }
        }
        i = i + 1
    }

    // Última fila
    si (campo != "" o longitud(fila_actual) > 0) {
        agregar(fila_actual, campo)
        agregar(filas, fila_actual)
    }

    retornar filas
}

funcion texto_recortar_csv(t: texto): texto {
    sea i = 0
    mientras (i < longitud(t) y (subcadena(t,i,i+1) == " " o subcadena(t,i,i+1) == "\t")) {
        i = i + 1
    }
    sea j = longitud(t)
    mientras (j > i y (subcadena(t,j-1,j) == " " o subcadena(t,j-1,j) == "\t")) {
        j = j - 1
    }
    retornar subcadena(t, i, j)
}

funcion csv_inferir_tipo(v: texto): cualquiera {
    si (v == "" o v == "null" o v == "NULL" o v == "nulo") { retornar nulo }
    si (v == "true" o v == "verdadero" o v == "TRUE") { retornar verdadero }
    si (v == "false" o v == "falso" o v == "FALSE") { retornar falso }
    si (texto_es_numero(v)) { retornar texto_a_numero(v) }
    retornar v
}

// ── Desde archivo ──────────────────────────────────────────────────────────────
funcion csv_leer(ruta: texto, opciones: mapa): lista {
    si (!existe_archivo(ruta)) { lanzar "csv_leer: archivo no encontrado: " + ruta }
    sea contenido = leer_archivo(ruta)
    sea opts = si (opciones == nulo) { {} } sino { opciones }
    // Auto-detectar separador por extensión
    si (texto_termina_con(ruta, ".tsv") y !tiene_clave(opts, "separador")) {
        opts["separador"] = "\t"
    }
    retornar csv_parsear(contenido, opts)
}

// ── Generador CSV ──────────────────────────────────────────────────────────────
funcion csv_generar(datos: lista, opciones: mapa): texto {
    sea sep = si (tiene_clave(opciones, "separador")) { opciones["separador"] } sino { "," }
    sea comilla = si (tiene_clave(opciones, "comilla")) { opciones["comilla"] } sino { "\"" }
    sea tiene_header = si (tiene_clave(opciones, "header")) { opciones["header"] } sino { verdadero }
    sea crlf = si (tiene_clave(opciones, "crlf")) { opciones["crlf"] } sino { falso }
    sea nl = si (crlf) { "\r\n" } sino { "\n" }

    si (longitud(datos) == 0) { retornar "" }

    sea resultado = ""

    // Determinar si los datos son lista de mapas o lista de listas
    si (tipo_de(datos[0]) == "mapa") {
        sea headers = mapa_claves(datos[0])

        si (tiene_header) {
            sea fila_h = mapear(headers, funcion(h) { csv_escapar_campo(h, sep, comilla) })
            resultado = texto_unir(fila_h, sep) + nl
        }

        para fila en datos {
            sea campos = mapear(headers, funcion(h) {
                csv_escapar_campo(
                    si (tiene_clave(fila, h)) { fila[h] + "" } sino { "" },
                    sep, comilla
                )
            })
            resultado = resultado + texto_unir(campos, sep) + nl
        }
    } sino {
        // Lista de listas
        para fila en datos {
            sea campos = mapear(fila, funcion(v) { csv_escapar_campo(v + "", sep, comilla) })
            resultado = resultado + texto_unir(campos, sep) + nl
        }
    }

    retornar resultado
}

funcion csv_escapar_campo(campo: texto, sep: texto, comilla: texto): texto {
    // Necesita comillas si contiene separador, comilla, salto de línea
    si (texto_contiene(campo, sep) o texto_contiene(campo, comilla) o
        texto_contiene(campo, "\n") o texto_contiene(campo, "\r")) {
        sea escapado = regex_reemplazar(campo, comilla, comilla + comilla)
        retornar comilla + escapado + comilla
    }
    retornar campo
}

// ── Guardar CSV ────────────────────────────────────────────────────────────────
funcion csv_escribir(ruta: texto, datos: lista, opciones: mapa): nulo {
    sea opts = si (opciones == nulo) { {} } sino { opciones }
    escribir_archivo(ruta, csv_generar(datos, opts))
}

// ── Utilidades ─────────────────────────────────────────────────────────────────

// Filtrar filas por criterio
funcion csv_filtrar(datos: lista, campo: texto, valor: cualquiera): lista {
    retornar filtrar(datos, funcion(fila) {
        tiene_clave(fila, campo) y fila[campo] == valor
    })
}

// Seleccionar columnas
funcion csv_seleccionar(datos: lista, campos: lista): lista {
    retornar mapear(datos, funcion(fila) {
        sea nueva = {}
        para c en campos {
            si (tiene_clave(fila, c)) { nueva[c] = fila[c] }
        }
        retornar nueva
    })
}

// Estadísticas de columna numérica
funcion csv_stats(datos: lista, campo: texto): mapa {
    sea vals = filtrar(
        mapear(datos, funcion(f) { si (tiene_clave(f, campo)) { f[campo] } sino { nulo } }),
        funcion(v) { v != nulo y tipo_de(v) == "numero" }
    )
    si (longitud(vals) == 0) { retornar {"n": 0} }
    sea s = lista_suma(vals)
    sea mn = lista_min(vals)
    sea mx = lista_max(vals)
    retornar {
        "n": longitud(vals),
        "suma": s,
        "min": mn,
        "max": mx,
        "promedio": s / longitud(vals)
    }
}

// Agrupar por campo
funcion csv_agrupar(datos: lista, campo: texto): mapa {
    sea grupos = {}
    para fila en datos {
        si (!tiene_clave(fila, campo)) { continuar }
        sea k = fila[campo] + ""
        si (!tiene_clave(grupos, k)) { grupos[k] = [] }
        agregar(grupos[k], fila)
    }
    retornar grupos
}
