// stdlib/hilos.cfv — Concurrencia y hilos para C-Forge
// API de alto nivel sobre los builtins hilo_crear / mutex_* / canal_*

// ── Hilos ──────────────────────────────────────────────────────────────────────
// Crear y lanzar un hilo
funcion hilo_lanzar(fn: cualquiera, args: lista): mapa {
    sea id = hilo_crear(fn, si (args == nulo) { [] } sino { args })
    retornar {"id": id, "estado": "ejecutando"}
}

// Esperar a que termine un hilo
funcion hilo_esperar(h: mapa): cualquiera {
    retornar hilo_unir(h["id"])
}

// Pool de hilos
funcion pool_crear(n_hilos: numero): mapa {
    sea n = si (n_hilos == nulo) { 4 } sino { n_hilos }
    sea tareas_canal = canal_crear(256)
    sea hilos = []

    para _ en rango(n) {
        sea hilo = hilo_crear(funcion() {
            mientras (verdadero) {
                sea tarea = canal_recibir(tareas_canal)
                si (tarea == nulo) { romper }
                intentar {
                    tarea()
                } capturar (e) {
                    mostrar("[pool] Error en tarea: " + e)
                }
            }
        }, [])
        agregar(hilos, hilo)
    }

    retornar {
        "_canal": tareas_canal,
        "_hilos": hilos,
        "_n": n,
        "_enviadas": 0,
        "_completadas": 0
    }
}

funcion pool_enviar(pool: mapa, tarea: cualquiera): nulo {
    canal_enviar(pool["_canal"], tarea)
    pool["_enviadas"] = pool["_enviadas"] + 1
}

funcion pool_esperar_todo(pool: mapa): nulo {
    // Enviar señal de terminación a cada hilo
    para _ en rango(pool["_n"]) {
        canal_enviar(pool["_canal"], nulo)
    }
    para hilo_id en pool["_hilos"] {
        hilo_unir(hilo_id)
    }
}

// ── Mutex y sincronización ────────────────────────────────────────────────────
funcion con_mutex(m: numero, fn: cualquiera): cualquiera {
    mutex_bloquear(m)
    sea resultado = nulo
    intentar {
        resultado = fn()
    } capturar (e) {
        mutex_desbloquear(m)
        lanzar e
    } finalmente {
        mutex_desbloquear(m)
    }
    retornar resultado
}

// Semáforo basado en mutex+canal
funcion semaforo_crear(n: numero): mapa {
    sea m = mutex_crear()
    sea contador = n
    retornar {"_mutex": m, "_contador": contador, "_max": n}
}

funcion semaforo_adquirir(sem: mapa): nulo {
    mientras (verdadero) {
        mutex_bloquear(sem["_mutex"])
        si (sem["_contador"] > 0) {
            sem["_contador"] = sem["_contador"] - 1
            mutex_desbloquear(sem["_mutex"])
            retornar nulo
        }
        mutex_desbloquear(sem["_mutex"])
        dormir(1)
    }
}

funcion semaforo_liberar(sem: mapa): nulo {
    mutex_bloquear(sem["_mutex"])
    si (sem["_contador"] < sem["_max"]) {
        sem["_contador"] = sem["_contador"] + 1
    }
    mutex_desbloquear(sem["_mutex"])
}

// ── Canales (go-style) ────────────────────────────────────────────────────────
// Los builtins canal_crear/canal_enviar/canal_recibir ya existen en cforgev

funcion canal_iterar(c: numero, fn: cualquiera): nulo {
    mientras (verdadero) {
        sea valor = canal_recibir(c)
        si (valor == nulo) { romper }
        fn(valor)
    }
}

funcion canal_to_lista(c: numero, n: numero): lista {
    sea resultado = []
    para _ en rango(n) {
        sea v = canal_recibir(c)
        si (v == nulo) { romper }
        agregar(resultado, v)
    }
    retornar resultado
}

// ── Promesas (implementación sobre hilos) ─────────────────────────────────────
funcion promesa_crear(fn: cualquiera): mapa {
    sea c = canal_crear(1)
    sea error_c = canal_crear(1)
    sea m = mutex_crear()
    sea estado = "pendiente"

    hilo_crear(funcion() {
        intentar {
            sea resultado = fn()
            mutex_bloquear(m)
            estado = "resuelta"
            mutex_desbloquear(m)
            canal_enviar(c, resultado)
        } capturar (e) {
            mutex_bloquear(m)
            estado = "rechazada"
            mutex_desbloquear(m)
            canal_enviar(error_c, e)
        }
    }, [])

    retornar {
        "_canal": c,
        "_error_canal": error_c,
        "_mutex": m,
        "_estado": estado
    }
}

funcion promesa_esperar(p: mapa): cualquiera {
    sea resultado = canal_recibir(p["_canal"])
    si (resultado == nulo) {
        sea err = canal_recibir(p["_error_canal"])
        lanzar err ?? "Promesa rechazada sin razón"
    }
    retornar resultado
}

funcion promesa_entonces(p: mapa, fn: cualquiera): mapa {
    retornar promesa_crear(funcion() {
        sea v = promesa_esperar(p)
        retornar fn(v)
    })
}

funcion promesa_capturar(p: mapa, fn: cualquiera): mapa {
    retornar promesa_crear(funcion() {
        intentar {
            retornar promesa_esperar(p)
        } capturar (e) {
            retornar fn(e)
        }
    })
}

// Esperar múltiples promesas (Promise.all)
funcion promesa_todo(promesas: lista): lista {
    sea resultados = lista_repetir(nulo, longitud(promesas))
    sea m = mutex_crear()
    sea pendientes = longitud(promesas)
    sea c_final = canal_crear(1)

    para i en rango(longitud(promesas)) {
        sea p = promesas[i]
        sea idx = i
        hilo_crear(funcion() {
            intentar {
                sea v = promesa_esperar(p)
                mutex_bloquear(m)
                resultados[idx] = v
                pendientes = pendientes - 1
                sea listo = (pendientes == 0)
                mutex_desbloquear(m)
                si (listo) { canal_enviar(c_final, resultados) }
            } capturar (e) {
                canal_enviar(c_final, nulo)
            }
        }, [])
    }

    sea r = canal_recibir(c_final)
    si (r == nulo) { lanzar "Una de las promesas fue rechazada" }
    retornar r
}

// ── Worker pattern ────────────────────────────────────────────────────────────
funcion worker_crear(fn_procesador: cualquiera): mapa {
    sea entrada = canal_crear(128)
    sea salida = canal_crear(128)

    hilo_crear(funcion() {
        mientras (verdadero) {
            sea tarea = canal_recibir(entrada)
            si (tarea == nulo) { romper }
            intentar {
                sea resultado = fn_procesador(tarea)
                canal_enviar(salida, {"ok": verdadero, "valor": resultado})
            } capturar (e) {
                canal_enviar(salida, {"ok": falso, "error": e})
            }
        }
    }, [])

    retornar {"_entrada": entrada, "_salida": salida}
}

funcion worker_enviar(w: mapa, datos: cualquiera): nulo {
    canal_enviar(w["_entrada"], datos)
}

funcion worker_recibir(w: mapa): cualquiera {
    sea r = canal_recibir(w["_salida"])
    si (!r["ok"]) { lanzar r["error"] }
    retornar r["valor"]
}

funcion worker_detener(w: mapa): nulo {
    canal_enviar(w["_entrada"], nulo)
}
