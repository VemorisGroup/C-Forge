// stdlib/pkgmgr.cfv -- Package manager de C-Forge
// Uso: importar "stdlib/pkgmgr.cfv"
// Requiere: http_get, leer_archivo, escribir_archivo, existe_archivo,
//           crear_directorio, listar_directorio, json_parsear, json_serializar

// Directorio base de paquetes instalados
funcion cfpkg_dir(): texto {
    sea home: texto = ""
    intentar {
        sea info = sys_run("echo $HOME")
        home = texto_recortar(info["salida"])
    } capturar (e) {
        home = "/tmp"
    }
    retornar home + "/.cforge/pkgs"
}

// Ruta de un paquete instalado
funcion cfpkg_ruta(nombre: texto): texto {
    retornar cfpkg_dir() + "/" + nombre
}

// Leer manifiesto local (cforge.json)
funcion cfpkg_leer_manifiesto(ruta: texto): cualquiera {
    si (!existe_archivo(ruta + "/cforge.json")) {
        lanzar("no hay cforge.json en: " + ruta)
    }
    retornar json_parsear(leer_archivo(ruta + "/cforge.json"))
}

// Instalar paquete desde GitHub: "usuario/repo" o "usuario/repo@tag"
funcion cfpkg_instalar(spec: texto): texto {
    // Parsear spec: usuario/repo o usuario/repo@version
    sea partes_at: lista = texto_dividir(spec, "@")
    sea repo_path: texto = partes_at[0]
    sea version: texto = "main"
    si (longitud(partes_at) > 1) {
        version = partes_at[1]
    }

    sea partes_slash: lista = texto_dividir(repo_path, "/")
    si (longitud(partes_slash) < 2) {
        lanzar("formato invalido. Usa: usuario/repositorio o usuario/repositorio@version")
    }
    sea usuario: texto = partes_slash[0]
    sea repo: texto = partes_slash[1]

    mostrar(">> Instalando {usuario}/{repo}@{version}...")

    // Descargar cforge.json desde GitHub raw
    sea url_manifest: texto = "https://raw.githubusercontent.com/{usuario}/{repo}/{version}/cforge.json"
    sea manifest_txt: texto = http_get(url_manifest)

    sea manifest: cualquiera = {}
    intentar {
        manifest = json_parsear(manifest_txt)
    } capturar (e) {
        lanzar("No se pudo obtener el manifiesto del paquete. URL: {url_manifest}")
    }

    sea nombre_pkg: texto = manifest["nombre"]
    sea version_pkg: texto = manifest["version"]
    sea archivos: lista = manifest["archivos"]

    mostrar("   Paquete: {nombre_pkg} v{version_pkg}")
    mostrar("   Archivos: {longitud(archivos)}")

    // Crear directorio del paquete
    sea destino: texto = cfpkg_ruta(nombre_pkg)
    crear_directorio(destino)

    // Descargar cada archivo .cfv
    para archivo en archivos {
        sea url_archivo: texto = "https://raw.githubusercontent.com/{usuario}/{repo}/{version}/{archivo}"
        mostrar("   Descargando {archivo}...")
        sea contenido: texto = http_get(url_archivo)
        escribir_archivo(destino + "/" + archivo, contenido)
    }

    // Guardar manifiesto instalado
    escribir_archivo(destino + "/cforge.json", manifest_txt)

    mostrar(">> OK: {nombre_pkg} v{version_pkg} instalado en {destino}")
    retornar destino
}

// Desinstalar paquete
funcion cfpkg_desinstalar(nombre: texto): nulo {
    sea ruta: texto = cfpkg_ruta(nombre)
    si (!existe_archivo(ruta)) {
        lanzar("paquete no encontrado: {nombre}")
    }
    eliminar_archivo(ruta)
    mostrar(">> Eliminado: {nombre}")
}

// Listar paquetes instalados
funcion cfpkg_listar(): lista {
    sea dir: texto = cfpkg_dir()
    si (!existe_archivo(dir)) {
        retornar []
    }
    sea pkgs: lista = listar_directorio(dir)
    sea resultado: lista = []
    para pkg en pkgs {
        sea ruta: texto = dir + "/" + pkg
        intentar {
            sea manifest: cualquiera = cfpkg_leer_manifiesto(ruta)
            sea info: cualquiera = {
                "nombre": manifest["nombre"],
                "version": manifest["version"],
                "descripcion": manifest["descripcion"] ?? ""
            }
            resultado.agregar(info)
        } capturar (e) {
            resultado.agregar({"nombre": pkg, "version": "?", "descripcion": ""})
        }
    }
    retornar resultado
}

// Mostrar info de un paquete instalado
funcion cfpkg_info(nombre: texto): nulo {
    sea manifest: cualquiera = cfpkg_leer_manifiesto(cfpkg_ruta(nombre))
    mostrar("Nombre:      {manifest["nombre"]}")
    mostrar("Version:     {manifest["version"]}")
    mostrar("Descripcion: {manifest["descripcion"] ?? ""}")
    mostrar("Autor:       {manifest["autor"] ?? ""}")
    mostrar("Licencia:    {manifest["licencia"] ?? ""}")
    sea archs: lista = manifest["archivos"] ?? []
    mostrar("Archivos:    {longitud(archs)}")
}

// Importar un paquete instalado (retorna la ruta para usar con importar)
funcion cfpkg_ruta_modulo(nombre: texto, modulo: texto): texto {
    retornar cfpkg_ruta(nombre) + "/" + modulo
}

// Inicializar un nuevo paquete (crea cforge.json en el directorio actual)
funcion cfpkg_init(nombre: texto, version: texto, descripcion: texto): nulo {
    sea manifest: cualquiera = {
        "nombre": nombre,
        "version": version,
        "descripcion": descripcion,
        "autor": "",
        "licencia": "MIT",
        "archivos": [],
        "dependencias": {}
    }
    si (existe_archivo("cforge.json")) {
        lanzar("Ya existe un cforge.json en este directorio")
    }
    escribir_archivo("cforge.json", cfv_json_bonito(manifest))
    mostrar(">> Creado cforge.json para '{nombre}' v{version}")
}
