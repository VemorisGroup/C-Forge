// stdlib/cola_mensajes.cfv — Sistema de colas de mensajes
// C-Forge Standard Library v3.0

importar "fecha"

// ── Cola en memoria ────────────────────────────────────────────────────────────

sea _colas = {}
sea _suscriptores = {}
sea _dlq = {}  // Dead Letter Queue

/// @doc Crear una cola
funcion cola_crear(nombre, config) {
    sea cfg = config ?? {}
    _colas[nombre] = {
        "mensajes": [],
        "max_tam": cfg["max_tam"] ?? 10000,
        "max_reintentos": cfg["max_reintentos"] ?? 3,
        "ttl_seg": cfg["ttl_seg"] ?? 3600,
        "prioridad": cfg["prioridad"] ?? falso,
        "creada": tiempo_ms()
    }
    _dlq[nombre] = []
    retornar nombre
}

/// @doc Publicar mensaje en cola
funcion cola_publicar(nombre, mensaje, opciones) {
    si (no tiene_clave(_colas, nombre)) { lanzar "Cola no existe: " + nombre }
    sea cola = _colas[nombre]
    si (longitud(cola["mensajes"]) >= cola["max_tam"]) {
        lanzar "Cola llena: " + nombre
    }
    sea opts = opciones ?? {}
    sea entrada = {
        "id": sha256_corto(nombre + a_texto(tiempo_ms()) + a_texto(aleatorio())),
        "payload": mensaje,
        "prioridad": opts["prioridad"] ?? 5,
        "timestamp": tiempo_ms(),
        "expira": tiempo_ms() + (cola["ttl_seg"] * 1000),
        "reintentos": 0,
        "estado": "pendiente"
    }
    si (cola["prioridad"]) {
        // Insertar ordenado por prioridad (mayor = antes)
        sea pos = 0
        mientras (pos < longitud(cola["mensajes"]) y cola["mensajes"][pos]["prioridad"] >= entrada["prioridad"]) {
            pos = pos + 1
        }
        insertar(cola["mensajes"], pos, entrada)
    } sino {
        agregar(cola["mensajes"], entrada)
    }
    // Notificar suscriptores en tiempo real
    si (tiene_clave(_suscriptores, nombre)) {
        para fn en _suscriptores[nombre] {
            intentar { fn(entrada) } capturar(e) { /* ignorar error en suscriptor */ }
        }
    }
    retornar entrada["id"]
}

/// @doc Consumir mensaje de cola (blocking-style en bucle)
funcion cola_consumir(nombre) {
    si (no tiene_clave(_colas, nombre)) { lanzar "Cola no existe: " + nombre }
    sea mensajes = _colas[nombre]["mensajes"]
    sea ahora = tiempo_ms()
    sea i = 0
    mientras (i < longitud(mensajes)) {
        sea msg = mensajes[i]
        si (msg["estado"] == "pendiente" y msg["expira"] > ahora) {
            _colas[nombre]["mensajes"][i]["estado"] = "procesando"
            _colas[nombre]["mensajes"][i]["inicio_proceso"] = ahora
            retornar msg
        }
        i = i + 1
    }
    retornar nulo
}

/// @doc Confirmar mensaje procesado (ack)
funcion cola_ack(nombre, mensaje_id) {
    sea mensajes = _colas[nombre]["mensajes"]
    sea i = 0
    mientras (i < longitud(mensajes)) {
        si (mensajes[i]["id"] == mensaje_id) {
            eliminar(_colas[nombre]["mensajes"], i)
            retornar verdadero
        }
        i = i + 1
    }
    retornar falso
}

/// @doc Rechazar mensaje (nack) — reencolar o mover a DLQ
funcion cola_nack(nombre, mensaje_id) {
    sea mensajes = _colas[nombre]["mensajes"]
    sea max_reintentos = _colas[nombre]["max_reintentos"]
    sea i = 0
    mientras (i < longitud(mensajes)) {
        si (mensajes[i]["id"] == mensaje_id) {
            sea reintentos = mensajes[i]["reintentos"] + 1
            si (reintentos >= max_reintentos) {
                // Mover a DLQ
                sea msg_dlq = _colas[nombre]["mensajes"][i]
                msg_dlq["estado"] = "fallido"
                msg_dlq["reintentos"] = reintentos
                agregar(_dlq[nombre], msg_dlq)
                eliminar(_colas[nombre]["mensajes"], i)
            } sino {
                _colas[nombre]["mensajes"][i]["reintentos"] = reintentos
                _colas[nombre]["mensajes"][i]["estado"] = "pendiente"
            }
            retornar verdadero
        }
        i = i + 1
    }
    retornar falso
}

/// @doc Suscribirse a mensajes de cola
funcion cola_suscribir(nombre, fn) {
    si (no tiene_clave(_suscriptores, nombre)) { _suscriptores[nombre] = [] }
    agregar(_suscriptores[nombre], fn)
}

/// @doc Procesar mensajes con handler (consume en loop)
funcion cola_procesar(nombre, handler, max_mensajes) {
    sea max = max_mensajes ?? 100
    sea procesados = 0
    sea errores = 0
    mientras (procesados + errores < max) {
        sea msg = cola_consumir(nombre)
        si (msg == nulo) { romper }
        intentar {
            handler(msg["payload"], msg)
            cola_ack(nombre, msg["id"])
            procesados = procesados + 1
        } capturar(e) {
            cola_nack(nombre, msg["id"])
            errores = errores + 1
        }
    }
    retornar {"procesados": procesados, "errores": errores}
}

/// @doc Estado de la cola
funcion cola_estado(nombre) {
    si (no tiene_clave(_colas, nombre)) { lanzar "Cola no existe: " + nombre }
    sea cola = _colas[nombre]
    sea pendientes = longitud(filtrar(cola["mensajes"], funcion(m) { retornar m["estado"] == "pendiente" }))
    sea procesando = longitud(filtrar(cola["mensajes"], funcion(m) { retornar m["estado"] == "procesando" }))
    retornar {
        "nombre": nombre,
        "total": longitud(cola["mensajes"]),
        "pendientes": pendientes,
        "procesando": procesando,
        "dlq": longitud(_dlq[nombre]),
        "max_tam": cola["max_tam"]
    }
}

/// @doc Obtener mensajes de DLQ
funcion cola_dlq(nombre) {
    retornar _dlq[nombre] ?? []
}

// ── Topic (pub/sub fan-out) ────────────────────────────────────────────────────

sea _topics = {}

/// @doc Crear topic de pub/sub
funcion topic_crear(nombre) {
    _topics[nombre] = {"suscriptores": []}
    retornar nombre
}

/// @doc Suscribirse a un topic
funcion topic_suscribir(nombre, fn) {
    si (no tiene_clave(_topics, nombre)) { topic_crear(nombre) }
    agregar(_topics[nombre]["suscriptores"], fn)
}

/// @doc Publicar en topic (fan-out a todos los suscriptores)
funcion topic_publicar(nombre, mensaje) {
    si (no tiene_clave(_topics, nombre)) { retornar 0 }
    sea entregados = 0
    para sub en _topics[nombre]["suscriptores"] {
        intentar {
            sub(mensaje)
            entregados = entregados + 1
        } capturar(e) { /* ignorar error en suscriptor */ }
    }
    retornar entregados
}

// ── Pipeline de tareas ─────────────────────────────────────────────────────────

funcion sha256_corto(s) {
    // Simple hash para IDs únicos
    sea h = 0
    sea i = 0
    mientras (i < longitud(s)) {
        h = (h * 31 + codigo_char(s[i])) % 1000000007
        i = i + 1
    }
    retornar numero_a_base(piso(absoluto(h)), 16)
}

/// @doc Crear pipeline de procesamiento
funcion pipeline_crear(pasos) {
    retornar funcion(entrada) {
        sea resultado = entrada
        para paso en pasos {
            resultado = paso(resultado)
        }
        retornar resultado
    }
}

/// @doc Pipeline con manejo de errores y retries
funcion pipeline_seguro(pasos, config) {
    sea reintentos = (config ?? {})["reintentos"] ?? 2
    retornar funcion(entrada) {
        sea resultado = entrada
        sea i = 0
        mientras (i < longitud(pasos)) {
            sea paso = pasos[i]
            sea intento = 0
            sea ok = falso
            mientras (intento <= reintentos y no ok) {
                intentar {
                    resultado = paso(resultado)
                    ok = verdadero
                } capturar(e) {
                    si (intento == reintentos) { lanzar "Pipeline falló en paso " + a_texto(i) + ": " + e }
                    intento = intento + 1
                }
            }
            i = i + 1
        }
        retornar resultado
    }
}
