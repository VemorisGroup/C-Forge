// stdlib/tipos.cfv — Conversiones y utilidades de tipo para C-Forge
// Inspirado en C# Convert, Java Integer/Double/String, Python type coercion
//
// Uso: importar "stdlib/tipos.cfv"

// ── Conversiones seguras ──────────────────────────────────────────────────

// Convertir a número con valor por defecto si falla
funcion a_numero_o(s: texto, por_defecto: numero): numero {
    sea n: numero = longitud(s)
    si (n == 0) { retornar por_defecto }
    sea i: numero = 0
    si (s[0] == "-" o s[0] == "+") { i = 1 }
    si (i >= n) { retornar por_defecto }
    sea tiene_punto: booleano = falso
    mientras (i < n) {
        sea c: texto = s[i]
        si (c == ".") {
            si (tiene_punto) { retornar por_defecto }
            tiene_punto = verdadero
        } sino si (c < "0" o c > "9") {
            retornar por_defecto
        }
        i = i + 1
    }
    retornar texto_a_numero(s)
}

// Convertir a booleano desde texto ("verdadero"/"true"/"1" → verdadero)
funcion a_bool(s: texto): booleano {
    sea min_s: texto = texto_minusculas(texto_recortar(s))
    retornar min_s == "verdadero" o min_s == "true" o min_s == "1" o min_s == "si" o min_s == "yes"
}

// ── Inspección de tipos ───────────────────────────────────────────────────

// ¿Es número?
funcion es_numero(v: cualquiera): booleano {
    retornar tipo_de(v) == "numero"
}

// ¿Es texto?
funcion es_texto(v: cualquiera): booleano {
    retornar tipo_de(v) == "texto"
}

// ¿Es booleano?
funcion es_booleano(v: cualquiera): booleano {
    retornar tipo_de(v) == "booleano"
}

// ¿Es lista?
funcion es_lista(v: cualquiera): booleano {
    retornar tipo_de(v) == "lista"
}

// ¿Es mapa?
funcion es_mapa(v: cualquiera): booleano {
    retornar tipo_de(v) == "mapa"
}

// ¿Es nulo?
funcion es_nulo(v: cualquiera): booleano {
    retornar tipo_de(v) == "nulo"
}

// ── Serialización simple ──────────────────────────────────────────────────

// Lista → texto delimitado — formato CSV simple
funcion lista_a_texto(lst: lista, sep: texto): texto {
    sea partes: lista = []
    para x en lst {
        agregar(partes, a_texto(x))
    }
    retornar lista_unir(partes, sep)
}

// Texto delimitado → lista de textos
funcion texto_a_lista(s: texto, sep: texto): lista {
    retornar texto_dividir(s, sep)
}

// Mapa → texto representación (para debug)
funcion mapa_a_texto(m: cualquiera): texto {
    sea partes: lista = []
    para k en claves(m) {
        agregar(partes, k + ": " + a_texto(m[k]))
    }
    retornar "{" + lista_unir(partes, ", ") + "}"
}

// ── Valores especiales ────────────────────────────────────────────────────

// ¿Es entero (sin parte decimal)?
funcion es_entero(n: numero): booleano {
    retornar n == piso(n)
}

// ¿Es finito (no inf ni NaN)?
funcion es_finito(n: numero): booleano {
    retornar n == n y n < 1e308 y n > -1e308
}
