// stdlib/archivo.cfv — Operaciones de archivo y sistema de archivos
// Requiere: builtins de archivo/ruta en cforgev.cpp (v2.3)

// ── Lectura ───────────────────────────────────────────────────────────────────

// Leer archivo completo (ya es builtin: leer_archivo)
// Leer como lista de lineas
funcion archivo_lineas(ruta: texto): lista {
    sea contenido = leer_archivo(ruta)
    retornar texto_dividir(contenido, "\n")
}

// Leer archivo JSON
funcion archivo_json(ruta: texto): cualquiera {
    retornar json_parsear(leer_archivo(ruta))
}

// ── Escritura ─────────────────────────────────────────────────────────────────

// Escribir lista de lineas
funcion archivo_escribir_lineas(ruta: texto, lineas: lista): nulo {
    sea contenido = ""
    sea i = 0
    sea n = longitud(lineas)
    para linea en lineas {
        contenido = contenido + linea
        si (i < n - 1) { contenido = contenido + "\n" }
        i = i + 1
    }
    escribir_archivo(ruta, contenido)
}

// Agregar al final de un archivo (append)
funcion archivo_agregar(ruta: texto, contenido: texto): nulo {
    sea existente = ""
    si (existe_archivo(ruta)) {
        existente = leer_archivo(ruta)
    }
    escribir_archivo(ruta, existente + contenido)
}

// Escribir JSON a archivo
funcion archivo_escribir_json(ruta: texto, valor: cualquiera): nulo {
    escribir_archivo(ruta, json_bonito(valor))
}

// ── Informacion ───────────────────────────────────────────────────────────────

funcion archivo_info(ruta: texto): mapa {
    retornar {
        "ruta":        ruta,
        "existe":      existe_archivo(ruta),
        "tam":         archivo_tam(ruta),
        "nombre":      ruta_nombre(ruta),
        "extension":   ruta_extension(ruta),
        "directorio":  ruta_directorio(ruta),
        "es_dir":      es_directorio(ruta)
    }
}

// ── Navegacion ────────────────────────────────────────────────────────────────

// Listar solo archivos (sin subdirectorios)
funcion listar_archivos(dir: texto): lista {
    sea todo = directorio_listar(dir)
    sea archivos = []
    para item en todo {
        si (!es_directorio(item)) {
            agregar(archivos, item)
        }
    }
    retornar archivos
}

// Listar solo subdirectorios
funcion listar_dirs(dir: texto): lista {
    sea todo = directorio_listar(dir)
    sea dirs = []
    para item en todo {
        si (es_directorio(item)) {
            agregar(dirs, item)
        }
    }
    retornar dirs
}

// Listar archivos con extension especifica
funcion listar_por_extension(dir: texto, ext: texto): lista {
    sea todo = directorio_listar(dir)
    sea resultado = []
    para item en todo {
        si (!es_directorio(item) y texto_termina_con(item, ext)) {
            agregar(resultado, item)
        }
    }
    retornar resultado
}

// Listar recursivamente archivos con extension
funcion listar_rec_extension(dir: texto, ext: texto): lista {
    sea todo = directorio_listar_rec(dir)
    sea resultado = []
    para item en todo {
        si (!es_directorio(item) y texto_termina_con(item, ext)) {
            agregar(resultado, item)
        }
    }
    retornar resultado
}

// ── Operaciones ───────────────────────────────────────────────────────────────

// Copiar archivo con verificacion
funcion copiar_verificado(src: texto, dst: texto): mapa {
    si (!existe_archivo(src)) {
        retornar {"ok": falso, "error": "Archivo origen no existe: " + src}
    }
    intentar {
        archivo_copiar(src, dst)
        retornar {"ok": verdadero, "bytes": archivo_tam(dst)}
    } capturar (e) {
        retornar {"ok": falso, "error": e}
    }
}

// Mover con verificacion
funcion mover_verificado(src: texto, dst: texto): mapa {
    si (!existe_archivo(src)) {
        retornar {"ok": falso, "error": "Archivo origen no existe: " + src}
    }
    intentar {
        archivo_mover(src, dst)
        retornar {"ok": verdadero}
    } capturar (e) {
        retornar {"ok": falso, "error": e}
    }
}

// Eliminar con verificacion
funcion eliminar_verificado(ruta: texto): mapa {
    si (!existe_archivo(ruta) y !es_directorio(ruta)) {
        retornar {"ok": falso, "error": "No existe: " + ruta}
    }
    intentar {
        archivo_eliminar(ruta)
        retornar {"ok": verdadero}
    } capturar (e) {
        retornar {"ok": falso, "error": e}
    }
}

// Asegurar que existe el directorio padre
funcion asegurar_directorio(ruta: texto): nulo {
    sea dir = ruta_directorio(ruta)
    si (dir != "" y !es_directorio(dir)) {
        directorio_crear(dir)
    }
}

// ── Busqueda ──────────────────────────────────────────────────────────────────

// Buscar texto en archivos (grep simple)
funcion buscar_en_archivos(dir: texto, patron: texto): lista {
    sea archivos = directorio_listar_rec(dir)
    sea resultados = []
    para archivo en archivos {
        si (!es_directorio(archivo)) {
            intentar {
                sea contenido = leer_archivo(archivo)
                si (texto_contiene(contenido, patron)) {
                    sea lineas = texto_dividir(contenido, "\n")
                    sea num = 1
                    para linea en lineas {
                        si (texto_contiene(linea, patron)) {
                            agregar(resultados, {
                                "archivo": archivo,
                                "linea": num,
                                "texto": linea
                            })
                        }
                        num = num + 1
                    }
                }
            } capturar (e) {
                // omitir archivos binarios o ilegibles
            }
        }
    }
    retornar resultados
}

// ── Utilidades ────────────────────────────────────────────────────────────────

// Tamano en formato legible
funcion tam_legible(bytes: numero): texto {
    si (bytes < 1024) { retornar numero_formato(bytes, 0) + " B" }
    si (bytes < 1024 * 1024) { retornar numero_formato(bytes / 1024, 1) + " KB" }
    si (bytes < 1024 * 1024 * 1024) { retornar numero_formato(bytes / 1024 / 1024, 1) + " MB" }
    retornar numero_formato(bytes / 1024 / 1024 / 1024, 2) + " GB"
}

// Generar nombre de archivo temporal
funcion nombre_temporal(prefijo: texto, extension: texto): texto {
    sea ts = tiempo_ms()
    retornar prefijo + "_" + ts + "." + extension
}
