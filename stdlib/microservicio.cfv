// stdlib/microservicio.cfv — Framework de microservicios
// C-Forge Standard Library v3.0

importar "web"
importar "router"
importar "metricas"
importar "log"
importar "fecha"

// ── Configuración del servicio ─────────────────────────────────────────────────

sea _servicio_config = {
    "nombre": "servicio",
    "version": "1.0.0",
    "puerto": 8080,
    "host": "0.0.0.0",
    "timeout": 30000,
    "max_conexiones": 1000
}

/// @doc Configurar el microservicio
funcion servicio_configurar(config) {
    para k en mapa_claves(config) {
        _servicio_config[k] = config[k]
    }
}

// ── Middleware ──────────────────────────────────────────────────────────────────

sea _middlewares = []

/// @doc Registrar middleware global
funcion usar(fn) {
    agregar(_middlewares, fn)
}

funcion _ejecutar_middlewares(req, res, indice) {
    si (indice >= longitud(_middlewares)) { retornar res }
    sea mw = _middlewares[indice]
    sea continuar_fn = funcion() {
        retornar _ejecutar_middlewares(req, res, indice + 1)
    }
    retornar mw(req, res, continuar_fn)
}

// ── Middlewares built-in ───────────────────────────────────────────────────────

/// @doc Middleware de logging de peticiones
funcion mw_logger() {
    retornar funcion(req, res, siguiente) {
        sea inicio = tiempo_ms()
        sea resultado = siguiente()
        sea duracion = tiempo_ms() - inicio
        log_info("[" + req["metodo"] + "] " + req["ruta"] + " → " + a_texto(res["estado"] ?? 200) + " (" + a_texto(duracion) + "ms)")
        retornar resultado
    }
}

/// @doc Middleware CORS
funcion mw_cors(origenes_permitidos) {
    retornar funcion(req, res, siguiente) {
        sea origen = req["cabeceras"]["Origin"] ?? req["cabeceras"]["origin"] ?? "*"
        sea permitido = origenes_permitidos == nulo o lista_contiene(origenes_permitidos, origen) o lista_contiene(origenes_permitidos, "*")
        si (permitido) {
            si (no tiene_clave(res, "cabeceras")) { res["cabeceras"] = {} }
            res["cabeceras"]["Access-Control-Allow-Origin"] = origen
            res["cabeceras"]["Access-Control-Allow-Methods"] = "GET,POST,PUT,DELETE,OPTIONS,PATCH"
            res["cabeceras"]["Access-Control-Allow-Headers"] = "Content-Type,Authorization,X-Request-ID"
        }
        si (req["metodo"] == "OPTIONS") {
            retornar {"estado": 204, "cuerpo": "", "cabeceras": res["cabeceras"]}
        }
        retornar siguiente()
    }
}

/// @doc Middleware de autenticación JWT
funcion mw_auth_jwt(secreto) {
    retornar funcion(req, res, siguiente) {
        sea auth_header = req["cabeceras"]["Authorization"] ?? req["cabeceras"]["authorization"] ?? ""
        si (no texto_empieza_con(auth_header, "Bearer ")) {
            retornar {"estado": 401, "cuerpo": json_texto({"error": "Token requerido"})}
        }
        sea token = texto_subcadena(auth_header, 7)
        intentar {
            importar "auth"
            sea payload = jwt_verificar(token, secreto)
            req["usuario"] = payload
            retornar siguiente()
        } capturar(e) {
            retornar {"estado": 401, "cuerpo": json_texto({"error": e})}
        }
    }
}

/// @doc Middleware de validación de cuerpo JSON
funcion mw_json() {
    retornar funcion(req, res, siguiente) {
        sea ct = req["cabeceras"]["Content-Type"] ?? req["cabeceras"]["content-type"] ?? ""
        si (texto_contiene(ct, "application/json") y longitud(req["cuerpo"] ?? "") > 0) {
            intentar {
                req["json"] = json_parsear(req["cuerpo"])
            } capturar(e) {
                retornar {"estado": 400, "cuerpo": json_texto({"error": "JSON inválido"})}
            }
        }
        retornar siguiente()
    }
}

/// @doc Middleware de rate limiting
funcion mw_rate_limit(max_por_minuto) {
    sea _buckets_rl = {}
    retornar funcion(req, res, siguiente) {
        sea ip = req["ip"] ?? req["cabeceras"]["X-Forwarded-For"] ?? "unknown"
        sea ahora = tiempo_segundos()
        si (no tiene_clave(_buckets_rl, ip)) {
            _buckets_rl[ip] = {"conteo": 0, "inicio": ahora}
        }
        sea bucket = _buckets_rl[ip]
        si (ahora - bucket["inicio"] > 60) {
            _buckets_rl[ip] = {"conteo": 1, "inicio": ahora}
            retornar siguiente()
        }
        si (bucket["conteo"] >= max_por_minuto) {
            retornar {"estado": 429, "cuerpo": json_texto({"error": "Demasiadas solicitudes"}),
                "cabeceras": {"Retry-After": "60"}}
        }
        _buckets_rl[ip]["conteo"] = bucket["conteo"] + 1
        retornar siguiente()
    }
}

/// @doc Middleware de compresión de respuesta (indicador)
funcion mw_compresion() {
    retornar funcion(req, res, siguiente) {
        sea resultado = siguiente()
        sea accept = req["cabeceras"]["Accept-Encoding"] ?? ""
        si (texto_contiene(accept, "gzip")) {
            si (no tiene_clave(resultado, "cabeceras")) { resultado["cabeceras"] = {} }
            resultado["cabeceras"]["Content-Encoding"] = "identity"
            resultado["cabeceras"]["Vary"] = "Accept-Encoding"
        }
        retornar resultado
    }
}

// ── Servidor principal ─────────────────────────────────────────────────────────

sea _router_global = nulo

/// @doc Iniciar microservicio
funcion servicio_iniciar(rutas_fn) {
    sea nombre = _servicio_config["nombre"]
    sea version = _servicio_config["version"]
    sea puerto = _servicio_config["puerto"]
    log_info("🚀 " + nombre + " v" + version + " iniciando en puerto " + a_texto(puerto))

    sea router_inst = router_crear()
    rutas_fn(router_inst)

    // Health check automático
    router_get(router_inst, "/health", funcion(req) {
        retornar {"estado": 200, "cuerpo": json_texto({
            "estado": "saludable",
            "servicio": nombre,
            "version": version,
            "uptime": tiempo_ms()
        })}
    })

    // Métricas automáticas
    router_get(router_inst, "/metrics", funcion(req) {
        importar "metricas"
        retornar {"estado": 200, "cuerpo": metricas_exportar_prometheus(),
            "cabeceras": {"Content-Type": "text/plain; charset=utf-8"}}
    })

    log_info("✓ Rutas registradas")
    log_info("  GET /health — health check")
    log_info("  GET /metrics — Prometheus metrics")

    web_escuchar(puerto, funcion(solicitud) {
        sea req = {
            "metodo": solicitud["metodo"],
            "ruta": solicitud["ruta"],
            "cuerpo": solicitud["cuerpo"],
            "cabeceras": solicitud["cabeceras"] ?? {},
            "ip": solicitud["ip"] ?? "0.0.0.0",
            "usuario": nulo,
            "json": nulo
        }
        sea res = {"cabeceras": {}}
        sea resultado = _ejecutar_middlewares(req, res, 0)
        si (resultado != nulo y tiene_clave(resultado, "estado")) {
            retornar resultado
        }
        retornar router_manejar(router_inst, req)
    })
}

// ── Respuestas helper ──────────────────────────────────────────────────────────

funcion respuesta_json(datos, estado) {
    retornar {
        "estado": estado ?? 200,
        "cuerpo": json_texto(datos),
        "cabeceras": {"Content-Type": "application/json"}
    }
}

funcion respuesta_error(mensaje, estado) {
    retornar respuesta_json({"error": mensaje}, estado ?? 500)
}

funcion respuesta_no_encontrado(recurso) {
    retornar respuesta_json({"error": (recurso ?? "Recurso") + " no encontrado"}, 404)
}

funcion respuesta_creado(datos) {
    retornar respuesta_json(datos, 201)
}

funcion respuesta_sin_contenido() {
    retornar {"estado": 204, "cuerpo": ""}
}

// ── Cliente de servicio (para comunicación entre microservicios) ───────────────

sea _clientes_servicio = {}

/// @doc Registrar cliente para otro servicio
funcion servicio_cliente(nombre, base_url, config) {
    _clientes_servicio[nombre] = {
        "base_url": base_url,
        "timeout": (config ?? {})["timeout"] ?? 5000,
        "reintentos": (config ?? {})["reintentos"] ?? 3
    }
}

/// @doc Llamar a otro servicio
funcion servicio_llamar(nombre, metodo, ruta, cuerpo, cabeceras) {
    sea cliente = _clientes_servicio[nombre]
    si (cliente == nulo) { lanzar "Servicio no registrado: " + nombre }
    sea url = cliente["base_url"] + ruta
    sea hdrs = {"Content-Type": "application/json", "X-Source-Service": _servicio_config["nombre"]}
    si (cabeceras != nulo) {
        para k en mapa_claves(cabeceras) { hdrs[k] = cabeceras[k] }
    }
    sea cuerpo_str = cuerpo != nulo ? json_texto(cuerpo) : ""
    sea reintentos = cliente["reintentos"]
    sea i = 0
    mientras (i < reintentos) {
        intentar {
            sea resp = http_solicitud(metodo, url, cuerpo_str, hdrs)
            si (resp["estado"] >= 500 y i < reintentos - 1) {
                hilo_dormir(100 * (i + 1))
                i = i + 1
                continuar
            }
            retornar json_parsear(resp["cuerpo"])
        } capturar(e) {
            si (i == reintentos - 1) { lanzar e }
            hilo_dormir(100 * (i + 1))
        }
        i = i + 1
    }
}
