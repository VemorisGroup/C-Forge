// stdlib/os.cfv — Interacción con el sistema operativo
// C-Forge Standard Library v2.5.0

// ── Variables de entorno ───────────────────────────────────────────────────────

/// @doc Obtener variable de entorno (o nulo si no existe)
funcion env_obtener(nombre) {
    retornar env_obtener(nombre)
}

/// @doc Obtener variable de entorno con valor por defecto
funcion env_con_default(nombre, defecto) {
    sea val = env_obtener(nombre)
    retornar val ?? defecto
}

/// @doc Requiere variable de entorno (lanza si no existe)
funcion env_requerir(nombre) {
    sea val = env_obtener(nombre)
    si (val == nulo) {
        lanzar "Variable de entorno requerida no encontrada: " + nombre
    }
    retornar val
}

// ── Rutas de archivos ──────────────────────────────────────────────────────────

/// @doc Obtener directorio home del usuario
funcion os_home() {
    retornar env_con_default("HOME", env_con_default("USERPROFILE", "/tmp"))
}

/// @doc Obtener directorio de trabajo actual
funcion os_cwd() {
    sea resultado = shell_capturar("pwd")
    retornar texto_trim(resultado["salida"])
}

/// @doc Unir componentes de ruta
funcion ruta_unir(partes) {
    sea sep = "/"
    sea resultado = ""
    sea i = 0
    mientras (i < longitud(partes)) {
        sea parte = partes[i]
        si (longitud(resultado) > 0 y no texto_termina_con(resultado, sep)) {
            resultado = resultado + sep
        }
        si (texto_empieza_con(parte, sep)) {
            parte = texto_reemplazar(parte, sep, "", 1)
        }
        resultado = resultado + parte
        i = i + 1
    }
    retornar resultado
}

/// @doc Obtener nombre del archivo de una ruta
funcion ruta_nombre(ruta) {
    sea partes = texto_dividir(ruta, "/")
    retornar partes[longitud(partes) - 1]
}

/// @doc Obtener directorio padre de una ruta
funcion ruta_directorio(ruta) {
    sea partes = texto_dividir(ruta, "/")
    si (longitud(partes) <= 1) { retornar "." }
    eliminar(partes, longitud(partes) - 1)
    retornar texto_unir(partes, "/")
}

/// @doc Obtener extensión de archivo
funcion ruta_extension(ruta) {
    sea nombre = ruta_nombre(ruta)
    sea dot = -1
    sea i = longitud(nombre) - 1
    mientras (i >= 0) {
        si (nombre[i] == ".") { dot = i; romper }
        i = i - 1
    }
    si (dot < 0) { retornar "" }
    retornar texto_dividir(nombre, ".")[longitud(texto_dividir(nombre, ".")) - 1]
}

/// @doc Cambiar extensión de archivo
funcion ruta_cambiar_extension(ruta, nueva_ext) {
    sea dir  = ruta_directorio(ruta)
    sea nom  = ruta_nombre(ruta)
    sea dot  = texto_contiene(nom, ".") ? nom.substring(0, nom.lastIndexOf(".")) : nom
    sea base = texto_dividir(nom, ".")
    eliminar(base, longitud(base) - 1)
    retornar ruta_unir([dir, texto_unir(base, ".") + "." + nueva_ext])
}

/// @doc Verificar si es ruta absoluta
funcion ruta_absoluta(ruta) {
    retornar texto_empieza_con(ruta, "/") o texto_empieza_con(ruta, "~")
}

/// @doc Expandir ~ al directorio home
funcion ruta_expandir(ruta) {
    si (texto_empieza_con(ruta, "~")) {
        retornar os_home() + texto_dividir(ruta, "~")[1]
    }
    retornar ruta
}

// ── Procesos ───────────────────────────────────────────────────────────────────

/// @doc Ejecutar comando y capturar salida
/// @retorna {salida, error, codigo}
funcion proceso_ejecutar(cmd) {
    retornar shell_capturar(cmd)
}

/// @doc Ejecutar y retornar solo la salida (texto)
funcion proceso_salida(cmd) {
    sea r = shell_capturar(cmd)
    retornar texto_trim(r["salida"])
}

/// @doc Verificar si un comando existe en el sistema
funcion proceso_existe(cmd) {
    sea r = shell_capturar("which " + cmd + " 2>/dev/null")
    retornar r["codigo"] == 0 y longitud(texto_trim(r["salida"])) > 0
}

/// @doc Ejecutar en background (no bloquea)
funcion proceso_background(cmd) {
    shell(cmd + " &")
}

/// @doc Obtener PID del proceso actual
funcion proceso_pid() {
    retornar texto_a_numero(texto_trim(proceso_salida("echo $$")))
}

// ── Sistema ────────────────────────────────────────────────────────────────────

/// @doc Obtener nombre del sistema operativo
funcion os_nombre() {
    sea uname = proceso_salida("uname -s 2>/dev/null")
    si (uname == "Darwin")  { retornar "macOS" }
    si (uname == "Linux")   { retornar "Linux" }
    si (uname == "Windows") { retornar "Windows" }
    retornar uname
}

/// @doc Obtener arquitectura del sistema
funcion os_arch() {
    retornar proceso_salida("uname -m 2>/dev/null")
}

/// @doc Obtener nombre del host
funcion os_hostname() {
    retornar proceso_salida("hostname 2>/dev/null")
}

/// @doc Número de CPUs disponibles
funcion os_cpus() {
    sea linux = proceso_salida("nproc 2>/dev/null")
    si (longitud(linux) > 0) { retornar texto_a_numero(linux) }
    sea mac = proceso_salida("sysctl -n hw.ncpu 2>/dev/null")
    si (longitud(mac) > 0) { retornar texto_a_numero(mac) }
    retornar 1
}

/// @doc Memoria RAM disponible (MB)
funcion os_memoria_mb() {
    sea r = proceso_salida("free -m 2>/dev/null | awk 'NR==2{print $7}'")
    si (longitud(r) > 0) { retornar texto_a_numero(r) }
    retornar 0
}

/// @doc Espacio en disco disponible (MB) en ruta
funcion os_disco_mb(ruta) {
    sea r = proceso_salida("df -m " + (ruta ?? "/") + " 2>/dev/null | awk 'NR==2{print $4}'")
    si (longitud(r) > 0) { retornar texto_a_numero(r) }
    retornar 0
}

/// @doc Dormir N milisegundos
funcion os_dormir(ms) {
    dormir(ms)
}

// ── Archivos y directorios ─────────────────────────────────────────────────────

/// @doc Listar archivos en directorio con filtro de extensión
funcion os_listar(directorio, extension) {
    sea archivos = listar_directorio(directorio)
    si (extension == nulo) { retornar archivos }
    retornar filtrar(archivos, funcion(f) { retornar texto_termina_con(f, extension) })
}

/// @doc Copiar archivo
funcion os_copiar(origen, destino) {
    sea contenido = leer_archivo(origen)
    escribir_archivo(destino, contenido)
}

/// @doc Mover archivo
funcion os_mover(origen, destino) {
    os_copiar(origen, destino)
    eliminar_archivo(origen)
}

/// @doc Crear directorio (incluyendo padres)
funcion os_mkdir(ruta) {
    shell("mkdir -p " + ruta)
}

/// @doc Listar directorios recursivamente (find)
funcion os_find(directorio, patron) {
    sea cmd = "find " + directorio + " -name '" + (patron ?? "*") + "' 2>/dev/null"
    sea salida = proceso_salida(cmd)
    si (longitud(salida) == 0) { retornar [] }
    retornar filtrar(texto_dividir(salida, "\n"), funcion(l) { retornar longitud(texto_trim(l)) > 0 })
}

/// @doc Leer archivo JSON directamente
funcion os_leer_json(ruta) {
    retornar json_parsear(leer_archivo(ruta))
}

/// @doc Escribir JSON a archivo
funcion os_escribir_json(ruta, datos) {
    escribir_archivo(ruta, json_texto(datos))
}

// ── Señales y salida ───────────────────────────────────────────────────────────

/// @doc Información del entorno actual
funcion os_info() {
    retornar {
        "os":       os_nombre(),
        "arch":     os_arch(),
        "hostname": os_hostname(),
        "cpus":     os_cpus(),
        "home":     os_home(),
        "cwd":      os_cwd(),
        "pid":      proceso_pid()
    }
}
