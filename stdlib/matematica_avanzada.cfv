// stdlib/matematica_avanzada.cfv — Matematicas avanzadas en C-Forge
// Estadistica, vectores, matrices, ML basico

// ── Constantes ────────────────────────────────────────────────────────────────
sea PI = 3.141592653589793
sea E = 2.718281828459045
sea TAU = 6.283185307179586
sea INF = 1.0 / 0.0

// ── Estadistica basica ────────────────────────────────────────────────────────

funcion media(datos: lista): numero {
    retornar lista_promedio(datos)
}

funcion mediana(datos: lista): numero {
    sea s = ordenar(datos)
    sea n = longitud(s)
    sea mitad = entero_div(n, 2)
    si (n % 2 == 0) {
        retornar (s[mitad - 1] + s[mitad]) / 2.0
    }
    retornar s[mitad]
}

funcion entero_div(a: numero, b: numero): numero {
    retornar a - (a % b)
}

funcion varianza(datos: lista): numero {
    sea mu = media(datos)
    sea n = longitud(datos)
    sea suma = 0.0
    para x en datos {
        sea diff = x - mu
        suma = suma + diff * diff
    }
    retornar suma / n
}

funcion desviacion_std(datos: lista): numero {
    retornar raiz(varianza(datos))
}

funcion moda(datos: lista): cualquiera {
    sea conteos = {}
    para x en datos {
        sea key = x + ""
        si (tiene_clave(conteos, key)) {
            conteos[key] = conteos[key] + 1
        } sino {
            conteos[key] = 1
        }
    }
    sea max_cnt = 0
    sea moda_val = nulo
    para kv en mapa_entradas(conteos) {
        si (kv[1] > max_cnt) {
            max_cnt = kv[1]
            moda_val = kv[0]
        }
    }
    retornar moda_val
}

funcion percentil(datos: lista, p: numero): numero {
    sea s = ordenar(datos)
    sea n = longitud(s)
    sea idx = (p / 100.0) * (n - 1)
    sea lo = entero_div(idx, 1)
    sea hi = lo + 1
    si (hi >= n) { retornar s[n - 1] }
    sea frac = idx - lo
    retornar s[lo] * (1.0 - frac) + s[hi] * frac
}

funcion rango_intercuartil(datos: lista): numero {
    retornar percentil(datos, 75) - percentil(datos, 25)
}

funcion correlacion(x: lista, y: lista): numero {
    sea n = longitud(x)
    sea mu_x = media(x)
    sea mu_y = media(y)
    sea num = 0.0
    sea den_x = 0.0
    sea den_y = 0.0
    para i en rango(0, n) {
        sea dx = x[i] - mu_x
        sea dy = y[i] - mu_y
        num = num + dx * dy
        den_x = den_x + dx * dx
        den_y = den_y + dy * dy
    }
    sea denom = raiz(den_x * den_y)
    si (denom == 0) { retornar 0.0 }
    retornar num / denom
}

// ── Regresion lineal ─────────────────────────────────────────────────────────

// Retorna {pendiente, intercepto, r2}
funcion regresion_lineal(x: lista, y: lista): mapa {
    sea n = longitud(x)
    sea mu_x = media(x)
    sea mu_y = media(y)
    sea num = 0.0
    sea den = 0.0
    para i en rango(0, n) {
        sea dx = x[i] - mu_x
        num = num + dx * (y[i] - mu_y)
        den = den + dx * dx
    }
    sea pendiente = si (den == 0) { 0.0 } sino { num / den }
    sea intercepto = mu_y - pendiente * mu_x

    // R²
    sea ss_tot = varianza(y) * n
    sea ss_res = 0.0
    para i en rango(0, n) {
        sea y_pred = pendiente * x[i] + intercepto
        sea err = y[i] - y_pred
        ss_res = ss_res + err * err
    }
    sea r2 = si (ss_tot == 0) { 1.0 } sino { 1.0 - ss_res / ss_tot }

    retornar {"pendiente": pendiente, "intercepto": intercepto, "r2": r2}
}

funcion predecir(modelo: mapa, x: numero): numero {
    retornar modelo["pendiente"] * x + modelo["intercepto"]
}

// ── Vectores ──────────────────────────────────────────────────────────────────

funcion vec_suma(a: lista, b: lista): lista {
    sea r = []
    sea n = longitud(a)
    para i en rango(0, n) {
        agregar(r, a[i] + b[i])
    }
    retornar r
}

funcion vec_resta(a: lista, b: lista): lista {
    sea r = []
    sea n = longitud(a)
    para i en rango(0, n) {
        agregar(r, a[i] - b[i])
    }
    retornar r
}

funcion vec_escalar(v: lista, k: numero): lista {
    sea r = []
    para x en v {
        agregar(r, x * k)
    }
    retornar r
}

funcion vec_punto(a: lista, b: lista): numero {
    sea s = 0.0
    sea n = longitud(a)
    para i en rango(0, n) {
        s = s + a[i] * b[i]
    }
    retornar s
}

funcion vec_norma(v: lista): numero {
    retornar raiz(vec_punto(v, v))
}

funcion vec_normalizar(v: lista): lista {
    sea norma = vec_norma(v)
    si (norma == 0) { retornar v }
    retornar vec_escalar(v, 1.0 / norma)
}

funcion vec_distancia(a: lista, b: lista): numero {
    retornar vec_norma(vec_resta(a, b))
}

// ── KNN simple ───────────────────────────────────────────────────────────────

// k-NN clasificador: datos = [{x:[...], y: clase}], nuevo = [...]
funcion knn_clasificar(datos: lista, nuevo: lista, k: numero): cualquiera {
    // Calcular distancias
    sea con_dist = []
    para d en datos {
        sea dist = vec_distancia(d["x"], nuevo)
        agregar(con_dist, {"dist": dist, "y": d["y"]})
    }

    // Ordenar por distancia (burbuja simple — para N pequeños)
    sea n = longitud(con_dist)
    para i en rango(0, n) {
        para j en rango(0, n - i - 1) {
            si (con_dist[j]["dist"] > con_dist[j+1]["dist"]) {
                sea tmp = con_dist[j]
                con_dist[j] = con_dist[j+1]
                con_dist[j+1] = tmp
            }
        }
    }

    // Votar entre k vecinos
    sea votos = {}
    para i en rango(0, k) {
        sea clase = con_dist[i]["y"] + ""
        si (tiene_clave(votos, clase)) {
            votos[clase] = votos[clase] + 1
        } sino {
            votos[clase] = 1
        }
    }

    sea max_v = 0
    sea ganador = nulo
    para kv en mapa_entradas(votos) {
        si (kv[1] > max_v) {
            max_v = kv[1]
            ganador = kv[0]
        }
    }
    retornar ganador
}

// ── Funciones matematicas extra ────────────────────────────────────────────────

funcion clampear(x: numero, mn: numero, mx: numero): numero {
    si (x < mn) { retornar mn }
    si (x > mx) { retornar mx }
    retornar x
}

funcion mapear_rango(x: numero, de_min: numero, de_max: numero, a_min: numero, a_max: numero): numero {
    retornar a_min + (x - de_min) * (a_max - a_min) / (de_max - de_min)
}

funcion lerp(a: numero, b: numero, t: numero): numero {
    retornar a + (b - a) * t
}

funcion suavizar(t: numero): numero {
    retornar t * t * (3 - 2 * t)
}

// Fibonacci iterativo
funcion fibonacci(n: numero): numero {
    si (n <= 1) { retornar n }
    sea a = 0
    sea b = 1
    para i en rango(2, n + 1) {
        sea c = a + b
        a = b
        b = c
    }
    retornar b
}

// Maximo comun divisor
funcion mcd(a: numero, b: numero): numero {
    mientras (b != 0) {
        sea t = b
        b = a % b
        a = t
    }
    retornar a
}

// Minimo comun multiplo
funcion mcm(a: numero, b: numero): numero {
    retornar (a / mcd(a, b)) * b
}

// Es primo
funcion es_primo(n: numero): booleano {
    si (n < 2) { retornar falso }
    si (n == 2) { retornar verdadero }
    si (n % 2 == 0) { retornar falso }
    sea i = 3
    mientras (i * i <= n) {
        si (n % i == 0) { retornar falso }
        i = i + 2
    }
    retornar verdadero
}

// Primos hasta n (criba simplificada)
funcion primos_hasta(n: numero): lista {
    sea r = []
    para i en rango(2, n + 1) {
        si (es_primo(i)) { agregar(r, i) }
    }
    retornar r
}

// Resumen estadistico rapido
funcion resumen(datos: lista): mapa {
    sea s = ordenar(datos)
    sea n = longitud(s)
    retornar {
        "n":      n,
        "min":    s[0],
        "max":    s[n - 1],
        "media":  media(datos),
        "mediana": mediana(datos),
        "std":    desviacion_std(datos),
        "p25":    percentil(datos, 25),
        "p75":    percentil(datos, 75),
        "riq":    rango_intercuartil(datos)
    }
}
