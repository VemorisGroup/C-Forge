importar "tensor"

// ── Regresión lineal ───────────────────────────────────────────────────────────

funcion regresion_lineal_crear() {
    retornar {"W": nulo, "b": 0, "tipo": "RegresionLineal", "entrenado": falso}
}

funcion regresion_lineal_entrenar(modelo, X, Y, lr, epocas) {
    sea n = X["forma"][0]
    sea m = X["forma"][1]
    modelo["W"] = tensor_zeros([m, 1])
    sea tasa = lr ?? 0.01
    sea iters = epocas ?? 1000
    sea i = 0
    mientras (i < iters) {
        sea pred = tensor_suma(tensor_matmul(X, modelo["W"]), modelo["b"])
        sea error = tensor_resta(pred, Y)
        sea grad_W = tensor_div(tensor_matmul(tensor_transponer(X), error), n)
        sea grad_b = tensor_sum(error) / n
        modelo["W"] = tensor_resta(modelo["W"], tensor_escalar(grad_W, tasa))
        modelo["b"] = modelo["b"] - tasa * grad_b
        i = i + 1
    }
    modelo["entrenado"] = verdadero
    retornar modelo
}

funcion regresion_lineal_predecir(modelo, X) {
    retornar tensor_suma(tensor_matmul(X, modelo["W"]), modelo["b"])
}

funcion r2_score(y_real, y_pred) {
    sea media = tensor_mean(y_real)
    sea ss_tot = 0
    sea ss_res = 0
    sea i = 0
    mientras (i < y_real["size"]) {
        ss_tot = ss_tot + (y_real["datos"][i] - media) * (y_real["datos"][i] - media)
        ss_res = ss_res + (y_real["datos"][i] - y_pred["datos"][i]) * (y_real["datos"][i] - y_pred["datos"][i])
        i = i + 1
    }
    si (ss_tot == 0) { retornar 1 }
    retornar 1 - ss_res / ss_tot
}

// ── Regresión logística ────────────────────────────────────────────────────────

funcion regresion_logistica_crear() {
    retornar {"W": nulo, "b": 0, "tipo": "RegresionLogistica", "entrenado": falso}
}

funcion regresion_logistica_entrenar(modelo, X, Y, lr, epocas) {
    sea n = X["forma"][0]
    sea m = X["forma"][1]
    modelo["W"] = tensor_zeros([m, 1])
    sea tasa = lr ?? 0.1
    sea iters = epocas ?? 1000
    sea i = 0
    mientras (i < iters) {
        sea z = tensor_suma(tensor_matmul(X, modelo["W"]), modelo["b"])
        sea pred = tensor_sigmoid(z)
        sea error = tensor_resta(pred, Y)
        sea grad_W = tensor_div(tensor_matmul(tensor_transponer(X), error), n)
        sea grad_b = tensor_sum(error) / n
        modelo["W"] = tensor_resta(modelo["W"], tensor_escalar(grad_W, tasa))
        modelo["b"] = modelo["b"] - tasa * grad_b
        i = i + 1
    }
    modelo["entrenado"] = verdadero
    retornar modelo
}

funcion regresion_logistica_predecir(modelo, X) {
    sea z = tensor_suma(tensor_matmul(X, modelo["W"]), modelo["b"])
    retornar tensor_sigmoid(z)
}

// ── K-Nearest Neighbors ────────────────────────────────────────────────────────

funcion knn_crear(k) {
    retornar {"k": k ?? 5, "X_train": nulo, "Y_train": nulo, "tipo": "KNN"}
}

funcion knn_entrenar(modelo, X, Y) {
    modelo["X_train"] = X
    modelo["Y_train"] = Y
    retornar modelo
}

funcion knn_predecir_uno(modelo, punto) {
    sea k = modelo["k"]
    sea distancias = []
    sea n = modelo["X_train"]["forma"][0]
    sea m = modelo["X_train"]["forma"][1]
    sea i = 0
    mientras (i < n) {
        sea dist2 = 0
        sea j = 0
        mientras (j < m) {
            sea dif = punto[j] - modelo["X_train"]["datos"][i*m+j]
            dist2 = dist2 + dif * dif
            j = j + 1
        }
        agregar(distancias, {"dist": raiz(dist2), "label": modelo["Y_train"]["datos"][i]})
        i = i + 1
    }
    // Ordenar por distancia
    distancias = mergesort(distancias, funcion(a, b) { retornar a["dist"] - b["dist"] })
    // Votar entre los k más cercanos
    sea votos = {}
    sea ki = 0
    mientras (ki < k y ki < longitud(distancias)) {
        sea label = a_texto(distancias[ki]["label"])
        votos[label] = (votos[label] ?? 0) + 1
        ki = ki + 1
    }
    sea mejor_label = ""
    sea mejor_votos = 0
    para label en mapa_claves(votos) {
        si (votos[label] > mejor_votos) {
            mejor_votos = votos[label]
            mejor_label = label
        }
    }
    retornar a_numero(mejor_label) ?? mejor_label
}

// ── K-Means ────────────────────────────────────────────────────────────────────

funcion kmeans_crear(k, max_iter) {
    retornar {
        "k": k ?? 3,
        "max_iter": max_iter ?? 100,
        "centroides": nulo,
        "labels": nulo,
        "inercia": 0,
        "tipo": "KMeans"
    }
}

funcion kmeans_entrenar(modelo, X) {
    sea n = X["forma"][0]
    sea m = X["forma"][1]
    sea k = modelo["k"]
    // Inicializar centroides aleatorios (K-Means++)
    sea idx0 = aleatorio_entero(0, n-1)
    sea centroides_datos = subarray(X["datos"], idx0*m, (idx0+1)*m)
    sea ci = 1
    mientras (ci < k) {
        // Elegir siguiente centroide con prob proporcional a dist^2
        sea dists = []
        sea suma_d = 0
        sea i = 0
        mientras (i < n) {
            sea min_d = 999999999
            sea ci2 = 0
            mientras (ci2 < longitud(centroides_datos) / m) {
                sea d2 = 0
                sea j = 0
                mientras (j < m) {
                    sea dif = X["datos"][i*m+j] - centroides_datos[ci2*m+j]
                    d2 = d2 + dif*dif
                    j = j + 1
                }
                si (d2 < min_d) { min_d = d2 }
                ci2 = ci2 + 1
            }
            agregar(dists, min_d)
            suma_d = suma_d + min_d
            i = i + 1
        }
        sea r = aleatorio() * suma_d
        sea acum = 0
        sea chosen = 0
        sea i2 = 0
        mientras (i2 < n) {
            acum = acum + dists[i2]
            si (acum >= r) { chosen = i2; romper }
            i2 = i2 + 1
        }
        sea ck = 0
        mientras (ck < m) {
            agregar(centroides_datos, X["datos"][chosen*m+ck])
            ck = ck + 1
        }
        ci = ci + 1
    }
    // EM loop
    sea iter = 0
    mientras (iter < modelo["max_iter"]) {
        // E-step: asignar labels
        sea labels = lista_repetir(0, n)
        sea i = 0
        mientras (i < n) {
            sea mejor_c = 0
            sea mejor_d = 999999999
            sea c = 0
            mientras (c < k) {
                sea d2 = 0
                sea j = 0
                mientras (j < m) {
                    sea dif = X["datos"][i*m+j] - centroides_datos[c*m+j]
                    d2 = d2 + dif*dif
                    j = j + 1
                }
                si (d2 < mejor_d) { mejor_d = d2; mejor_c = c }
                c = c + 1
            }
            labels[i] = mejor_c
            i = i + 1
        }
        // M-step: actualizar centroides
        sea nuevos = lista_repetir(0, k * m)
        sea counts = lista_repetir(0, k)
        sea i2 = 0
        mientras (i2 < n) {
            sea c = labels[i2]
            counts[c] = counts[c] + 1
            sea j = 0
            mientras (j < m) {
                nuevos[c*m+j] = nuevos[c*m+j] + X["datos"][i2*m+j]
                j = j + 1
            }
            i2 = i2 + 1
        }
        sea c = 0
        mientras (c < k) {
            si (counts[c] > 0) {
                sea j = 0
                mientras (j < m) {
                    nuevos[c*m+j] = nuevos[c*m+j] / counts[c]
                    j = j + 1
                }
            }
            c = c + 1
        }
        centroides_datos = nuevos
        iter = iter + 1
        modelo["labels"] = labels
    }
    modelo["centroides"] = tensor_crear([k, m], centroides_datos)
    retornar modelo
}

funcion kmeans_predecir(modelo, punto) {
    sea k = modelo["k"]
    sea m = modelo["centroides"]["forma"][1]
    sea mejor_c = 0
    sea mejor_d = 999999999
    sea c = 0
    mientras (c < k) {
        sea d2 = 0
        sea j = 0
        mientras (j < m) {
            sea dif = punto[j] - modelo["centroides"]["datos"][c*m+j]
            d2 = d2 + dif*dif
            j = j + 1
        }
        si (d2 < mejor_d) { mejor_d = d2; mejor_c = c }
        c = c + 1
    }
    retornar mejor_c
}

// ── Árbol de decisión ──────────────────────────────────────────────────────────

funcion _entropia(y_lista) {
    sea n = longitud(y_lista)
    si (n == 0) { retornar 0 }
    sea conteos = {}
    para v en y_lista {
        sea k = a_texto(v)
        conteos[k] = (conteos[k] ?? 0) + 1
    }
    sea h = 0
    para k en mapa_claves(conteos) {
        sea p = conteos[k] / n
        si (p > 0) { h = h - p * logaritmo(p) / logaritmo(2) }
    }
    retornar h
}

funcion _clase_mayoritaria(y_lista) {
    sea conteos = {}
    para v en y_lista {
        sea k = a_texto(v)
        conteos[k] = (conteos[k] ?? 0) + 1
    }
    sea mejor = ""
    sea mejor_n = 0
    para k en mapa_claves(conteos) {
        si (conteos[k] > mejor_n) { mejor_n = conteos[k]; mejor = k }
    }
    retornar a_numero(mejor) ?? mejor
}

funcion _arbol_construir(X, Y, profundidad, max_prof, min_muestras) {
    sea n = longitud(Y)
    sea mp = max_prof ?? 10
    sea mm = min_muestras ?? 2
    // Casos base
    si (n < mm o profundidad >= mp) {
        retornar {"hoja": verdadero, "clase": _clase_mayoritaria(Y)}
    }
    // Verificar si todos son la misma clase
    sea primera = Y[0]
    sea todos_iguales = verdadero
    para v en Y { si (v != primera) { todos_iguales = falso; romper } }
    si (todos_iguales) { retornar {"hoja": verdadero, "clase": primera} }
    sea mejor_gain = -1
    sea mejor_feat = 0
    sea mejor_thresh = 0
    sea m = longitud(X[0])
    sea h_padre = _entropia(Y)
    // Buscar mejor split
    para feat en rango(0, m) {
        sea valores = lista_mapear(X, funcion(fila) { retornar fila[feat] })
        sea umbrales = conjunto_a_lista(lista_a_conjunto(valores))
        para thresh en umbrales {
            sea Y_izq = []
            sea Y_der = []
            sea i = 0
            mientras (i < n) {
                si (X[i][feat] <= thresh) { agregar(Y_izq, Y[i]) }
                sino { agregar(Y_der, Y[i]) }
                i = i + 1
            }
            si (longitud(Y_izq) == 0 o longitud(Y_der) == 0) { continuar }
            sea gain = h_padre - (longitud(Y_izq)/n)*_entropia(Y_izq) - (longitud(Y_der)/n)*_entropia(Y_der)
            si (gain > mejor_gain) {
                mejor_gain = gain; mejor_feat = feat; mejor_thresh = thresh
            }
        }
    }
    si (mejor_gain <= 0) { retornar {"hoja": verdadero, "clase": _clase_mayoritaria(Y)} }
    sea X_izq = []; sea Y_izq = []
    sea X_der = []; sea Y_der = []
    sea i = 0
    mientras (i < n) {
        si (X[i][mejor_feat] <= mejor_thresh) { agregar(X_izq, X[i]); agregar(Y_izq, Y[i]) }
        sino { agregar(X_der, X[i]); agregar(Y_der, Y[i]) }
        i = i + 1
    }
    retornar {
        "hoja": falso,
        "feat": mejor_feat,
        "thresh": mejor_thresh,
        "gain": mejor_gain,
        "izq": _arbol_construir(X_izq, Y_izq, profundidad+1, mp, mm),
        "der": _arbol_construir(X_der, Y_der, profundidad+1, mp, mm)
    }
}

funcion arbol_decision_crear(max_profundidad, min_muestras) {
    retornar {"max_prof": max_profundidad ?? 10, "min_muestras": min_muestras ?? 2, "raiz": nulo, "tipo": "ArbolDecision"}
}

funcion arbol_decision_entrenar(modelo, X_lista, Y_lista) {
    modelo["raiz"] = _arbol_construir(X_lista, Y_lista, 0, modelo["max_prof"], modelo["min_muestras"])
    retornar modelo
}

funcion _arbol_predecir_uno(nodo, x) {
    si (nodo["hoja"]) { retornar nodo["clase"] }
    si (x[nodo["feat"]] <= nodo["thresh"]) { retornar _arbol_predecir_uno(nodo["izq"], x) }
    retornar _arbol_predecir_uno(nodo["der"], x)
}

funcion arbol_decision_predecir(modelo, X_lista) {
    retornar lista_mapear(X_lista, funcion(x) { retornar _arbol_predecir_uno(modelo["raiz"], x) })
}

// ── Random Forest ──────────────────────────────────────────────────────────────

funcion random_forest_crear(n_arboles, max_prof, n_features) {
    retornar {"n_arboles": n_arboles ?? 10, "max_prof": max_prof ?? 8, "n_features": n_features ?? nulo, "arboles": [], "tipo": "RandomForest"}
}

funcion random_forest_entrenar(modelo, X_lista, Y_lista) {
    sea n = longitud(X_lista)
    sea m = longitud(X_lista[0])
    sea nf = modelo["n_features"] ?? piso(raiz(m))
    modelo["arboles"] = []
    sea t = 0
    mientras (t < modelo["n_arboles"]) {
        // Bootstrap sampling
        sea X_boot = []; sea Y_boot = []
        sea i = 0
        mientras (i < n) {
            sea idx = aleatorio_entero(0, n-1)
            agregar(X_boot, X_lista[idx])
            agregar(Y_boot, Y_lista[idx])
            i = i + 1
        }
        // Feature subsampling
        sea feats = []
        mientras (longitud(feats) < nf) {
            sea f = aleatorio_entero(0, m-1)
            si (no lista_contiene(feats, f)) { agregar(feats, f) }
        }
        sea X_sub = lista_mapear(X_boot, funcion(fila) {
            retornar lista_mapear(feats, funcion(f) { retornar fila[f] })
        })
        sea arbol = arbol_decision_crear(modelo["max_prof"])
        arbol_decision_entrenar(arbol, X_sub, Y_boot)
        agregar(modelo["arboles"], {"arbol": arbol, "feats": feats})
        t = t + 1
    }
    retornar modelo
}

funcion random_forest_predecir(modelo, x) {
    sea votos = {}
    para item en modelo["arboles"] {
        sea x_sub = lista_mapear(item["feats"], funcion(f) { retornar x[f] })
        sea pred = _arbol_predecir_uno(item["arbol"]["raiz"], x_sub)
        sea k = a_texto(pred)
        votos[k] = (votos[k] ?? 0) + 1
    }
    sea mejor = ""
    sea mejor_n = 0
    para k en mapa_claves(votos) {
        si (votos[k] > mejor_n) { mejor_n = votos[k]; mejor = k }
    }
    retornar a_numero(mejor) ?? mejor
}

// ── Métricas ───────────────────────────────────────────────────────────────────

funcion ml_precision(y_real, y_pred) {
    sea n = longitud(y_real)
    sea correctos = 0
    sea i = 0
    mientras (i < n) {
        si (y_real[i] == y_pred[i]) { correctos = correctos + 1 }
        i = i + 1
    }
    retornar correctos / n
}

funcion matriz_confusion(y_real, y_pred, clases) {
    sea matriz = {}
    para c en clases {
        matriz[a_texto(c)] = {}
        para c2 en clases { matriz[a_texto(c)][a_texto(c2)] = 0 }
    }
    sea i = 0
    mientras (i < longitud(y_real)) {
        sea real = a_texto(y_real[i])
        sea pred = a_texto(y_pred[i])
        si (tiene_clave(matriz, real) y tiene_clave(matriz[real], pred)) {
            matriz[real][pred] = matriz[real][pred] + 1
        }
        i = i + 1
    }
    retornar matriz
}

funcion reporte_clasificacion(y_real, y_pred, clases) {
    sea reporte = {}
    para c en clases {
        sea tp = 0; sea fp = 0; sea fn = 0
        sea i = 0
        mientras (i < longitud(y_real)) {
            sea real = y_real[i] == c
            sea pred = y_pred[i] == c
            si (real y pred) { tp = tp + 1 }
            sino si (no real y pred) { fp = fp + 1 }
            sino si (real y no pred) { fn = fn + 1 }
            i = i + 1
        }
        sea prec = si(tp + fp > 0, tp / (tp + fp), 0)
        sea recall = si(tp + fn > 0, tp / (tp + fn), 0)
        sea f1 = si(prec + recall > 0, 2 * prec * recall / (prec + recall), 0)
        reporte[a_texto(c)] = {"precision": prec, "recall": recall, "f1": f1, "support": tp + fn}
    }
    retornar reporte
}

// ── Preprocesamiento ───────────────────────────────────────────────────────────

funcion train_test_split(X, Y, test_ratio) {
    sea ratio = test_ratio ?? 0.2
    sea n = longitud(X)
    sea indices = rango(0, n)
    // Fisher-Yates shuffle
    sea idx = longitud(indices) - 1
    mientras (idx > 0) {
        sea j = aleatorio_entero(0, idx)
        sea tmp = indices[idx]
        indices[idx] = indices[j]
        indices[j] = tmp
        idx = idx - 1
    }
    sea n_test = piso(n * ratio)
    sea n_train = n - n_test
    sea X_train = []; sea Y_train = []
    sea X_test = []; sea Y_test = []
    sea i = 0
    mientras (i < n) {
        si (i < n_train) {
            agregar(X_train, X[indices[i]])
            agregar(Y_train, Y[indices[i]])
        } sino {
            agregar(X_test, X[indices[i]])
            agregar(Y_test, Y[indices[i]])
        }
        i = i + 1
    }
    retornar {"X_train": X_train, "Y_train": Y_train, "X_test": X_test, "Y_test": Y_test}
}

funcion escalar_minmax(X_lista) {
    sea m = longitud(X_lista[0])
    sea minimos = lista_repetir(999999, m)
    sea maximos = lista_repetir(-999999, m)
    para fila en X_lista {
        sea j = 0
        mientras (j < m) {
            si (fila[j] < minimos[j]) { minimos[j] = fila[j] }
            si (fila[j] > maximos[j]) { maximos[j] = fila[j] }
            j = j + 1
        }
    }
    sea X_scaled = lista_mapear(X_lista, funcion(fila) {
        sea nueva = []
        sea j = 0
        mientras (j < m) {
            sea rng = maximos[j] - minimos[j]
            agregar(nueva, si(rng == 0, 0, (fila[j] - minimos[j]) / rng))
            j = j + 1
        }
        retornar nueva
    })
    retornar {"datos": X_scaled, "minimos": minimos, "maximos": maximos}
}
