// stdlib/streams.cfv — Procesamiento lazy de datos en flujo
// C-Forge Standard Library v2.5.0
// Inspirado en Java Streams / Rust iterators / Elixir Stream

// ── Stream: envuelve cualquier iterable con operaciones lazy ──────────────────

/// @doc Crear stream desde lista
/// @ejemplo stream_desde([1,2,3,4,5])
funcion stream_desde(fuente) {
    retornar {
        "_tipo": "stream",
        "_fuente": fuente,
        "_ops": []
    }
}

/// @doc Crear stream desde rango numérico
funcion stream_rango(inicio, fin, paso) {
    retornar stream_desde(rango(inicio, fin, paso ?? 1))
}

/// @doc Crear stream infinito mediante función generadora
funcion stream_generar(fn) {
    retornar {
        "_tipo": "stream_infinito",
        "_fn": fn,
        "_ops": []
    }
}

// ── Operaciones de transformación (lazy) ──────────────────────────────────────

/// @doc map: transformar cada elemento
funcion stream_mapear(s, fn) {
    sea ops = s["_ops"] + [{"op": "mapear", "fn": fn}]
    retornar mapa_fusionar(s, {"_ops": ops})
}

/// @doc filter: mantener elementos que cumplen predicado
funcion stream_filtrar(s, pred) {
    sea ops = s["_ops"] + [{"op": "filtrar", "fn": pred}]
    retornar mapa_fusionar(s, {"_ops": ops})
}

/// @doc flatMap: transformar y aplanar
funcion stream_aplanar_mapear(s, fn) {
    sea ops = s["_ops"] + [{"op": "aplanar_mapear", "fn": fn}]
    retornar mapa_fusionar(s, {"_ops": ops})
}

/// @doc limit: tomar solo los primeros n elementos
funcion stream_limitar(s, n) {
    sea ops = s["_ops"] + [{"op": "limitar", "n": n}]
    retornar mapa_fusionar(s, {"_ops": ops})
}

/// @doc skip: saltar los primeros n elementos
funcion stream_saltar(s, n) {
    sea ops = s["_ops"] + [{"op": "saltar", "n": n}]
    retornar mapa_fusionar(s, {"_ops": ops})
}

/// @doc peek: inspeccionar cada elemento sin modificarlo (debug)
funcion stream_inspeccionar(s, fn) {
    sea ops = s["_ops"] + [{"op": "inspeccionar", "fn": fn}]
    retornar mapa_fusionar(s, {"_ops": ops})
}

/// @doc distinct: eliminar duplicados consecutivos
funcion stream_unico(s) {
    sea ops = s["_ops"] + [{"op": "unico"}]
    retornar mapa_fusionar(s, {"_ops": ops})
}

/// @doc sorted: ordenar con comparador
funcion stream_ordenar(s, comparar) {
    sea ops = s["_ops"] + [{"op": "ordenar", "fn": comparar}]
    retornar mapa_fusionar(s, {"_ops": ops})
}

// ── Materialización (terminal, ejecuta el stream) ─────────────────────────────

funcion _stream_aplicar_ops(elemento, ops, idx, contexto) {
    sea val = elemento
    sea saltado = contexto["saltados"] ?? 0
    sea limite = contexto["limite"] ?? -1

    para op_desc en ops {
        sea op = op_desc["op"]
        si (op == "filtrar") {
            si (no op_desc["fn"](val)) { retornar nulo }
        } sino si (op == "mapear") {
            val = op_desc["fn"](val)
        } sino si (op == "inspeccionar") {
            op_desc["fn"](val)
        } sino si (op == "aplanar_mapear") {
            val = op_desc["fn"](val)  // aplanado en recolectar
        }
    }
    retornar val
}

/// @doc Materializar stream a lista (ejecuta todas las operaciones)
funcion stream_recolectar(s) {
    sea fuente = s["_fuente"] ?? []
    sea ops    = s["_ops"]    ?? []
    sea resultado = []
    sea saltados = 0
    sea total = 0
    sea limite = -1

    // Determinar límite y saltos
    para op_desc en ops {
        si (op_desc["op"] == "limitar") { limite = op_desc["n"] }
        si (op_desc["op"] == "saltar")  { saltados = op_desc["n"] }
    }

    sea ops_sin_meta = filtrar(ops, funcion(o) {
        retornar o["op"] != "limitar" y o["op"] != "saltar" y o["op"] != "ordenar"
    })

    sea necesita_orden = filtrar(ops, funcion(o) { retornar o["op"] == "ordenar" })

    sea i = 0
    para elem en fuente {
        si (i < saltados) { i = i + 1; continuar }
        si (limite >= 0 y longitud(resultado) >= limite) { romper }

        sea val = elem
        sea valido = verdadero

        para op_desc en ops_sin_meta {
            sea op = op_desc["op"]
            si (op == "filtrar") {
                si (no op_desc["fn"](val)) { valido = falso; romper }
            } sino si (op == "mapear") {
                val = op_desc["fn"](val)
            } sino si (op == "inspeccionar") {
                op_desc["fn"](val)
            } sino si (op == "aplanar_mapear") {
                sea sub = op_desc["fn"](val)
                si (tipo_de(sub) == "lista") {
                    para s_elem en sub { agregar(resultado, s_elem) }
                    valido = falso  // ya agregado
                } sino {
                    val = sub
                }
            } sino si (op == "unico") {
                // simplificado: eliminar si ya está
                sea ya = alguno(resultado, funcion(r) { retornar json_texto(r) == json_texto(val) })
                si (ya) { valido = falso; romper }
            }
        }

        si (valido) { agregar(resultado, val) }
        i = i + 1
    }

    // Aplicar orden después de recolectar
    si (longitud(necesita_orden) > 0) {
        sea fn_orden = necesita_orden[0]["fn"]
        si (fn_orden != nulo) {
            resultado = ordenar(resultado, fn_orden)
        } sino {
            resultado = ordenar(resultado, funcion(a, b) { retornar a - b })
        }
    }

    retornar resultado
}

/// @doc Reducir stream a un valor único
funcion stream_reducir(s, fn, inicial) {
    sea lista = stream_recolectar(s)
    retornar reducir(lista, fn, inicial)
}

/// @doc Contar elementos del stream
funcion stream_contar(s) {
    retornar longitud(stream_recolectar(s))
}

/// @doc Primer elemento del stream (o nulo)
funcion stream_primero(s) {
    sea lista = stream_recolectar(stream_limitar(s, 1))
    si (longitud(lista) > 0) { retornar lista[0] }
    retornar nulo
}

/// @doc Verificar si algún elemento cumple predicado
funcion stream_alguno(s, pred) {
    para e en stream_recolectar(s) {
        si (pred(e)) { retornar verdadero }
    }
    retornar falso
}

/// @doc Verificar si todos los elementos cumplen predicado
funcion stream_todos(s, pred) {
    para e en stream_recolectar(s) {
        si (no pred(e)) { retornar falso }
    }
    retornar verdadero
}

/// @doc Suma de todos los elementos numéricos
funcion stream_suma(s) {
    retornar stream_reducir(s, funcion(acc, v) { retornar acc + v }, 0)
}

/// @doc Promedio de elementos numéricos
funcion stream_promedio(s) {
    sea lista = stream_recolectar(s)
    sea n = longitud(lista)
    si (n == 0) { retornar 0 }
    retornar reducir(lista, funcion(a, b) { retornar a + b }, 0) / n
}

/// @doc Agrupar stream por clave en mapa
funcion stream_agrupar(s, fn_clave) {
    sea resultado = {}
    para e en stream_recolectar(s) {
        sea k = texto(fn_clave(e))
        si (no tiene_clave(resultado, k)) { resultado[k] = [] }
        agregar(resultado[k], e)
    }
    retornar resultado
}

/// @doc forEach: ejecutar acción para cada elemento
funcion stream_para_cada(s, fn) {
    para e en stream_recolectar(s) { fn(e) }
}

/// @doc Unir stream de textos con separador
funcion stream_unir(s, sep) {
    retornar texto_unir(stream_recolectar(s), sep ?? "")
}

// ── Streams especiales ─────────────────────────────────────────────────────────

/// @doc Stream de líneas de texto
funcion stream_lineas(texto_completo) {
    retornar stream_desde(texto_dividir(texto_completo, "\n"))
}

/// @doc Stream de palabras de texto
funcion stream_palabras(t) {
    retornar stream_filtrar(stream_desde(texto_dividir(t, " ")),
        funcion(p) { retornar longitud(texto_trim(p)) > 0 })
}

/// @doc Concatenar múltiples streams
funcion stream_concat(streams) {
    sea todo = []
    para s en streams {
        para e en stream_recolectar(s) { agregar(todo, e) }
    }
    retornar stream_desde(todo)
}

/// @doc Stream de pares [índice, valor]
funcion stream_enumerar(s) {
    sea lista = stream_recolectar(s)
    sea resultado = []
    sea i = 0
    para e en lista {
        agregar(resultado, {"indice": i, "valor": e})
        i = i + 1
    }
    retornar stream_desde(resultado)
}

/// @doc Dividir stream en chunks de tamaño n
funcion stream_chunk(s, n) {
    sea lista = stream_recolectar(s)
    sea chunks = []
    sea i = 0
    mientras (i < longitud(lista)) {
        sea grupo = []
        sea j = i
        mientras (j < i + n y j < longitud(lista)) {
            agregar(grupo, lista[j])
            j = j + 1
        }
        agregar(chunks, grupo)
        i = i + n
    }
    retornar stream_desde(chunks)
}
