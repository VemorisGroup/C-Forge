// stdlib/ffi.cfv — Foreign Function Interface para C-Forge
// Llamar a librerías externas, ejecutar comandos, interop con otros lenguajes

// ── Ejecutar comando del sistema ───────────────────────────────────────────────
funcion shell(comando: texto): mapa {
    /// Ejecuta un comando shell y retorna stdout, stderr y código de salida.
    /// @ejemplo
    ///   sea r = shell("ls -la")
    ///   mostrar(r["stdout"])
    retornar ejecutar_proceso(comando, [], {})
}

funcion shell_capturar(comando: texto): texto {
    /// Ejecuta un comando y retorna solo stdout.
    sea r = shell(comando)
    si (r["codigo"] != 0) {
        lanzar "Shell error (" + r["codigo"] + "): " + r["stderr"]
    }
    retornar texto_trim(r["stdout"])
}

funcion shell_ok(comando: texto): booleano {
    /// Retorna verdadero si el comando termina con código 0.
    sea r = shell(comando)
    retornar r["codigo"] == 0
}

// ── Python FFI ────────────────────────────────────────────────────────────────
funcion py_ejecutar(codigo_python: texto): mapa {
    /// Ejecuta código Python y retorna resultado.
    sea r = ejecutar_proceso("python3", ["-c", codigo_python], {})
    retornar {
        "ok": r["codigo"] == 0,
        "salida": texto_trim(r["stdout"]),
        "error": r["stderr"]
    }
}

funcion py_evaluar(expr: texto): cualquiera {
    /// Evalúa una expresión Python y retorna el resultado parseado como JSON.
    sea codigo = "import json; print(json.dumps(" + expr + "))"
    sea r = py_ejecutar(codigo)
    si (!r["ok"]) { lanzar "Python error: " + r["error"] }
    retornar json_parsear(r["salida"])
}

funcion py_importar_datos(modulo: texto, funcion_py: texto, args: lista): cualquiera {
    /// Llama una función de un módulo Python y retorna el resultado.
    sea args_json = json_texto(si (args == nulo) { [] } sino { args })
    sea codigo = "
import json, sys
sys.path.insert(0, '.')
import " + modulo + " as m
args = json.loads('" + texto_reemplazar(args_json, "'", "\\'") + "')
resultado = m." + funcion_py + "(*args)
print(json.dumps(resultado))
"
    sea r = py_ejecutar(codigo)
    si (!r["ok"]) { lanzar "Python FFI error: " + r["error"] }
    retornar json_parsear(r["salida"])
}

// ── Node.js FFI ───────────────────────────────────────────────────────────────
funcion node_ejecutar(codigo_js: texto): mapa {
    sea r = ejecutar_proceso("node", ["-e", codigo_js], {})
    retornar {
        "ok": r["codigo"] == 0,
        "salida": texto_trim(r["stdout"]),
        "error": r["stderr"]
    }
}

funcion node_evaluar(expr: texto): cualquiera {
    sea codigo = "process.stdout.write(JSON.stringify(" + expr + "))"
    sea r = node_ejecutar(codigo)
    si (!r["ok"]) { lanzar "Node error: " + r["error"] }
    retornar json_parsear(r["salida"])
}

// ── Rust FFI (via cargo) ──────────────────────────────────────────────────────
funcion rust_compilar_y_correr(codigo_rust: texto, args: lista): mapa {
    /// Compila y corre código Rust inline (requiere rustc).
    sea tmp_dir = "/tmp/cforge_rust_" + tiempo_ms()
    shell("mkdir -p " + tmp_dir)
    escribir_archivo(tmp_dir + "/main.rs", codigo_rust)

    sea compile = ejecutar_proceso("rustc", [
        "-o", tmp_dir + "/programa",
        tmp_dir + "/main.rs"
    ], {})

    si (compile["codigo"] != 0) {
        retornar {"ok": falso, "error": compile["stderr"]}
    }

    sea run_args = [tmp_dir + "/programa"] + (si (args == nulo) { [] } sino { args })
    sea r = ejecutar_proceso(run_args[0], lista_slice(run_args, 1, nulo), {})
    shell("rm -rf " + tmp_dir)
    retornar {"ok": r["codigo"] == 0, "salida": r["stdout"], "error": r["stderr"]}
}

// ── C FFI (via gcc + dlopen) ──────────────────────────────────────────────────
funcion c_compilar_lib(codigo_c: texto, nombre_lib: texto): mapa {
    /// Compila código C como librería dinámica.
    sea tmp = "/tmp/cforge_c_" + tiempo_ms()
    shell("mkdir -p " + tmp)
    sea archivo_c = tmp + "/" + nombre_lib + ".c"
    sea archivo_so = tmp + "/" + nombre_lib + ".so"
    escribir_archivo(archivo_c, codigo_c)

    sea r = ejecutar_proceso("gcc", [
        "-shared", "-fPIC", "-O2",
        "-o", archivo_so, archivo_c
    ], {})

    si (r["codigo"] != 0) {
        retornar {"ok": falso, "error": r["stderr"]}
    }
    retornar {"ok": verdadero, "ruta": archivo_so}
}

// ── Interop con datos externos ─────────────────────────────────────────────────
funcion csv_desde_excel(ruta_excel: texto): lista {
    /// Convierte Excel a CSV via Python openpyxl.
    sea codigo = "
import json, openpyxl
wb = openpyxl.load_workbook('" + ruta_excel + "', data_only=True)
ws = wb.active
rows = [[str(c.value or '') for c in row] for row in ws.iter_rows()]
print(json.dumps(rows))
"
    sea r = py_ejecutar(codigo)
    si (!r["ok"]) { lanzar "Error leyendo Excel: " + r["error"] }
    retornar json_parsear(r["salida"])
}

funcion pdf_extraer_texto(ruta_pdf: texto): texto {
    /// Extrae texto de un PDF via Python pdfplumber.
    sea codigo = "
try:
    import pdfplumber
    with pdfplumber.open('" + ruta_pdf + "') as pdf:
        texto = '\\n'.join(p.extract_text() or '' for p in pdf.pages)
    print(texto)
except ImportError:
    import subprocess
    r = subprocess.run(['pdftotext', '" + ruta_pdf + "', '-'], capture_output=True, text=True)
    print(r.stdout)
"
    sea r = py_ejecutar(codigo)
    si (!r["ok"]) { lanzar "Error leyendo PDF: " + r["error"] }
    retornar r["salida"]
}

// ── Verificadores de disponibilidad ──────────────────────────────────────────
funcion tiene_python(): booleano {
    retornar shell_ok("python3 --version")
}

funcion tiene_node(): booleano {
    retornar shell_ok("node --version")
}

funcion tiene_rust(): booleano {
    retornar shell_ok("rustc --version")
}

funcion tiene_java(): booleano {
    retornar shell_ok("java -version")
}

funcion version_python(): texto {
    intentar { retornar shell_capturar("python3 --version") }
    capturar (e) { retornar "no disponible" }
}

funcion version_node(): texto {
    intentar { retornar shell_capturar("node --version") }
    capturar (e) { retornar "no disponible" }
}

// ── Variables de entorno ───────────────────────────────────────────────────────
funcion env_requerir(nombre: texto): texto {
    /// Obtiene una variable de entorno o lanza si no existe.
    sea val = env_obtener(nombre)
    si (val == nulo o val == "") {
        lanzar "EnvError: variable de entorno '" + nombre + "' requerida"
    }
    retornar val
}

funcion env_con_default(nombre: texto, default: texto): texto {
    sea val = env_obtener(nombre)
    si (val == nulo o val == "") { retornar default }
    retornar val
}

funcion env_lista(): mapa {
    /// Retorna todas las variables de entorno disponibles.
    sea cmd = shell("env")
    sea resultado = {}
    para linea en texto_dividir(cmd["stdout"], "\n") {
        sea pos = texto_buscar(linea, "=")
        si (pos > 0) {
            sea clave = texto_slice(linea, 0, pos)
            sea valor = texto_slice(linea, pos + 1, nulo)
            resultado[clave] = valor
        }
    }
    retornar resultado
}
