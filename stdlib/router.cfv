// stdlib/router.cfv — Router HTTP para C-Forge
// Middleware de enrutamiento sobre web.cfv
// Soporta: rutas con parametros, middleware, grupos, CORS, JSON body parsing

// ── Crear router ───────────────────────────────────────────────────────────────
funcion router_crear(): mapa {
    retornar {
        "rutas": [],        // lista de {metodo, patron, handler_nombre, middleware}
        "middleware": [],   // middleware global
        "prefijo": "",
        "no_encontrada": nulo,
        "error_handler": nulo
    }
}

// ── Registrar rutas ────────────────────────────────────────────────────────────
funcion router_get(router: mapa, patron: texto, handler: texto): nulo {
    router_agregar_ruta(router, "GET", patron, handler, [])
}

funcion router_post(router: mapa, patron: texto, handler: texto): nulo {
    router_agregar_ruta(router, "POST", patron, handler, [])
}

funcion router_put(router: mapa, patron: texto, handler: texto): nulo {
    router_agregar_ruta(router, "PUT", patron, handler, [])
}

funcion router_delete(router: mapa, patron: texto, handler: texto): nulo {
    router_agregar_ruta(router, "DELETE", patron, handler, [])
}

funcion router_patch(router: mapa, patron: texto, handler: texto): nulo {
    router_agregar_ruta(router, "PATCH", patron, handler, [])
}

funcion router_any(router: mapa, patron: texto, handler: texto): nulo {
    router_agregar_ruta(router, "*", patron, handler, [])
}

funcion router_agregar_ruta(router: mapa, metodo: texto, patron: texto, handler: texto, mw: lista): nulo {
    agregar(router["rutas"], {
        "metodo":  metodo,
        "patron":  router["prefijo"] + patron,
        "handler": handler,
        "middleware": mw
    })
}

// ── Grupos de rutas ────────────────────────────────────────────────────────────
// Uso:
//   sea api = router_grupo(router, "/api/v1")
//   router_get(api, "/usuarios", "listar_usuarios")
//   router_post(api, "/usuarios", "crear_usuario")

funcion router_grupo(router: mapa, prefijo: texto): mapa {
    sea sub = router_crear()
    sub["prefijo"] = router["prefijo"] + prefijo
    sub["middleware"] = router["middleware"]
    // Las rutas del sub-router se comparten con el padre
    sub["rutas"] = router["rutas"]
    retornar sub
}

// ── Middleware ─────────────────────────────────────────────────────────────────
funcion router_use(router: mapa, middleware_nombre: texto): nulo {
    agregar(router["middleware"], middleware_nombre)
}

// ── Matching de rutas ──────────────────────────────────────────────────────────
// Patron: /usuarios/:id/posts/:post_id
// Ruta:   /usuarios/42/posts/7  → {id: "42", post_id: "7"}

funcion router_match(patron: texto, ruta: texto): mapa {
    sea partes_patron = texto_dividir(patron, "/")
    sea partes_ruta   = texto_dividir(ruta,   "/")

    si (longitud(partes_patron) != longitud(partes_ruta)) {
        retornar {"ok": falso, "params": {}}
    }

    sea params = {}
    sea i = 0
    mientras (i < longitud(partes_patron)) {
        sea p = partes_patron[i]
        sea r = partes_ruta[i]

        si (texto_empieza_con(p, ":")) {
            // Captura de parametro
            sea nombre_param = subcadena(p, 1, longitud(p))
            params[nombre_param] = r
        } sino si (p != r) {
            // No coincide
            retornar {"ok": falso, "params": {}}
        }
        i = i + 1
    }

    retornar {"ok": verdadero, "params": params}
}

funcion router_match_wildcard(patron: texto, ruta: texto): booleano {
    // Soporta * al final: /api/* coincide con /api/cualquier/cosa
    si (texto_termina_con(patron, "*")) {
        sea prefijo = subcadena(patron, 0, longitud(patron) - 1)
        retornar texto_empieza_con(ruta, prefijo)
    }
    retornar patron == ruta
}

// ── Resolver una solicitud ─────────────────────────────────────────────────────
// Retorna {encontrado, handler, params, ruta_obj} o {encontrado: falso}

funcion router_resolver(router: mapa, metodo: texto, ruta: texto): mapa {
    // Quitar query string si hay
    sea ruta_limpia = ruta
    si (texto_contiene(ruta, "?")) {
        sea idx = texto_indice(ruta, "?")
        ruta_limpia = subcadena(ruta, 0, idx)
    }

    para ruta_obj en router["rutas"] {
        sea metodo_ok = ruta_obj["metodo"] == "*" o ruta_obj["metodo"] == metodo
        si (!metodo_ok) { continuar }

        // Primero intentar match exacto
        si (ruta_obj["patron"] == ruta_limpia) {
            retornar {
                "encontrado": verdadero,
                "handler": ruta_obj["handler"],
                "params": {},
                "ruta_obj": ruta_obj
            }
        }

        // Match con parametros
        sea m = router_match(ruta_obj["patron"], ruta_limpia)
        si (m["ok"]) {
            retornar {
                "encontrado": verdadero,
                "handler": ruta_obj["handler"],
                "params": m["params"],
                "ruta_obj": ruta_obj
            }
        }

        // Match wildcard
        si (router_match_wildcard(ruta_obj["patron"], ruta_limpia)) {
            retornar {
                "encontrado": verdadero,
                "handler": ruta_obj["handler"],
                "params": {},
                "ruta_obj": ruta_obj
            }
        }
    }

    retornar {"encontrado": falso, "params": {}}
}

// ── Context de solicitud enriquecido ──────────────────────────────────────────
funcion router_crear_ctx(req: mapa, params: mapa): mapa {
    sea ctx = req
    ctx["params"] = params

    // Parsear query string
    ctx["query"] = {}
    sea url = req["ruta"]
    si (texto_contiene(url, "?")) {
        sea idx = texto_indice(url, "?")
        sea qs = subcadena(url, idx + 1, longitud(url))
        sea pares = texto_dividir(qs, "&")
        para par en pares {
            si (texto_contiene(par, "=")) {
                sea eq = texto_indice(par, "=")
                sea k = subcadena(par, 0, eq)
                sea v = subcadena(par, eq + 1, longitud(par))
                ctx["query"][k] = v
            }
        }
    }

    // Parsear cuerpo JSON si corresponde
    ctx["json"] = nulo
    sea ct = si (tiene_clave(req, "content_type")) { req["content_type"] } sino { "" }
    si (texto_contiene(ct, "application/json") y req["cuerpo"] != "") {
        intentar {
            ctx["json"] = json_parsear(req["cuerpo"])
        } capturar (e) {
            ctx["json"] = nulo
        }
    }

    retornar ctx
}

// ── CORS middleware ────────────────────────────────────────────────────────────
funcion cors_headers(origen_permitido: texto): mapa {
    retornar {
        "Access-Control-Allow-Origin":  origen_permitido,
        "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, PATCH, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, X-Requested-With",
        "Access-Control-Max-Age":       "86400"
    }
}

// ── Respuestas helper ──────────────────────────────────────────────────────────
funcion res_json(srv: cualquiera, datos: cualquiera, codigo: numero): nulo {
    web_responder(srv, codigo, json_texto(datos), "application/json")
}

funcion res_ok(srv: cualquiera, datos: cualquiera): nulo {
    res_json(srv, datos, 200)
}

funcion res_creado(srv: cualquiera, datos: cualquiera): nulo {
    res_json(srv, datos, 201)
}

funcion res_error(srv: cualquiera, mensaje: texto, codigo: numero): nulo {
    res_json(srv, {"error": mensaje, "codigo": codigo}, codigo)
}

funcion res_no_encontrado(srv: cualquiera, recurso: texto): nulo {
    res_error(srv, recurso + " no encontrado", 404)
}

funcion res_no_autorizado(srv: cualquiera): nulo {
    res_error(srv, "No autorizado", 401)
}

funcion res_prohibido(srv: cualquiera): nulo {
    res_error(srv, "Acceso prohibido", 403)
}

funcion res_html(srv: cualquiera, html: texto, codigo: numero): nulo {
    web_responder(srv, codigo, html, "text/html; charset=utf-8")
}

funcion res_texto(srv: cualquiera, txt: texto): nulo {
    web_responder(srv, 200, txt, "text/plain; charset=utf-8")
}

// ── Loop principal del servidor ────────────────────────────────────────────────
// Uso:
//   sea router = router_crear()
//   router_get(router, "/hola", "handler_hola")
//   router_escuchar(router, 8080)

funcion router_escuchar(router: mapa, puerto: numero): nulo {
    sea srv = web_escuchar(puerto)
    mostrar("Servidor C-Forge en http://localhost:" + puerto)

    mientras (verdadero) {
        sea req = web_solicitud(srv)
        sea metodo = req["metodo"]
        sea ruta = req["ruta"]

        // Manejar preflight CORS
        si (metodo == "OPTIONS") {
            web_responder(srv, 204, "", "text/plain")
            continuar
        }

        sea resultado = router_resolver(router, metodo, ruta)

        si (!resultado["encontrado"]) {
            res_error(srv, "Ruta no encontrada: " + ruta, 404)
            continuar
        }

        sea ctx = router_crear_ctx(req, resultado["params"])
        ctx["_srv"] = srv

        // Ejecutar handler (por nombre como texto)
        // Nota: se implementa como tabla de dispatch
        intentar {
            router_dispatch(router, resultado["handler"], ctx, srv)
        } capturar (e) {
            res_error(srv, "Error interno: " + e, 500)
        }
    }
}

// Tabla de dispatch para handlers
// El usuario define sus handlers y llama router_dispatch_tabla
sea _router_handlers = {}

funcion router_registrar_handler(nombre: texto, fn_resultado: cualquiera): nulo {
    _router_handlers[nombre] = fn_resultado
}

funcion router_dispatch(router: mapa, handler_nombre: texto, ctx: mapa, srv: cualquiera): nulo {
    si (tiene_clave(_router_handlers, handler_nombre)) {
        _router_handlers[handler_nombre](ctx, srv)
    } sino {
        res_error(srv, "Handler no registrado: " + handler_nombre, 500)
    }
}

// ── Listar rutas registradas ───────────────────────────────────────────────────
funcion router_listar_rutas(router: mapa): nulo {
    mostrar("Rutas registradas:")
    para r en router["rutas"] {
        mostrar("  " + r["metodo"] + " " + r["patron"] + "  →  " + r["handler"])
    }
}
