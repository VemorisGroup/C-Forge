// stdlib/tipado.cfv — Sistema de tipos en runtime para C-Forge
// Validación de tipos, type guards, coerciones seguras y tipos genéricos simulados

// ── Verificadores de tipo básicos ─────────────────────────────────────────────
funcion es_texto(v: cualquiera): booleano {
    retornar tipo_de(v) == "texto"
}

funcion es_numero(v: cualquiera): booleano {
    retornar tipo_de(v) == "numero"
}

funcion es_booleano(v: cualquiera): booleano {
    retornar tipo_de(v) == "booleano"
}

funcion es_lista(v: cualquiera): booleano {
    retornar tipo_de(v) == "lista"
}

funcion es_mapa(v: cualquiera): booleano {
    retornar tipo_de(v) == "mapa"
}

funcion es_funcion(v: cualquiera): booleano {
    retornar tipo_de(v) == "funcion"
}

funcion es_nulo(v: cualquiera): booleano {
    retornar v == nulo
}

funcion es_entero(v: cualquiera): booleano {
    retornar es_numero(v) y numero_es_entero(v)
}

funcion es_positivo(v: cualquiera): booleano {
    retornar es_numero(v) y v > 0
}

funcion es_negativo(v: cualquiera): booleano {
    retornar es_numero(v) y v < 0
}

funcion es_vacio(v: cualquiera): booleano {
    si (v == nulo) { retornar verdadero }
    si (es_texto(v)) { retornar longitud(v) == 0 }
    si (es_lista(v)) { retornar longitud(v) == 0 }
    si (es_mapa(v))  { retornar longitud(mapa_claves(v)) == 0 }
    retornar falso
}

// ── Aserciones de tipo (lanzan TypeErrror) ─────────────────────────────────────
funcion asegurar_texto(v: cualquiera, nombre: texto): texto {
    si (!es_texto(v)) {
        lanzar "TypeError: '" + (nombre ?? "valor") + "' debe ser texto, recibió " + tipo_de(v)
    }
    retornar v
}

funcion asegurar_numero(v: cualquiera, nombre: texto): numero {
    si (!es_numero(v)) {
        // Intentar coerción
        si (es_texto(v) y texto_es_numero(v)) { retornar texto_a_numero(v) }
        lanzar "TypeError: '" + (nombre ?? "valor") + "' debe ser número, recibió " + tipo_de(v)
    }
    retornar v
}

funcion asegurar_lista(v: cualquiera, nombre: texto): lista {
    si (!es_lista(v)) {
        lanzar "TypeError: '" + (nombre ?? "valor") + "' debe ser lista, recibió " + tipo_de(v)
    }
    retornar v
}

funcion asegurar_mapa(v: cualquiera, nombre: texto): mapa {
    si (!es_mapa(v)) {
        lanzar "TypeError: '" + (nombre ?? "valor") + "' debe ser mapa, recibió " + tipo_de(v)
    }
    retornar v
}

funcion asegurar_no_nulo(v: cualquiera, nombre: texto): cualquiera {
    si (v == nulo) {
        lanzar "NullError: '" + (nombre ?? "valor") + "' no puede ser nulo"
    }
    retornar v
}

funcion asegurar_rango(v: numero, min: numero, max: numero, nombre: texto): numero {
    si (v < min o v > max) {
        lanzar "RangeError: '" + (nombre ?? "valor") + "' debe estar entre " + min + " y " + max + ", recibió " + v
    }
    retornar v
}

// ── Coerciones seguras ────────────────────────────────────────────────────────
funcion a_texto(v: cualquiera): texto {
    si (v == nulo) { retornar "nulo" }
    si (es_texto(v)) { retornar v }
    si (es_booleano(v)) { retornar si (v) { "verdadero" } sino { "falso" } }
    si (es_numero(v)) { retornar numero_a_texto(v) }
    si (es_lista(v) o es_mapa(v)) { retornar json_texto(v) }
    retornar v + ""
}

funcion a_numero(v: cualquiera, default: numero): numero {
    si (es_numero(v)) { retornar v }
    si (es_booleano(v)) { retornar si (v) { 1 } sino { 0 } }
    si (es_texto(v) y texto_es_numero(v)) { retornar texto_a_numero(v) }
    si (default != nulo) { retornar default }
    lanzar "TypeError: no se puede convertir a número: " + tipo_de(v)
}

funcion a_booleano(v: cualquiera): booleano {
    si (es_booleano(v)) { retornar v }
    si (es_nulo(v)) { retornar falso }
    si (es_numero(v)) { retornar v != 0 }
    si (es_texto(v)) { retornar longitud(v) > 0 y v != "false" y v != "0" }
    si (es_lista(v) o es_mapa(v)) { retornar verdadero }
    retornar verdadero
}

funcion a_lista(v: cualquiera): lista {
    si (es_lista(v)) { retornar v }
    si (es_nulo(v)) { retornar [] }
    retornar [v]
}

// ── Tipos genéricos simulados ─────────────────────────────────────────────────
// C-Forge no tiene genéricos nativos, pero podemos simularlos con closures

funcion Lista_tipada(tipo_elemento: texto): mapa {
    /// Crea una lista que valida el tipo de cada elemento.
    /// @ejemplo
    ///   sea nums = Lista_tipada("numero")
    ///   nums["agregar"](nums, 42)      // ✓
    ///   nums["agregar"](nums, "hola")  // ✗ TypeError
    sea datos = []
    retornar {
        "_tipo_elem": tipo_elemento,
        "_datos": datos,
        "agregar": funcion(self, elem) {
            si (tipo_de(elem) != self["_tipo_elem"] y self["_tipo_elem"] != "cualquiera") {
                lanzar "TypeError: Lista<" + self["_tipo_elem"] + "> no acepta " + tipo_de(elem)
            }
            agregar(self["_datos"], elem)
        },
        "obtener": funcion(self, i) { self["_datos"][i] },
        "longitud": funcion(self) { longitud(self["_datos"]) },
        "todos": funcion(self) { self["_datos"] },
        "filtrar": funcion(self, fn) { filtrar(self["_datos"], fn) },
        "mapear": funcion(self, fn) { mapear(self["_datos"], fn) }
    }
}

funcion Mapa_tipado(tipo_valor: texto): mapa {
    /// Crea un mapa que valida el tipo de los valores.
    sea datos = {}
    retornar {
        "_tipo_val": tipo_valor,
        "_datos": datos,
        "poner": funcion(self, clave, valor) {
            si (tipo_de(valor) != self["_tipo_val"] y self["_tipo_val"] != "cualquiera") {
                lanzar "TypeError: Mapa<" + self["_tipo_val"] + "> no acepta " + tipo_de(valor)
            }
            self["_datos"][clave] = valor
        },
        "obtener": funcion(self, clave) { self["_datos"][clave] },
        "tiene": funcion(self, clave) { tiene_clave(self["_datos"], clave) },
        "claves": funcion(self) { mapa_claves(self["_datos"]) },
        "todos": funcion(self) { self["_datos"] }
    }
}

// ── Decorador de tipos en funciones ───────────────────────────────────────────
funcion funcion_tipada(fn: cualquiera, tipos_params: lista, tipo_retorno: texto): cualquiera {
    /// Envuelve una función con validación de tipos en params y retorno.
    retornar funcion() {
        // Nota: en C-Forge no hay acceso a arguments como en JS
        // Esta es una versión simplificada
        sea r = fn()
        si (tipo_retorno != nulo y tipo_retorno != "cualquiera") {
            si (tipo_de(r) != tipo_retorno) {
                lanzar "TypeError: retorno esperado " + tipo_retorno + ", obtuvo " + tipo_de(r)
            }
        }
        retornar r
    }
}

// ── Inferencia de tipo ────────────────────────────────────────────────────────
funcion inferir_tipo(v: cualquiera): texto {
    si (v == nulo) { retornar "nulo" }
    sea t = tipo_de(v)
    si (t == "numero") {
        si (numero_es_entero(v)) { retornar "entero" }
        retornar "decimal"
    }
    si (t == "lista") {
        si (longitud(v) == 0) { retornar "lista<vacia>" }
        sea tipo_elem = tipo_de(v[0])
        sea todos_iguales = verdadero
        para elem en v {
            si (tipo_de(elem) != tipo_elem) { todos_iguales = falso }
        }
        si (todos_iguales) { retornar "lista<" + tipo_elem + ">" }
        retornar "lista<mixta>"
    }
    si (t == "mapa") {
        si (tiene_clave(v, "_tipo")) { retornar "objeto(" + v["_tipo"] + ")" }
        retornar "mapa"
    }
    retornar t
}

// ── Registro de tipos (schema de objetos) ─────────────────────────────────────
sea _tipos_registrados = {}

funcion registrar_tipo(nombre: texto, campos: mapa): nulo {
    /// Registra un tipo con su esquema de campos.
    /// @ejemplo
    ///   registrar_tipo("Usuario", { "nombre": "texto", "edad": "numero" })
    _tipos_registrados[nombre] = campos
}

funcion verificar_tipo(nombre: texto, obj: mapa): booleano {
    /// Verifica que obj cumple con el tipo registrado.
    si (!tiene_clave(_tipos_registrados, nombre)) {
        lanzar "Tipo '" + nombre + "' no registrado"
    }
    sea campos = _tipos_registrados[nombre]
    para kv en mapa_entradas(campos) {
        sea campo = kv[0]
        sea tipo_esp = kv[1]
        si (!tiene_clave(obj, campo)) {
            lanzar "TypeError: campo '" + campo + "' requerido para tipo '" + nombre + "'"
        }
        si (tipo_esp != "cualquiera" y tipo_de(obj[campo]) != tipo_esp) {
            lanzar "TypeError: campo '" + campo + "' debe ser " + tipo_esp +
                   ", recibió " + tipo_de(obj[campo])
        }
    }
    retornar verdadero
}

funcion crear_con_tipo(nombre: texto, datos: mapa): mapa {
    /// Crea y valida un objeto con el tipo registrado.
    verificar_tipo(nombre, datos)
    datos["_tipo"] = nombre
    retornar datos
}
