// stdlib/escena.cfv — Sistema de escenas para videojuegos
// C-Forge Standard Library v3.0

// ── Scene Manager ──────────────────────────────────────────────────────────────

sea _escenas = {}
sea _escena_activa = nulo
sea _escena_siguiente = nulo
sea _camara_global = nulo

/// @doc Registrar escena
funcion escena_registrar(nombre, cargar_fn, actualizar_fn, renderizar_fn, descargar_fn) {
    _escenas[nombre] = {
        "nombre": nombre,
        "cargar": cargar_fn,
        "actualizar": actualizar_fn,
        "renderizar": renderizar_fn,
        "descargar": descargar_fn,
        "datos": {},
        "actores": {},
        "ui": [],
        "cargada": falso
    }
}

/// @doc Cambiar escena
funcion escena_cambiar(nombre) {
    si (no tiene_clave(_escenas, nombre)) {
        retornar {"error": "Escena no encontrada: " + nombre}
    }
    _escena_siguiente = nombre
}

/// @doc Aplicar cambio de escena pendiente
funcion escena_aplicar_cambio() {
    si (_escena_siguiente == nulo) { retornar }
    // Descargar escena actual
    si (_escena_activa != nulo y tiene_clave(_escenas, _escena_activa)) {
        sea actual = _escenas[_escena_activa]
        si (actual["descargar"] != nulo) { actual["descargar"](actual["datos"]) }
        actual["cargada"] = falso
        actual["actores"] = {}
        actual["ui"] = []
    }
    // Cargar nueva
    _escena_activa = _escena_siguiente
    _escena_siguiente = nulo
    sea nueva = _escenas[_escena_activa]
    si (nueva["cargar"] != nulo) { nueva["cargar"](nueva["datos"]) }
    nueva["cargada"] = verdadero
}

/// @doc Actualizar escena activa
funcion escena_actualizar(delta) {
    escena_aplicar_cambio()
    si (_escena_activa == nulo) { retornar }
    sea escena = _escenas[_escena_activa]
    si (escena["actualizar"] != nulo) {
        escena["actualizar"](escena["datos"], delta)
    }
}

/// @doc Renderizar escena activa
funcion escena_renderizar(contexto) {
    si (_escena_activa == nulo) { retornar }
    sea escena = _escenas[_escena_activa]
    si (escena["renderizar"] != nulo) {
        escena["renderizar"](escena["datos"], contexto)
    }
}

/// @doc Obtener datos de escena activa
funcion escena_datos() {
    si (_escena_activa == nulo) { retornar {} }
    retornar _escenas[_escena_activa]["datos"]
}

/// @doc Nombre de escena activa
funcion escena_activa() { retornar _escena_activa }

// ── Actores (game objects dentro de escena) ────────────────────────────────────

/// @doc Crear actor en escena activa
funcion actor_crear(nombre, x, y) {
    si (_escena_activa == nulo) { retornar nulo }
    sea id = nombre + "_" + a_texto(aleatorio_entero(10000, 99999))
    sea escena = _escenas[_escena_activa]
    escena["actores"][id] = {
        "id": id,
        "nombre": nombre,
        "x": x ?? 0, "y": y ?? 0, "z": 0,
        "activo": verdadero,
        "componentes": {},
        "etiquetas": [],
        "orden": 0
    }
    retornar id
}

/// @doc Obtener actor
funcion actor_obtener(id) {
    si (_escena_activa == nulo) { retornar nulo }
    retornar _escenas[_escena_activa]["actores"][id] ?? nulo
}

/// @doc Todos los actores de escena
funcion actores_todos() {
    si (_escena_activa == nulo) { retornar [] }
    sea lista = []
    para id en mapa_claves(_escenas[_escena_activa]["actores"]) {
        agregar(lista, _escenas[_escena_activa]["actores"][id])
    }
    retornar lista
}

/// @doc Destruir actor
funcion actor_destruir(id) {
    si (_escena_activa == nulo) { retornar }
    eliminar_clave(_escenas[_escena_activa]["actores"], id)
}

// ── Cámara ─────────────────────────────────────────────────────────────────────

/// @doc Crear cámara 2D
funcion camara_crear(x, y, ancho, alto, zoom) {
    sea cam = {
        "x": x ?? 0, "y": y ?? 0,
        "ancho": ancho ?? 1280, "alto": alto ?? 720,
        "zoom": zoom ?? 1.0,
        "rotacion": 0,
        "objetivo": nulo,
        "suavizado": 0.1,
        "limites": nulo
    }
    _camara_global = cam
    retornar cam
}

/// @doc Seguir objetivo con cámara
funcion camara_seguir(camara, objetivo_x, objetivo_y) {
    sea dx = objetivo_x - camara["x"]
    sea dy = objetivo_y - camara["y"]
    camara["x"] = camara["x"] + dx * camara["suavizado"]
    camara["y"] = camara["y"] + dy * camara["suavizado"]
    // Aplicar límites
    si (camara["limites"] != nulo) {
        sea l = camara["limites"]
        camara["x"] = maximo(l["min_x"], minimo(camara["x"], l["max_x"]))
        camara["y"] = maximo(l["min_y"], minimo(camara["y"], l["max_y"]))
    }
}

/// @doc Convertir coordenada mundo a pantalla
funcion camara_mundo_a_pantalla(camara, mundo_x, mundo_y) {
    retornar {
        "x": (mundo_x - camara["x"]) * camara["zoom"] + camara["ancho"] / 2,
        "y": (mundo_y - camara["y"]) * camara["zoom"] + camara["alto"] / 2
    }
}

/// @doc Convertir coordenada pantalla a mundo
funcion camara_pantalla_a_mundo(camara, pantalla_x, pantalla_y) {
    retornar {
        "x": (pantalla_x - camara["ancho"] / 2) / camara["zoom"] + camara["x"],
        "y": (pantalla_y - camara["alto"] / 2) / camara["zoom"] + camara["y"]
    }
}

/// @doc Frustum culling — verificar si rect es visible
funcion camara_es_visible(camara, x, y, ancho, alto) {
    sea hw = camara["ancho"] / 2 / camara["zoom"]
    sea hh = camara["alto"] / 2 / camara["zoom"]
    retornar x + ancho > camara["x"] - hw y
           x < camara["x"] + hw y
           y + alto > camara["y"] - hh y
           y < camara["y"] + hh
}

/// @doc Cámara 3D
funcion camara3d_crear(pos_x, pos_y, pos_z, fov) {
    retornar {
        "pos": {"x": pos_x ?? 0, "y": pos_y ?? 1.8, "z": pos_z ?? 5},
        "objetivo": {"x": 0, "y": 0, "z": 0},
        "arriba": {"x": 0, "y": 1, "z": 0},
        "fov": fov ?? 60,
        "cerca": 0.1,
        "lejos": 1000,
        "yaw": 0,
        "pitch": 0,
        "sensibilidad": 0.1,
        "velocidad": 5
    }
}

// ── UI en escena ───────────────────────────────────────────────────────────────

/// @doc Agregar elemento UI a escena
funcion ui_agregar(tipo, config) {
    si (_escena_activa == nulo) { retornar }
    sea elem = {"tipo": tipo, "id": tipo + "_" + a_texto(aleatorio_entero(1000, 9999))}
    para clave en mapa_claves(config) {
        elem[clave] = config[clave]
    }
    agregar(_escenas[_escena_activa]["ui"], elem)
    retornar elem["id"]
}

funcion ui_boton(x, y, ancho, alto, texto_btn, on_click) {
    retornar ui_agregar("boton", {"x": x, "y": y, "ancho": ancho, "alto": alto, "texto": texto_btn, "on_click": on_click, "hover": falso, "presionado": falso})
}

funcion ui_texto(x, y, contenido, fuente_size, color) {
    retornar ui_agregar("texto", {"x": x, "y": y, "contenido": contenido, "fuente_size": fuente_size ?? 16, "color": color ?? "#FFFFFF"})
}

funcion ui_imagen(x, y, ancho, alto, src) {
    retornar ui_agregar("imagen", {"x": x, "y": y, "ancho": ancho, "alto": alto, "src": src})
}

funcion ui_barra(x, y, ancho, alto, valor, max_val, color_fondo, color_relleno) {
    retornar ui_agregar("barra", {
        "x": x, "y": y, "ancho": ancho, "alto": alto,
        "valor": valor, "max": max_val,
        "color_fondo": color_fondo ?? "#333333",
        "color_relleno": color_relleno ?? "#00FF00"
    })
}

/// @doc Obtener todos los elementos UI
funcion ui_elementos() {
    si (_escena_activa == nulo) { retornar [] }
    retornar _escenas[_escena_activa]["ui"]
}

// ── Transiciones ───────────────────────────────────────────────────────────────

sea _transicion = nulo

funcion escena_transicion_fade(duracion, color, escena_siguiente_nombre) {
    _transicion = {
        "tipo": "fade",
        "duracion": duracion ?? 0.5,
        "tiempo": 0,
        "color": color ?? "#000000",
        "siguiente": escena_siguiente_nombre,
        "fase": "salida"
    }
}

funcion escena_transicion_actualizar(delta) {
    si (_transicion == nulo) { retornar }
    _transicion["tiempo"] = _transicion["tiempo"] + delta
    sea progreso = _transicion["tiempo"] / (_transicion["duracion"] / 2)
    si (_transicion["fase"] == "salida" y progreso >= 1) {
        escena_cambiar(_transicion["siguiente"])
        escena_aplicar_cambio()
        _transicion["tiempo"] = 0
        _transicion["fase"] = "entrada"
    } sino si (_transicion["fase"] == "entrada" y progreso >= 1) {
        _transicion = nulo
    }
}

funcion escena_transicion_opacidad() {
    si (_transicion == nulo) { retornar 0 }
    sea p = _transicion["tiempo"] / (_transicion["duracion"] / 2)
    si (_transicion["fase"] == "salida") { retornar minimo(p, 1) }
    retornar maximo(1 - p, 0)
}
