// stdlib/log.cfv — Logging estructurado para C-Forge
// Uso: importar "stdlib/log.cfv"
//
// log_info("Servidor iniciado en puerto 8080")
// log_error("Error de conexion a la base de datos")
// log_debug("Consulta SQL: SELECT * FROM usuarios")

sea LOG_NIVEL_DEBUG = 0
sea LOG_NIVEL_INFO = 1
sea LOG_NIVEL_ADVERTENCIA = 2
sea LOG_NIVEL_ERROR = 3
sea LOG_NIVEL_CRITICO = 4

sea _log_nivel_actual = LOG_NIVEL_INFO
sea _log_archivo = ""      // Vacío = solo consola
sea _log_json = falso      // Formato JSON
sea _log_colores = verdadero

// ── Configuracion ─────────────────────────────────────────────────────────────

funcion log_configurar(opciones: mapa): nulo {
    si (tiene_clave(opciones, "nivel")) {
        _log_nivel_actual = opciones["nivel"]
    }
    si (tiene_clave(opciones, "archivo")) {
        _log_archivo = opciones["archivo"]
    }
    si (tiene_clave(opciones, "json")) {
        _log_json = opciones["json"]
    }
    si (tiene_clave(opciones, "colores")) {
        _log_colores = opciones["colores"]
    }
}

// ── Formato ───────────────────────────────────────────────────────────────────

funcion _log_timestamp(): texto {
    sea f = fecha_ahora()
    sea fecha = f["fecha"]
    sea hora = f["hora_texto"]
    retornar "{fecha} {hora}"
}

funcion _log_color(nivel: numero): texto {
    si (!_log_colores) {
        retornar ""
    }
    segun nivel {
        caso LOG_NIVEL_DEBUG:      retornar "\033[36m"  // Cyan
        caso LOG_NIVEL_INFO:       retornar "\033[32m"  // Verde
        caso LOG_NIVEL_ADVERTENCIA:retornar "\033[33m"  // Amarillo
        caso LOG_NIVEL_ERROR:      retornar "\033[31m"  // Rojo
        caso LOG_NIVEL_CRITICO:    retornar "\033[35m"  // Magenta
    }
    retornar ""
}

funcion _log_reset(): texto {
    si (!_log_colores) { retornar "" }
    retornar "\033[0m"
}

funcion _log_etiqueta(nivel: numero): texto {
    segun nivel {
        caso LOG_NIVEL_DEBUG:      retornar "DEBUG"
        caso LOG_NIVEL_INFO:       retornar "INFO "
        caso LOG_NIVEL_ADVERTENCIA:retornar "WARN "
        caso LOG_NIVEL_ERROR:      retornar "ERROR"
        caso LOG_NIVEL_CRITICO:    retornar "CRIT "
    }
    retornar "LOG  "
}

funcion _log_escribir(nivel: numero, mensaje: texto, extra: mapa): nulo {
    si (nivel < _log_nivel_actual) {
        retornar
    }

    sea ts = _log_timestamp()
    sea etiq = _log_etiqueta(nivel)
    sea linea = ""

    si (_log_json) {
        sea entrada = {"timestamp": ts, "nivel": etiq, "mensaje": mensaje}
        linea = json_texto(entrada)
    } sino {
        sea color = _log_color(nivel)
        sea reset = _log_reset()
        linea = "{color}[{ts}] {etiq}{reset} {mensaje}"
    }

    mostrar(linea)

    si (longitud(_log_archivo) > 0) {
        escribir_archivo(_log_archivo, "{linea}\n", verdadero)
    }
}

// ── API pública ───────────────────────────────────────────────────────────────

funcion log_debug(mensaje: texto): nulo {
    _log_escribir(LOG_NIVEL_DEBUG, mensaje, {})
}

funcion log_info(mensaje: texto): nulo {
    _log_escribir(LOG_NIVEL_INFO, mensaje, {})
}

funcion log_advertencia(mensaje: texto): nulo {
    _log_escribir(LOG_NIVEL_ADVERTENCIA, mensaje, {})
}

funcion log_error(mensaje: texto): nulo {
    _log_escribir(LOG_NIVEL_ERROR, mensaje, {})
}

funcion log_critico(mensaje: texto): nulo {
    _log_escribir(LOG_NIVEL_CRITICO, mensaje, {})
}

// Alias cortos
funcion log(mensaje: texto): nulo { log_info(mensaje) }
funcion warn(mensaje: texto): nulo { log_advertencia(mensaje) }
funcion error_log(mensaje: texto): nulo { log_error(mensaje) }

// Con contexto extra (solo para compatibilidad futura)
funcion log_con(nivel: numero, mensaje: texto, contexto: mapa): nulo {
    _log_escribir(nivel, mensaje, contexto)
}

// Medir tiempo de ejecucion
funcion log_tiempo(nombre: texto, fn: funcion): cualquiera {
    sea inicio = tiempo_ms()
    sea resultado = fn()
    sea duracion = tiempo_ms() - inicio
    log_debug("{nombre} completado en {duracion}ms")
    retornar resultado
}
