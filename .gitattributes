# Líneas de fin de archivo
*.cfv  text eol=lf
*.cpp  text eol=lf
*.h    text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.sh   text eol=lf
*.yml  text eol=lf

# Binarios
outputs/cforge-master binary linguist-vendored=true
*.png  binary
*.vsix binary
*.exe  binary

# GitHub Linguist — solamente el código C-Forge participa en estadísticas.
# La regla general evita que herramientas, bootstrap, web y empaquetado se
# presenten como lenguajes del producto.
* linguist-vendored=true

# C-Forge es el único código detectable del repositorio.
*.cfv linguist-language=C-Forge linguist-detectable=true

# Todo archivo .cfv activo representa código fuente C-Forge.
# GitHub mostrará el nombre C-Forge cuando github-linguist acepte oficialmente
# el lenguaje en su catálogo; hasta entonces puede agruparlo como "Other".
*.cfv linguist-vendored=false linguist-generated=false linguist-detectable=true

# Todo lo demás no cuenta en las estadísticas
*.cpp linguist-generated=true
*.h   linguist-generated=true
*.ll  linguist-generated=true
*.s   linguist-generated=true
*.sh  linguist-vendored=true
*.js  linguist-vendored=true
*.cs  linguist-vendored=true
*.c   linguist-vendored=true
*.rb  linguist-vendored=true
*.py  linguist-vendored=true
*.java linguist-vendored=true
*.kt  linguist-vendored=true
*.kts linguist-vendored=true
*.swift linguist-vendored=true
*.ts  linguist-vendored=true
*.html linguist-vendored=true
packaging/** linguist-vendored=true
herramientas/** linguist-vendored=true
