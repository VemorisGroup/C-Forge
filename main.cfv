// Demostración oficial de C-Forge 2.6.
// Este programa usa únicamente sintaxis y biblioteca nativa de C-Forge.

mostrar("=== C-Forge 2.6 Developer Preview ===")

sea proyecto = {
    "nombre": "C-Forge",
    "empresa": "Vemoris Group",
    "extension": ".cfv"
}

funcion potencia(base, exponente) {
    sea resultado = 1
    sea i = 0
    mientras (i < exponente) {
        resultado = resultado * base
        i = i + 1
    }
    retornar resultado
}

funcion crear_multiplicador(factor) {
    retornar funcion(valor) {
        retornar valor * factor
    }
}

sea duplicar = crear_multiplicador(2)
sea valores = [2, 4, 6, 8]
sea resultados = []

para valor en valores {
    agregar(resultados, duplicar(valor))
}

afirmar(proyecto["extension"] == ".cfv", "la extensión oficial debe ser .cfv")
afirmar(potencia(2, 10) == 1024, "la potencia debe ser correcta")
afirmar(longitud(resultados) == 4, "deben existir cuatro resultados")

mostrar(proyecto["nombre"])
mostrar(resultados)
mostrar("C-Forge funciona con su propio código .cfv")
